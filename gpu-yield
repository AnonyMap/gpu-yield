def cmd_setup(args):
    if os.geteuid() == 0:
        die("run setup as your normal user, not with sudo (it asks for sudo when needed)")
    if tomllib is None:
        die("Python 3.11+ is required")
    if user_systemctl("show-environment").returncode:
        die("cannot reach the systemd user manager")

    log("1/8 Config")
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_FILE.exists():
        write_private(CONFIG_FILE, CONFIG_TEMPLATE)
        log(f"  wrote {CONFIG_FILE}")
    overrides = {k: v for k, v in (("context_length", args.context), ("backend", args.backend))
                 if v is not None}
    cfg = change_settings(overrides) if overrides else load_config()
    # A new model is saved to the config only once it has downloaded (step 7), so a typo
    # or a failed download leaves the working model in place.
    new_model = args.model if args.model is not None else \
        (None if cfg["model"] else choose_model(args) or None)
    if new_model:
        try:
            new_model = normalize_model_name(new_model)
        except ValueError as e:
            die(f"{e}; nothing changed")
        if cfg["alias"] and same_model(cfg["alias"], new_model):
            die(f"{new_model} is the fixed name for your apps; choose the real model")
        if cfg["model"] and same_model(cfg["model"], new_model):
            new_model = None
    if new_model and args.skip_pull:          # you'll download it yourself
        cfg, new_model = change_settings({"model": new_model}), None
    managed = cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT
    shown = f"{new_model} (downloaded in step 7)" if new_model else cfg["model"] or "none yet"
    log(f"  model {shown}, context {cfg['context_length']}, "
        f"backend {resolve_backend(cfg)}" + (" (auto)" if cfg["backend"] == "auto" else ""))

    log("2/8 Checking for other Ollama installs")
    check_conflicts(args)

    log("3/8 Ollama")
    was_running = user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0
    if was_running:
        user_systemctl("stop", WATCHER_UNIT)
    try:
        if not managed:
            log(f"  using your own unit {cfg['ollama_unit']}")
        elif OLLAMA_BIN.exists() and not args.reinstall and backend_installed(cfg) is not False:
            log(f"  already installed at {OLLAMA_DIR} (--reinstall to update)")
        else:
            if OLLAMA_BIN.exists() and not args.reinstall:
                log("  the ROCm part of Ollama isn't installed yet; downloading it")
            install_ollama(resolve_backend(cfg))
    except BaseException:
        if was_running:              # a failed reinstall keeps the old Ollama; keep the AI too
            user_systemctl("start", WATCHER_UNIT)
        raise

    log("4/8 Services")
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    me = Path(__file__).resolve()
    if me != BIN_PATH.resolve():
        shutil.copy2(me, BIN_PATH)
    BIN_PATH.chmod(0o755)
    write_unit(WATCHER_UNIT, watcher_unit_text())
    ensure_ollama_unit(cfg)
    user_systemctl("daemon-reload")
    r = user_systemctl("enable", "--now", WATCHER_UNIT)
    if r.returncode:
        die(f"could not start the watcher: {r.stderr.strip()}")
    enable_linger(args)
    log(f"  watcher running; installed as {BIN_PATH}")

    log("5/8 Firewall")
    if args.no_firewall:
        log("  skipped")
    else:
        open_firewall(cfg, args)

    log("6/8 Wake-on-LAN")
    enable_wol(args)

    log("7/8 Model")
    target, failed = new_model or cfg["model"], False
    if not target:
        log("  none chosen; pick one any time with: gpu-yield model")
    elif args.skip_pull:
        log("  skipped")
    elif not Ollama(cfg).wait_ready(60):
        st = read_status() or {}
        warn(f"Ollama isn't up (state: {STATE_TEXT.get(st.get('state'))}). "
             f"Download the model later with: gpu-yield model {target}")
        failed = bool(new_model)
    else:
        result = pull_and_load(cfg, target)
        if result is True:
            if new_model:
                cfg = change_settings({"model": new_model})
                user_systemctl("restart", WATCHER_UNIT)
        else:
            failed = True
            if new_model:
                warn(f"kept {cfg['model'] or 'no model'}" + (
                    f"; try again with: gpu-yield model {new_model}" if result == "download"
                    else "; choose a model that fits with: gpu-yield model"))
            elif result == "refused":
                warn(f"your current model, {target}, doesn't fit; choose a smaller one with: "
                     "gpu-yield model")

    log("8/8 Done\n")
    print(hermes_snippet(cfg))
    page = f"http://{socket.gethostname()}:{cfg['status_port']}/" if page_port(cfg) else "off"
    print(f"""
Status page: {page}

Useful commands:
  gpu-yield status      gpu-yield doctor      gpu-yield config
  gpu-yield pause       gpu-yield resume      gpu-yield model
  journalctl --user -u gpu-yield -f""")
    if failed:
        sys.exit(1)


