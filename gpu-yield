DRM_DIR = Path("/sys/class/drm")
SHARED_PROMPT_CACHE_MIB = 512      # llama-server's RAM prompt cache on shared-memory chips
SHARED_VRAM_BELOW = 2 * 2**30      # a fixed GPU slice this small means shared memory
SHARED_OS_RESERVE = 3 * 2**30      # shared memory kept back for Linux itself
SHARED_MIN_FREE = 3 * 2**30 // 4   # less than this available after a load: too big


def gpu_used(m):
    """Memory the GPU is using: its VRAM, plus borrowed system memory on shared chips."""
    m = m or {}
    return m.get("gpu_used", m.get("vram_used"))


def shared_memory_gpu():
    """True on a chip whose GPU shares system memory (BC-250, APUs)."""
    return bool((memory_readings() or {}).get("shared"))


def mem_available():
    m = re.search(r"^MemAvailable:\s+(\d+) kB", _read_text(Path("/proc/meminfo")), re.M)
    return int(m.group(1)) * 1024 if m else None


def shared_pool():
    """All the memory a shared-memory chip's GPU and Linux share: RAM plus any BIOS slice
    over 512 MB (which sits outside MemTotal)."""
    total = total_ram()
    if not total:
        return None
    vram = (memory_readings() or {}).get("vram_total") or 0
    return total + max(0, vram - 2**29)


def shared_budget():
    """Biggest model file a shared-memory chip can take: all memory minus room for Linux
    and the model's context (the BC-250 health check's own lines: ~12.5 GB of 16)."""
    pool = shared_pool()
    return pool - SHARED_OS_RESERVE if pool else None


def is_bc250():
    """The AMD BC-250 board (Cyan Skillfish, PCI device 0x13fe)."""
    for dev in DRM_DIR.glob("card*/device"):
        if _read_text(dev / "vendor").strip() == "0x1002" and \
                _read_text(dev / "device").strip() == "0x13fe":
            return True
    return False


def memory_readings():
    """Actual memory use, from the GPU driver and the kernel (not Ollama's estimate):
    VRAM, system RAM the driver has mapped for the GPU (GTT), and RAM. Bytes, or None."""
    gpu = None
    for dev in DRM_DIR.glob("card*/device"):
        try:
            total = int(_read_text(dev / "mem_info_vram_total"))
            used = int(_read_text(dev / "mem_info_vram_used"))
        except ValueError:
            continue
        if gpu is None or total > gpu["vram_total"]:
            try:
                gtt = int(_read_text(dev / "mem_info_gtt_used"))
            except ValueError:
                gtt = None
            try:
                gtt_total = int(_read_text(dev / "mem_info_gtt_total"))
            except ValueError:
                gtt_total = None
            gpu = {"vram_used": used, "vram_total": total, "gtt_used": gtt, "gtt_total": gtt_total,
                   "bc250": _read_text(dev / "device").strip() == "0x13fe"}
    info = dict(re.findall(r"^(\w+):\s+(\d+) kB", _read_text(Path("/proc/meminfo")), re.M))
    ram = None
    if "MemTotal" in info and "MemAvailable" in info:
        total = int(info["MemTotal"]) * 1024
        ram = {"ram_used": total - int(info["MemAvailable"]) * 1024, "ram_total": total}
    if not gpu and not ram:
        return None
    m = {**(gpu or {}), **(ram or {})}
    # A chip that shares system memory with its GPU (BC-250, APUs) has only a small
    # fixed slice of "VRAM"; the model lives in system memory the GPU borrows (GTT).
    # (A small AMD slice next to an NVIDIA or Intel card is an integrated GPU nobody
    # uses for the AI, so that isn't shared mode.)
    other_gpu = any(_read_text(d / "vendor").strip() not in ("", "0x1002")
                    and _read_text(d / "class").strip().startswith("0x03")
                    for d in DRM_DIR.glob("card*/device"))
    m["shared"] = bool(gpu and (gpu.pop("bc250", False) or
                                (gpu["vram_total"] < SHARED_VRAM_BELOW and not other_gpu)))
    m.pop("bc250", None)
    borrowed = (gpu["gtt_used"] or 0) if gpu and m["shared"] else 0
    m["gpu_used"] = gpu["vram_used"] + borrowed if gpu else None
    return m


_FDINFO_VRAM = [re.compile(rf"^drm-{k}-vram:\s*(\d+)\s*([KMG]iB)?", re.M)
                for k in ("memory", "resident", "total")]      # older and newer kernels
_UNITS = {None: 1, "KiB": 2**10, "MiB": 2**20, "GiB": 2**30}


_FDINFO_GTT = [re.compile(rf"^drm-{k}-gtt:\s*(\d+)\s*([KMG]iB)?", re.M)
               for k in ("memory", "resident", "total")]


def _fdinfo_bytes(patterns, info):
    for pattern in patterns:
        m = pattern.search(info)
        if m:
            return int(m.group(1)) * _UNITS[m.group(2)]
    return None


def fdinfo_vram(info, gtt=False):
    """(GPU client id or None, bytes of VRAM, PCI device or None) from one
    /proc/PID/fdinfo/FD, or None if it isn't a GPU file with VRAM accounting. With
    `gtt`, borrowed system memory counts too (shared-memory chips keep models there)."""
    vram = _fdinfo_bytes(_FDINFO_VRAM, info)
    if vram is None:
        return None
    if gtt:
        vram += _fdinfo_bytes(_FDINFO_GTT, info) or 0
    cid = re.search(r"^drm-client-id:\s*(\d+)", info, re.M)
    pdev = re.search(r"^drm-pdev:\s*(\S+)", info, re.M)
    return (cid.group(1) if cid else None), vram, pdev.group(1) if pdev else None


def main_gpu_pdev():
    """PCI address of the card with the most VRAM (the one memory_readings reports), so
    an integrated GPU's memory isn't added in."""
    best = (0, None)
    for dev in DRM_DIR.glob("card*/device"):
        try:
            total = int(_read_text(dev / "mem_info_vram_total"))
        except ValueError:
            continue
        if total > best[0]:
            best = (total, dev.resolve().name)
    return best[1]


def vram_holders(min_bytes=64 * 2**20, proc="/proc", pdev=None, gtt=None):
    """Programs holding video memory, biggest first: [(pid, name, bytes)], from the
    driver's own per-program accounting. Only programs this user may look at, which on
    a gaming PC includes Steam, its interface and its games. Costs a scan of /proc, so
    it runs on request, never in the 2 s loop."""
    out = []
    pdev = pdev or main_gpu_pdev()
    gtt = shared_memory_gpu() if gtt is None else gtt
    try:
        entries = sorted((e.name for e in os.scandir(proc) if e.name.isdigit()), key=int)
    except OSError:
        return out
    seen = set()          # a GPU client passed to a child process is listed under the first
    for pid in entries:
        clients = {}
        try:
            fds = os.listdir(f"{proc}/{pid}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                if not os.readlink(f"{proc}/{pid}/fd/{fd}").startswith("/dev/dri/"):
                    continue
            except OSError:
                continue
            found = fdinfo_vram(_read_text(Path(f"{proc}/{pid}/fdinfo/{fd}")), gtt)
            if not found or (pdev and found[2] and found[2] != pdev):
                continue
            key = (found[2], found[0]) if found[0] else (pid, fd)
            if key not in seen:      # several open files can share one GPU client
                seen.add(key)
                clients[key] = found[1]
        total = sum(clients.values())
        if total >= min_bytes:
            name = _read_text(Path(f"{proc}/{pid}/comm")).strip() or "?"
            out.append((int(pid), name, total))
    return sorted(out, key=lambda h: -h[2])


def size_text(b):
    return f"{b / 2**30:.1f} GB" if b >= 2**30 else f"{max(1, round(b / 2**20))} MB"


def holders_text(holders, limit=4):
    """'gamescope-wl 900 MB, steamwebhelper 210 MB'."""
    return ", ".join(f"{name} {size_text(b)}" for _, name, b in holders[:limit])


def wait_vram_settled(timeout=10.0, stop=None):
    """After Ollama stops: wait until the driver's VRAM reading stops falling (the driver
    can take a moment to hand memory back). Returns the settled reading, or None."""
    end, last, steady = time.monotonic() + timeout, None, 0
    while time.monotonic() < end:
        used = gpu_used(memory_readings())
        if used is None:
            return None
        steady = steady + 1 if last is not None and abs(used - last) < 32 * 2**20 else 0
        if steady >= 3:
            return used
        last = used
        if stop is not None and stop.wait(0.3):
            break
        if stop is None:
            time.sleep(0.3)
    return last


# Ollama's own list of out-of-memory messages (llm/status.go), plus the GPU libraries'.
OOM_RE = re.compile(r"out[- _]of[- _](device[- _])?memory|outofdevicememory|erroroutofmemory|"
                    r"failed to allocate|allocation failed|unable to allocate|insufficient memory|"
                    r"not enough memory|failed to reserve graph|requires more system memory|"
                    r"(cuda|hip)Malloc failed", re.I)


def memory_line(m):
    """'GPU 15.1 / 16.0 GB · RAM 9.8 / 31.3 GB (+2.3 GB of RAM mapped for the GPU)', or on
    a shared-memory chip 'shared memory 13.2 / 15.5 GB, 11.8 GB of it used by the GPU'."""
    if not m:
        return ""
    g = lambda b: f"{b / 2**30:.1f}"      # GiB: how cards and RAM are sold ("16 GB")
    if m.get("shared") and m.get("ram_total"):
        return (f"shared memory {g(m['ram_used'])} / {g(m['ram_total'])} GB, "
                f"{g(m.get('gtt_used') or 0)} GB of it used by the GPU")
    parts = []
    if m.get("vram_total"):
        parts.append(f"GPU {g(m['vram_used'])} / {g(m['vram_total'])} GB")
    if m.get("ram_total"):
        parts.append(f"RAM {g(m['ram_used'])} / {g(m['ram_total'])} GB")
    line = " · ".join(parts)
    if m.get("gtt_used") and m["gtt_used"] > 2**30:
        line += f" (+{g(m['gtt_used'])} GB of RAM mapped for the GPU)"
    return line


