def _runtime_dir():
    """Per-user tmpfs (/run/user/UID): status is rewritten often and needn't hit the disk."""
    # getuid doesn't exist on Windows, where only the remote commands (status --host,
    # wake) are useful; they must still be able to import this file.
    uid = os.getuid() if hasattr(os, "getuid") else None
    base = Path(os.environ.get("XDG_RUNTIME_DIR") or (f"/run/user/{uid}" if uid is not None else "/nonexistent"))
    return base / APP if base.is_dir() else STATE_DIR


