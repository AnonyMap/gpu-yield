def cmd_run(args):
    cfg = load_config_or_wait()
    if cfg is not None:
        Watcher(cfg).run()


def load_config_or_wait():
    """Load the config. If it's broken, don't crash-loop under systemd: make sure Ollama
    is off (a game may start at any moment), say why, and wait for the file to be fixed."""
    try:
        return load_config()
    except SystemExit:
        pass
    m = re.search(r"^\s*port\s*=\s*(\d+)", _read_text(CONFIG_FILE), re.M)
    port = int(m.group(1)) if m else DEFAULTS["port"]
    user_systemctl("stop", MANAGED_OLLAMA_UNIT)
    standin = StandIn(port)
    standin.message = (f"The AI server on {socket.gethostname()} is off: gpu-yield's config "
                       f"file has an error ({CONFIG_FILE}).")
    standin.retry_after = 600
    standin.start()
    log(f"config error; Ollama kept off until {CONFIG_FILE} is fixed")
    stop = threading.Event()
    if threading.current_thread() is threading.main_thread():
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, lambda *_: stop.set())
    seen, since = None, time.time()
    while not stop.is_set():
        try:
            mtime = CONFIG_FILE.stat().st_mtime
        except OSError:
            mtime = None
        if mtime != seen:
            if seen is not None:
                try:
                    cfg = load_config()
                    standin.stop()
                    log("config fixed; starting normally")
                    return cfg
                except SystemExit:
                    pass
            seen = mtime
        write_status_file({"state": "config_error", "since": since, "games": [],
                           "model": "", "model_status": "unloaded", "notice": "",
                           "updated": time.time(), "pid": os.getpid(), "version": VERSION})
        stop.wait(3)
    standin.stop()
    return None


STATE_TEXT = {
    "ai": "AI running (no game)",
    "gaming": "game running, AI stopped",
    "cooldown": "game closed, waiting before reloading the model",
    "paused": "paused manually",
    "config_error": f"AI kept off: the config file has an error (fix {CONFIG_FILE})",
    None: "starting up",
}


def read_status():
    try:
        return json.loads(STATUS_FILE.read_text())
    except (OSError, ValueError):
        return None


def cmd_status(args):
    active = user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0
    st = read_status()
    print(f"Watcher:  {'running' if active else 'NOT running'}"
          + ("" if active else f"   (start: systemctl --user start {WATCHER_UNIT})"))
    if not st:
        print("No status yet.")
        return
    stale = time.time() - st.get("updated", 0) > 30
    print(f"State:    {STATE_TEXT.get(st.get('state'), st.get('state'))}"
          f" for {ago(time.time() - st.get('since', time.time()))}"
          + ("   (stale: last update " + ago(time.time() - st['updated']) + " ago)" if stale else ""))
    if st.get("games"):
        print(f"Games:    {', '.join(st['games'])}")
    if st.get("cooldown_remaining") is not None:
        print(f"Resumes:  in {st['cooldown_remaining']}s")
    if st.get("state") == "config_error":
        print(f"Fix:      gpu-yield doctor shows the error; edit {CONFIG_FILE}")
    elif st.get("model"):
        print(f"Model:    {st['model']} @ {st.get('context_length')} ctx: {st.get('model_status')}")
    else:
        print("Model:    none chosen (run: gpu-yield model)")
    if st.get("notice"):
        print(f"Note:     {st['notice']}")
    if st.get("version") and st["version"] != VERSION:
        print(f"Version:  watcher runs {st['version']}, this command is {VERSION} "
              f"(apply with: systemctl --user restart {WATCHER_UNIT})")
    if PAUSE_FILE.exists():
        print("Paused:   yes (gpu-yield resume to undo)")


def cmd_pause(args):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PAUSE_FILE.touch()
    print("Paused. The AI stays off until: gpu-yield resume")


def cmd_resume(args):
    if PAUSE_FILE.exists():
        PAUSE_FILE.unlink()
        print("Resumed. The model will load in a few seconds if no game is running.")
    else:
        print("Not paused.")


def cmd_doctor(args):
    cfg = load_config()
    problems = 0

    def ok(msg):
        print(f"  ok    {msg}")

    def bad(msg):
        nonlocal problems
        problems += 1
        print(f"  FIX   {msg}")

    def note(msg):
        print(f"        {msg}")

    print(f"gpu-yield {VERSION}, Python {platform.python_version()}")
    if tomllib is None:
        bad("Python 3.11+ required")
    if user_systemctl("show-environment").returncode:
        bad("systemd user manager not reachable (run as your normal user, not root)")
    if user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0:
        ok("watcher service running")
    else:
        bad(f"watcher not running: systemctl --user enable --now {WATCHER_UNIT}")
    linger = run(["loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger", "--value"]).stdout.strip()
    (ok if linger == "yes" else bad)(f"linger {'enabled' if linger == 'yes' else 'disabled: loginctl enable-linger'}"
                                       " (services start at boot without waiting for login)")

    if cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT:
        if OLLAMA_BIN.exists():
            ver = run([str(OLLAMA_BIN), "--version"]).stdout.strip().splitlines()
            ok(f"Ollama installed: {ver[-1] if ver else OLLAMA_BIN}")
        else:
            bad("Ollama not installed: gpu-yield setup")
    if run(["systemctl", "is-active", "--quiet", "ollama.service"]).returncode == 0:
        bad("a system-wide ollama.service is running and competes for the port: "
            "sudo systemctl disable --now ollama.service")
    if cfg["backend"] == "rocm":
        kfd = Path("/dev/kfd")
        if kfd.exists() and os.access(kfd, os.R_OK | os.W_OK):
            ok("/dev/kfd accessible (ROCm)")
        else:
            bad("/dev/kfd missing or not accessible: ROCm will fall back to CPU. "
                "Try backend = \"vulkan\" or add yourself to the render group")
    renders = list(Path("/dev/dri").glob("renderD*"))
    if renders and all(os.access(r, os.R_OK | os.W_OK) for r in renders):
        ok("GPU render node accessible")
    else:
        bad("GPU render node not accessible")

    games = scan_games(cfg)
    note(f"games detected right now: {', '.join(sorted(set(games.values()))) or 'none'}")
    st = read_status()
    if st and st.get("state") == "ai":
        o = Ollama(cfg)
        if o.ready():
            ok(f"Ollama answering on port {cfg['port']}")
            models = o.loaded() or []
            if models:
                share = gpu_share(models)
                ctx = models[0].get("context_length")
                problem, msg = placement_note(o, models[0].get("name"), share)
                (bad if problem else ok)(f"{models[0].get('name')} loaded, {share}% on GPU"
                                         + (f", context {ctx}" if ctx else ""))
                if msg:
                    note(msg)
            else:
                bad(f"no model loaded ({st.get('model_status')})")
            if st.get("notice"):
                bad(st["notice"])
        else:
            bad("Ollama not answering; see journalctl --user -u gpu-yield-ollama")
    elif st:
        note(f"state: {STATE_TEXT.get(st.get('state'))}; Ollama checks skipped")

    ip, net = lan_address()
    if run(["systemctl", "is-active", "--quiet", "firewalld"]).returncode == 0:
        note(f"firewalld is active; port {cfg['port']} must be open to {net or 'your LAN'} "
             "(gpu-yield setup offers to do this)")
    note(f"Hermes base_url: http://{ip or '<this-pc-ip>'}:{cfg['port']}/v1")
    print("All good." if problems == 0 else f"{problems} thing(s) to fix.")


# --- setup

def ask(question, args, default=True):
    if args.yes:
        return default
    if not sys.stdin.isatty():
        return default
    suffix = " [Y/n] " if default else " [y/N] "
    answer = input(question + suffix).strip().lower()
    return default if not answer else answer.startswith("y")


def sudo(cmd):
    print(f"  $ sudo {' '.join(cmd)}")
    return subprocess.run(["sudo", *cmd]).returncode == 0


def download(url, dest):
    dest.parent.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(url, headers={"User-Agent": f"{APP}/{VERSION}"})
    with urllib.request.urlopen(req, timeout=60) as r, open(dest, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        done, shown = 0, -1
        while chunk := r.read(1 << 20):
            f.write(chunk)
            done += len(chunk)
            if total:
                pct = done * 100 // total
                if pct // 10 != shown:
                    shown = pct // 10
                    print(f"    {dest.name}: {pct}% of {total / 2**30:.1f} GiB", flush=True)
    if total and done != total:
        raise OSError(f"download of {url} stopped at {done} of {total} bytes")
    return dest


def install_ollama(backend):
    """Download and unpack Ollama next to the current install, then swap it in.

    The working install is only replaced once the new one has unpacked and runs, so a
    failed or interrupted download leaves the old Ollama in place.
    """
    if platform.machine() != "x86_64":
        die(f"unsupported CPU architecture: {platform.machine()}")
    if not shutil.which("zstd"):
        die("zstd is needed to unpack Ollama but was not found")
    staging = OLLAMA_DIR.with_name(OLLAMA_DIR.name + ".new")
    previous = OLLAMA_DIR.with_name(OLLAMA_DIR.name + ".old")
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)
    packages = ["ollama-linux-amd64.tar.zst"]
    if backend == "rocm":
        packages.append("ollama-linux-amd64-rocm.tar.zst")
        log("  (the ROCm package is large; this can take a few minutes)")
    keep = "the current Ollama install was left as it was" if OLLAMA_DIR.exists() else \
           "nothing was installed"
    try:
        for pkg in packages:
            archive = CACHE_DIR / pkg
            try:
                download(f"{DOWNLOAD_BASE}/{pkg}", archive)
                r = run(["tar", "--zstd", "-xf", str(archive), "-C", str(staging)])
                if r.returncode:
                    raise OSError(f"could not unpack {pkg}: {r.stderr.strip()[-300:]}")
            finally:
                archive.unlink(missing_ok=True)
        new_bin = staging / "bin/ollama"
        if not new_bin.exists():
            raise OSError("the download did not contain bin/ollama")
        if run([str(new_bin), "--version"]).returncode:
            raise OSError("the downloaded Ollama does not run on this system")
    except (OSError, http.client.HTTPException) as e:   # URLError and timeouts are OSErrors
        shutil.rmtree(staging, ignore_errors=True)
        die(f"Ollama install failed ({e}); {keep}")
    shutil.rmtree(previous, ignore_errors=True)
    if OLLAMA_DIR.exists():
        OLLAMA_DIR.rename(previous)        # old libraries must not mix with the new ones
    staging.rename(OLLAMA_DIR)
    shutil.rmtree(previous, ignore_errors=True)
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    link = BIN_DIR / "ollama"
    if link.is_symlink() or not link.exists():
        link.unlink(missing_ok=True)
        link.symlink_to(OLLAMA_BIN)
    log(f"  installed {run([str(OLLAMA_BIN), '--version']).stdout.strip().splitlines()[-1]}")


def check_conflicts(args):
    if run(["systemctl", "is-active", "--quiet", "ollama.service"]).returncode == 0 or \
       run(["systemctl", "is-enabled", "--quiet", "ollama.service"]).returncode == 0:
        warn("a system-wide ollama.service exists. It would hold the port and keep "
             "using the GPU during games.")
        if ask("Disable it?", args):
            sudo(["systemctl", "disable", "--now", "ollama.service"])
    for unit in ("homebrew.ollama.service", "ollama.service"):
        if user_systemctl("is-enabled", "--quiet", unit).returncode == 0 or \
           user_systemctl("is-active", "--quiet", unit).returncode == 0:
            warn(f"user service {unit} also runs Ollama.")
            if ask(f"Disable {unit}?", args):
                user_systemctl("disable", "--now", unit)


def setup_firewall(cfg, args):
    if run(["systemctl", "is-active", "--quiet", "firewalld"]).returncode:
        log("  firewalld not active; nothing to open")
        return
    ip, net = lan_address()
    if not net:
        warn("could not work out your LAN subnet; open the port manually if Hermes can't connect")
        return
    rule = (f'rule family="ipv4" source address="{net}" '
            f'port port="{cfg["port"]}" protocol="tcp" accept')
    if ask(f"Allow port {cfg['port']} from your local network ({net}) only? Needs sudo.", args):
        if sudo(["firewall-cmd", "--permanent", f"--add-rich-rule={rule}"]):
            sudo(["firewall-cmd", "--reload"])


def enable_linger(args):
    user = os.environ.get("USER") or HOME.name
    if run(["loginctl", "show-user", user, "-p", "Linger", "--value"]).stdout.strip() == "yes":
        return
    if run(["loginctl", "enable-linger", user]).returncode:
        sudo(["loginctl", "enable-linger", user])


# name, approximate size in GB, one-line description, system RAM (GiB) it needs
MODEL_CHOICES = [
    ("gpt-oss:20b", 13, "recommended: reliable tool calling, fast", 0),
    ("qwen3.6:35b-a3b", 23, "stronger agent model; part of it runs from system RAM", 30),
    ("qwen3.5:9b", 6.6, "smaller and faster, accepts images", 0),
    ("qwen3.5:4b", 3.4, "smallest; quick answers, weak at multi-step tool use", 0),
]


def detect_memory():
    """(system RAM GiB, largest GPU VRAM GiB); either may be None."""
    ram = vram = None
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                ram = int(line.split()[1]) / 2**20
    except (OSError, ValueError):
        pass
    for f in Path("/sys/class/drm").glob("card*/device/mem_info_vram_total"):
        try:
            vram = max(vram or 0, int(f.read_text()) / 2**30)
        except (OSError, ValueError):
            pass
    return ram, vram


def choose_model(args):
    """Ask which model to use. Returns a model name, "" for skip, or None if no one can answer."""
    if getattr(args, "yes", False) or not sys.stdin.isatty():
        return None
    ram, vram = detect_memory()
    hw = ", ".join(x for x in (f"{vram:.0f} GB VRAM" if vram else "",
                               f"{ram:.0f} GB RAM" if ram else "") if x)
    print(f"\nWhich model should stay loaded while the PC is idle?" + (f"  (this PC: {hw})" if hw else ""))
    for i, (name, size, blurb, min_ram) in enumerate(MODEL_CHOICES, 1):
        short = f"   [needs ~32 GB RAM, this PC has {ram:.0f}]" if min_ram and ram and ram < min_ram else ""
        print(f"  {i}) {name:<16} {'~' + format(size, 'g') + ' GB':<8} {blurb}{short}")
    n = len(MODEL_CHOICES)
    print(f"  {n + 1}) another model (type its Ollama name)")
    print(f"  {n + 2}) none for now (choose later with: gpu-yield model)")
    while True:
        answer = input("Choice [1]: ").strip() or "1"
        if answer.isdigit() and 1 <= int(answer) <= n:
            return MODEL_CHOICES[int(answer) - 1][0]
        if answer == str(n + 1):
            name = input("Ollama model name (e.g. gemma4:12b): ").strip()
            if name:
                return name
        elif answer == str(n + 2):
            return ""
        else:
            print(f"Enter a number from 1 to {n + 2}.")


def pull_and_load(cfg, name):
    """Download a model and load it into VRAM. Returns True if the download worked."""
    managed = cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT
    exe = str(OLLAMA_BIN) if managed else (shutil.which("ollama") or "ollama")
    env = dict(os.environ, OLLAMA_HOST=f"127.0.0.1:{cfg['port']}")
    if subprocess.run([exe, "pull", name], env=env).returncode:
        warn(f"download failed; check the name, then retry with: gpu-yield model {name}")
        return False
    log("  loading it into VRAM...")
    o = Ollama(dict(cfg, model=name))
    try:
        o.warm()
        share = gpu_share(o.loaded())
        log(f"  loaded, {share}% on GPU" if share is not None else "  loaded")
        problem, msg = placement_note(o, name, share)
        if msg:
            (warn if problem else log)(("" if problem else "  ") + msg)
    except Exception as e:
        warn(f"model downloaded but loading failed: {e}")
    return True


def cmd_model(args):
    if os.geteuid() == 0:
        die("run as your normal user, not with sudo")
    cfg = load_config()
    old = cfg["model"]
    print(f"Current model: {old or 'none'}")
    name = args.name
    if not name:
        name = choose_model(args)
        if name is None:
            die("no terminal to ask in; give the name: gpu-yield model <name>")
        if not name:
            print("No change.")
            return
    o = Ollama(cfg)
    if not o.ready():
        st = read_status() or {}
        die(f"Ollama isn't running right now ({STATE_TEXT.get(st.get('state'), 'unknown state')}). "
            "Try again when no game is running and gpu-yield isn't paused.")
    if not pull_and_load(cfg, name):
        sys.exit(1)
    set_config_values({"model": name})
    user_systemctl("restart", WATCHER_UNIT)   # the watcher picks up the new model
    print(f"\nNow using {name}. Set model.default to {name} in Hermes's config to match.")
    if old and old != name:
        print(f"The old model is still on disk; free the space with: ollama rm {old}")


def hermes_snippet(cfg):
