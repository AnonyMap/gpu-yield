def speed_prompt():
    """About 2,000 tokens of plain notes, with a fresh first line so Ollama's prompt cache
    can't skip the reading."""
    lines = [f"Run {os.urandom(4).hex()}. Below are study notes."]
    for i in range(1, 61):
        topic = SPEED_TOPICS[i % len(SPEED_TOPICS)]
        lines.append(f"Note {i}: A short explanation of {topic}, written for a curious "
                     f"reader, covering the main idea, one surprising detail, and a common "
                     f"misunderstanding people have about {topic}.")
    lines.append("Summarize these notes in three sentences.")
    return "\n".join(lines)


def speed_test(ollama, name, context_length, label=None):
    """Read a ~2,000-token prompt and write 128 tokens; return the speeds."""
    r = ollama.request("/api/generate", {
        "model": name, "prompt": speed_prompt(), "stream": False, "keep_alive": -1,
        "options": {"num_ctx": int(context_length), "num_predict": 128, "temperature": 0,
                    "seed": 1}}, timeout=600)
    pt, pd = r.get("prompt_eval_count") or 0, r.get("prompt_eval_duration") or 0
    gt, gd = r.get("eval_count") or 0, r.get("eval_duration") or 0
    if not (pt and pd and gt and gd):
        raise RuntimeError("Ollama didn't report timings")
    return {"model": label or name, "context_length": int(context_length), "at": time.time(),
            "prompt_tokens": pt, "read_tps": round(pt / (pd / 1e9), 1),
            "gen_tokens": gt, "write_tps": round(gt / (gd / 1e9), 1)}


