h2 { font-size:17px; margin:0 0 12px; }
h3 { font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:.04em;
     color:var(--mut); margin:22px 0 8px; }
.card { background:var(--card); border:1px solid var(--line); border-radius:12px;
        padding:18px 20px; margin-bottom:14px; }
.state { display:flex; align-items:center; gap:10px; font-size:21px; font-weight:600; }
.dot { width:12px; height:12px; border-radius:50%; flex:none; background:var(--off); }
.dot.ok { background:var(--ok); } .dot.wait { background:var(--wait); }
dl { display:grid; grid-template-columns:max-content 1fr; gap:6px 16px; margin:16px 0 0; }
dt { color:var(--mut); } dd { margin:0; overflow-wrap:anywhere; }
.note { margin-top:14px; padding:10px 12px; border-radius:8px; border:1px solid var(--line); }
.muted { color:var(--mut); font-size:14px; }
code { font-size:13px; background:var(--bg); padding:1px 5px; border-radius:4px; overflow-wrap:anywhere; }
button, input, select { font:inherit; color:inherit; }
button { border:1px solid var(--line); background:var(--field); border-radius:8px;
         padding:6px 12px; cursor:pointer; min-height:36px; white-space:nowrap; }
button.primary { background:var(--acc); color:var(--acc-fg); border-color:var(--acc); }
button.danger { color:var(--bad); }
button:disabled { opacity:.45; cursor:default; }
input[type=text], input[type=password], select { border:1px solid var(--line); background:var(--field);
         border-radius:8px; padding:7px 10px; min-height:38px; width:100%; }
.line { display:flex; gap:8px; align-items:center; }
.line > input, .line > select { flex:1; min-width:0; }
.models { list-style:none; margin:0; padding:0; }
.models li { display:flex; gap:8px; align-items:center; padding:8px 0; border-top:1px solid var(--line); }
.models li:first-child { border-top:0; }
.models .name { flex:1; min-width:0; overflow-wrap:anywhere; }
.tag { font-size:12px; border:1px solid var(--line); border-radius:999px; padding:1px 8px;
       color:var(--mut); white-space:nowrap; }
.tag.on { color:var(--ok); border-color:var(--ok); }
progress { width:100%; height:8px; accent-color:var(--ok); }
.job { padding:8px 0; border-top:1px solid var(--line); }
label.check { display:flex; gap:8px; align-items:center; font-size:14px; margin-top:8px; }
#msg { min-height:1.5em; margin:12px 0 0; font-size:14px; }
.events { list-style:none; margin:0; padding:0; font-size:14px; }
.events li { display:flex; gap:10px; padding:5px 0; border-top:1px solid var(--line); }
.events li:first-child { border-top:0; }
.events .when { color:var(--mut); flex:none; width:4.5em; text-align:right; }
.events .error .what { color:var(--bad); } .events .warn .what { color:var(--wait); }
table.speeds { width:100%; border-collapse:collapse; font-size:14px; margin-top:8px; }
table.speeds th { text-align:left; font-weight:600; color:var(--mut); font-size:12px; }
table.speeds td, table.speeds th { padding:5px 6px 5px 0; border-top:1px solid var(--line); }
table.speeds td.num, table.speeds th.num { text-align:right; }
#msg.err { color:var(--bad); }
footer { color:var(--mut); font-size:13px; }
a { color:inherit; }
[hidden] { display:none !important; }
</style></head><body><main>
<h1 id="title">gpu-yield on __HOST__</h1>

<section class="card" aria-live="polite">
  <div class="state"><span class="dot" id="dot"></span><span id="headline">Loading…</span></div>
  <dl id="rows"></dl>
  <div class="note" id="notice" hidden></div>
  <noscript><p class="muted">Turn on JavaScript for live updates and controls, or see <a href="/status">the raw status</a>.</p></noscript>
</section>

<section class="card" id="eventscard" hidden>
  <h2>Recent events</h2>
  <ul class="events" id="events"></ul>
  <button type="button" id="evmore" hidden style="margin-top:8px">Show all</button>
</section>

<section class="card" id="controls">
  <h2>Controls</h2>
  <div id="off" hidden>
    <p class="muted">Controls are off, so this page is read-only. To change models and settings
    from here, set a password on the PC:</p>
    <p><code>gpu-yield config control_password -</code></p>
  </div>
  <form id="unlock" hidden>
    <p class="muted">Enter the control password to change models and settings.</p>
    <div class="line"><input type="password" id="pw" autocomplete="current-password" aria-label="Control password">
    <button class="primary" type="submit">Unlock</button></div>
  </form>
  <div id="panel" hidden>
    <div class="line"><button id="pause" type="button"></button>
      <span class="muted" id="pausehint"></span></div>
    <div class="line"><button id="restart" type="button">Restart the AI</button>
      <span class="muted">Unloads the model, frees GPU memory, and loads it again.</span></div>

    <h3>Models on this PC</h3>
    <ul class="models" id="models"></ul>
    <p class="muted" id="disk"></p>

    <h3>Context length</h3>
    <div class="line"><select id="ctx" aria-label="Context length">
      <option value="8192">8K</option><option value="16384">16K</option>
      <option value="32768">32K</option><option value="65536">64K</option>
      <option value="131072">128K</option></select>
      <button id="ctxapply" type="button">Apply</button></div>
    <p class="muted">More context uses more memory. Set your AI apps to the same number.</p>

    <h3>Download a model</h3>
    <form id="pull"><div class="line">
      <input type="text" id="pullname" placeholder="e.g. qwen3.5:9b"
             aria-label="Model to download" autocapitalize="off" autocorrect="off" spellcheck="false">
      <button class="primary" type="submit">Download</button></div>
      <label class="check"><input type="checkbox" id="pulluse" checked> Use it when the download finishes</label>
    </form>
    <p class="muted">An Ollama name such as <code>qwen3.5:9b</code>, or a Hugging Face GGUF repo such as <code>hf.co/user/repo:Q4_K_M</code>. Pasting a link from either site works too.</p>
    <div id="jobs"></div>

    <h3>Speed test</h3>
    <div class="line"><button id="speedbtn" type="button">Test the loaded model</button>
      <span class="muted" id="speedstate"></span></div>
    <p class="muted">Reads about 2,000 tokens, then writes 128; takes a few seconds to a minute.
    <b>Reading</b> is how fast long prompts are taken in; <b>writing</b> is how fast answers appear.
    Best run while nothing else is using the AI: requests wait behind the test, and the next long
    conversation has to be re-read from the start.</p>
    <table class="speeds" id="speeds" hidden><thead><tr><th>Model</th><th class="num">Reading</th>
      <th class="num">Writing</th><th class="num">Context</th><th class="num">When</th></tr></thead>
      <tbody></tbody></table>

    <p class="muted"><a href="#" id="lock">Lock controls on this device</a></p>
  </div>
  <p id="msg" role="status"></p>
</section>

<footer>gpu-yield <span id="ver"></span> · <a href="/status">JSON</a></footer>
</main>
<script id="initial" type="application/json">__SNAPSHOT__</script>
<script>
"use strict";
const $ = id => document.getElementById(id);
const KEY = "gpu-yield-password";
let pw = null, snap = JSON.parse($("initial").textContent), models = null, modelsError = "", busy = false;
let ctxChoice = null, modelsKey = "", jobsKey = "", eventsKey = "", speedKey = "", tick = 0, allEvents = false, lastSpeed = null;   // unapplied dropdown choice; last drawn lists
try { pw = localStorage.getItem(KEY); } catch (e) {}

function el(tag, attrs, ...kids) {
  const n = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs || {})) {
    if (k === "onclick") n.addEventListener("click", v); else if (v !== false && v != null) n.setAttribute(k, v);
  }
  for (const k of kids) n.append(k);
  return n;
}
function ago(t) {
  const s = Math.max(0, Math.round(Date.now() / 1000 - t));
  const m = Math.floor(s / 60);
  return s < 90 ? s + "s" : s < 5400 ? Math.round(s / 60) + "m" : Math.floor(m / 60) + "h " + m % 60 + "m";
}
function gb1(bytes) { return (bytes / 1073741824).toFixed(1); }   // GiB, as cards and RAM are sold
function gb(bytes) { return bytes < 1e9 ? Math.max(1, Math.round(bytes / 1e6)) + " MB" : (bytes / 1e9).toFixed(bytes >= 1e10 ? 0 : 1) + " GB"; }
function say(text, err) { $("msg").textContent = text || ""; $("msg").className = err ? "err" : ""; }
function same(a, b) {
  const n = x => { x = (x || "").trim().toLowerCase(); return x.split("/").pop().includes(":") ? x : x + ":latest"; };
  return n(a) === n(b);
}

function renderStatus(s) {
  const host = s.host || location.hostname;
  document.title = "gpu-yield on " + host;
  $("title").textContent = "gpu-yield on " + host;
  $("ver").textContent = s.version || "";
  let tone = "off", head = s.state_text || s.state;
  if (s.ai_available) { tone = "ok"; head = "AI ready"; }
  else if (s.state === "ai") { tone = "wait"; head = "AI starting: " + (s.model_status || ""); }
  else if (s.state === "cooldown") { tone = "wait"; head = "Game closed, AI back in about " + (s.cooldown_remaining || 0) + " s"; }
  else if (s.state === "gaming") { head = "Game running, AI paused"; }
  else if (s.state === "paused") { head = "Paused"; }
  $("dot").className = "dot " + tone;
  $("headline").textContent = head;
  const rows = [];
  if (s.games && s.games.length) rows.push(["Game", s.games.join(", ")]);
  if (s.model) rows.push(["Model", s.model + " · " + s.context_length + " context"]);
  else if (!s.redacted) rows.push(["Model", "none chosen"]);
  if (s.model && s.alias) rows.push(["Apps use", s.alias + " (always the loaded model)"]);
  const m = s.memory;
  if (m && m.shared && m.ram_total) rows.push(["Shared memory", gb1(m.ram_used) + " / " + gb1(m.ram_total)
    + " GB, " + gb1(m.gtt_used || 0) + " GB of it used by the GPU"]);
  else if (m && m.vram_total) rows.push(["GPU memory", gb1(m.vram_used) + " / " + gb1(m.vram_total) + " GB"
    + (m.gtt_used > 1073741824 ? " (+" + gb1(m.gtt_used) + " GB of RAM mapped for the GPU)" : "")]);
  if (m && m.ram_total && !m.shared) rows.push(["RAM", gb1(m.ram_used) + " / " + gb1(m.ram_total) + " GB"]);
  if (s.in_use) rows.push(["In use", "yes, right now"]);
  else if (s.last_used) rows.push(["Last used", ago(s.last_used) + " ago"]);
  if (s.since) rows.push(["Since", ago(s.since) + " ago"]);
  $("rows").replaceChildren(...rows.flatMap(([k, v]) => [el("dt", {}, k), el("dd", {}, String(v))]));
  $("notice").hidden = !s.notice;
  $("notice").textContent = s.notice || "";
  const ev = s.events || [];
  $("eventscard").hidden = !ev.length;
  const ek = JSON.stringify([ev.map(e => [e.at, e.text]), allEvents]);
  $("evmore").hidden = ev.length <= 6;
  $("evmore").textContent = allEvents ? "Show fewer" : "Show all " + ev.length;
  if (ek !== eventsKey || tick % 10 === 0) {
    eventsKey = ek;
    $("events").replaceChildren(...ev.slice(0, allEvents ? ev.length : 6).map(e => el("li", { class: e.kind || "info" },
      el("span", { class: "when" }, ago(e.at)),
      el("span", { class: "what" }, e.text + (e.count > 1 ? " (×" + e.count + ")" : "")))));
  }
}

function renderControls() {
  const s = snap;
  if (s.redacted) {           // opened under a name that isn't the PC's: no controls here
    $("off").hidden = $("unlock").hidden = $("panel").hidden = true;
    return;
  }
  $("off").hidden = !!s.controls;
  $("unlock").hidden = !s.controls || !!pw;
  $("panel").hidden = !s.controls || !pw;
  if (!s.controls || !pw) return;
  $("pause").textContent = s.paused ? "Resume the AI" : "Pause the AI";
  $("pausehint").textContent = s.paused ? "Paused until you resume it." : "Keeps the AI off until resumed, even after a reboot.";
  $("pause").disabled = busy;
  $("restart").disabled = busy || s.state !== "ai" || s.restarting || /^(restarting|starting|loading)/.test(s.model_status || "");
  if (![...$("ctx").options].some(o => o.value === String(s.context_length)))
    $("ctx").append(el("option", { value: String(s.context_length) }, String(s.context_length)));
  if (ctxChoice !== null && ctxChoice === String(s.context_length)) ctxChoice = null;
  $("ctx").value = ctxChoice !== null ? ctxChoice : String(s.context_length);   // keep a pending choice
  $("ctxapply").disabled = busy;

  // Redraw the lists only when they change, so a button isn't replaced under a tap or focus.
  const mk = JSON.stringify([models, modelsError, s.model, busy]);
  if (mk !== modelsKey) { modelsKey = mk; drawModels(s); }
  $("disk").textContent = models && models.disk_free ? gb(models.disk_free) + " free on the drive that holds " + models.models_dir : "";
  const jk = JSON.stringify(s.downloads || []);
  if (jk !== jobsKey) { jobsKey = jk; drawJobs(s); }
  const sp = s.speed || {};
  $("speedbtn").disabled = busy || sp.state === "running" || !s.ai_available;
  const res = sp.result;
  $("speedstate").textContent = sp.state === "running" ? "Testing " + sp.model + "…"
    : sp.state === "failed" ? "Failed: " + sp.error
    : sp.state === "done" && res ? "Reading " + res.read_tps + "/s, writing " + res.write_tps + "/s"
    : !s.ai_available ? "Needs the model loaded" : "";
  // Announce a test that finished since the last look (however quickly it ran), but not
  // results that were already there when the page opened.
  const outcome = sp.state === "running" ? null : sp.state + "|" + (res ? res.at : "") + "|" + (sp.error || "");
  if (outcome && lastSpeed !== null && outcome !== lastSpeed && sp.state !== "idle")
    say(sp.state === "done" && res ? "Speed test done: reading " + res.read_tps + " tokens/s, writing "
        + res.write_tps + " tokens/s." : "Speed test failed: " + sp.error, sp.state !== "done");
  if (outcome) lastSpeed = outcome;
  else if (lastSpeed === null) lastSpeed = "";
  const sk = JSON.stringify([s.speed_results, s.model]);
  if (sk !== speedKey || tick % 10 === 0) { speedKey = sk; drawSpeeds(s); }
}

function drawSpeeds(s) {
  const rs = s.speed_results || [];
  $("speeds").hidden = !rs.length;
  $("speeds").tBodies[0].replaceChildren(...rs.map(r => el("tr", {},
    el("td", {}, r.model + (same(r.model, s.model) ? " ●" : "")),
    el("td", { class: "num" }, r.read_tps + "/s"), el("td", { class: "num" }, r.write_tps + "/s"),
    el("td", { class: "num" }, String(r.context_length)), el("td", { class: "num" }, ago(r.at) + " ago"))));
}

function drawModels(s) {
  const list = $("models");
  if (!models) { list.replaceChildren(el("li", {}, el("span", { class: "muted" }, modelsError || "Loading…"))); }
  else if (!models.models.length) {
    list.replaceChildren(el("li", {}, el("span", { class: "muted" }, models.available ? "No models downloaded yet." : "Shown when the AI is running.")));
  } else {
    list.replaceChildren(...models.models.map(m => {
      const inUse = same(m.name, s.model);
      const tags = [el("span", { class: "tag" }, gb(m.size))];
      if (models.vram_gb && m.size / 1073741824 > models.vram_gb) tags.push(el("span", { class: "tag", title: models.shared ? "Bigger than a model may take in this board's shared memory; gpu-yield refuses it" : "Bigger than this PC's video memory; part of it runs from system RAM" }, models.shared ? "too big" : "> VRAM"));
      if (inUse) tags.push(el("span", { class: "tag on" }, "in use"));
      return el("li", {}, el("span", { class: "name" }, m.name), ...tags,
        inUse ? "" : el("button", { type: "button", disabled: busy, onclick: () => act("model", { name: m.name }, "Switching to " + m.name + "…") }, "Use"),
        inUse ? "" : el("button", { type: "button", class: "danger", disabled: busy, onclick: () => {
          if (confirm("Delete " + m.name + " from this PC? (" + gb(m.size) + ")")) act("delete", { name: m.name }, "Deleting…");
        } }, "Delete"));
    }));
  }
}

function drawJobs(s) {
  $("jobs").replaceChildren(...(s.downloads || []).map(j => {
    const pct = j.total ? Math.round(100 * j.completed / j.total) : null;
    const text = j.state === "running" ? (pct != null ? pct + "% of " + gb(j.total) : j.status || "starting")
      : j.state === "done" ? "downloaded" + (j.use ? ", switching to it" : "") : j.state === "cancelled" ? "cancelled" : "failed: " + (j.error || "");
    return el("div", { class: "job" },
      el("div", { class: "line" }, el("span", { class: "name", style: "flex:1;overflow-wrap:anywhere" }, j.name),
        j.state === "running" ? el("button", { type: "button", onclick: () => act("cancel", { name: j.name }, "Cancelling…") }, "Cancel") : ""),
      j.state === "running" ? el("progress", pct != null ? { max: 100, value: pct } : {}) : "",
      el("div", { class: "muted" }, text));
  }));
}

async function act(action, body, pending) {
  busy = true; say(pending || "…"); renderControls();
  try {
    const r = await fetch("/api/" + action, { method: "POST",
      headers: { "Content-Type": "application/json", "X-GPU-Yield-Password": encodeURIComponent(pw || "") },
      body: JSON.stringify(body || {}) });
    const d = await r.json().catch(() => ({}));
    if (r.status === 403 && action !== "auth") { forget(); }
    if (!r.ok) {
      if (d.busy && action === "speed" && confirm(d.error + " Run the speed test anyway?"))
        { busy = false; return act("speed", { force: true }, pending); }
      say(d.error || ("Error " + r.status), true); return false;
    }
    say(d.message || "");
    return true;
  } catch (e) { say("Couldn't reach the PC: " + e.message, true); return false; }
  finally { busy = false; await refresh(true); }
}
function forget() { pw = null; try { localStorage.removeItem(KEY); } catch (e) {} renderControls(); }

async function refresh(withModels) {
  try {
    const r = await fetch("/status", { cache: "no-store" });
    snap = await r.json();
    renderStatus(snap);
    if (pw && snap.controls && (withModels || !models)) {
      const m = await fetch("/api/models", { cache: "no-store" });
      const d = await m.json();
      models = m.ok ? d : null;
      modelsError = m.ok ? "" : "Couldn't list the models: " + (d.error || "error " + m.status);
    }
  } catch (e) { $("headline").textContent = "Can't reach the PC"; $("dot").className = "dot"; }
  renderControls();
}

$("unlock").addEventListener("submit", async ev => {
  ev.preventDefault();
  pw = $("pw").value;
  if (await act("auth", {}, "Checking…")) {
    try { localStorage.setItem(KEY, pw); } catch (e) {}
    $("pw").value = ""; say("Unlocked."); refresh(true);
  } else { pw = null; renderControls(); }
});
$("lock").addEventListener("click", ev => { ev.preventDefault(); forget(); say("Locked on this device."); });
$("pause").addEventListener("click", () => act("pause", { paused: !snap.paused }, snap.paused ? "Resuming…" : "Pausing…"));
$("restart").addEventListener("click", () => act("restart", {}, "Restarting…"));
$("ctx").addEventListener("change", () => { ctxChoice = $("ctx").value; });
$("ctxapply").addEventListener("click", () => act("context", { context_length: Number($("ctx").value) }, "Applying… the model reloads"));
$("pull").addEventListener("submit", ev => {
  ev.preventDefault();
  const name = $("pullname").value.trim();
  if (!name) return;
  act("pull", { name, use: $("pulluse").checked }, "Starting download…").then(ok => { if (ok) $("pullname").value = ""; });
});

$("speedbtn").addEventListener("click", () => act("speed", {}, "Starting the speed test…"));
$("evmore").addEventListener("click", () => { allEvents = !allEvents; renderStatus(snap); });

renderStatus(snap); renderControls(); refresh(true);
// Nothing to show in a hidden tab, so a phone or laptop left on the page costs the PC nothing.
setInterval(() => { if (document.hidden) return; tick++; refresh(tick % 5 === 0); }, 3000);
document.addEventListener("visibilitychange", () => { if (!document.hidden) refresh(true); });
</script>
</body></html>
"""

MODEL_NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]*(:[A-Za-z0-9._-]+)?")


PUBLIC_FIELDS = ("state", "ai_available", "retry_after", "cooldown_remaining", "version", "port")


def public_snapshot(snap, hint):
    """Only what a client needs to decide whether to call the AI now: for requests that
    name this PC by something other than its own name or address."""
    out = {k: snap[k] for k in PUBLIC_FIELDS if k in (snap or {})}
    out["redacted"] = True
    out["notice"] = "Details are hidden under this name. " + hint
    return out


def normalize_model_name(text):
    """Accept an Ollama name, a Hugging Face repo, or either site's URL; return what
    `ollama pull` expects (hf.co/user/repo[:quant] for Hugging Face)."""
    if text is not None and not isinstance(text, str):
        raise ValueError("the model name must be text")
    t = (text or "").strip().split("?", 1)[0].split("#", 1)[0]
    t = re.sub(r"^(https?://)?(www\.)?(huggingface\.co|hf\.co)/", "hf.co/", t, flags=re.I)
    t = re.sub(r"^(https?://)?(www\.)?ollama\.com/(library/)?", "", t, flags=re.I)
    if t.startswith("hf.co/"):
        parts = t[len("hf.co/"):].split("/")
        if len(parts) < 2 or not parts[0] or not parts[1]:
            raise ValueError("a Hugging Face model needs both the user and the repo, "
                             "like hf.co/user/repo")
        name = "hf.co/" + parts[0] + "/" + parts[1]       # drop /tree/main, /blob/... etc.
        # A link to one .gguf file names its quantization: keep it, or Ollama would
        # download its default quantization instead of the file that was picked.
        m = re.search(r"[-.]((?:I?Q\d\w*|F16|BF16|F32))\.gguf$", parts[-1], re.I) \
            if len(parts) > 2 and ":" not in parts[1] else None
        t = name + (":" + m.group(1) if m else "")
    else:
        t = re.sub(r"/tags/?$", "", t.rstrip("/"))         # an ollama.com model's tags page
    t = t.rstrip("/")
    if len(t) > 200 or not MODEL_NAME_RE.fullmatch(t):
        raise ValueError("that doesn't look like an Ollama or Hugging Face model name")
    return t


class StatusServer:
    """The page other computers see: GET / (page), GET /status (JSON), GET /api/models,
    and, when a control password is set, POST /api/<action> to change things."""

    MAX_BODY = 16_384

    def __init__(self, port, watcher):
        self.port = port
        self.watcher = watcher
        self.server = None

    def start(self):
        owner = self

        class Handler(BaseHTTPRequestHandler):
            server_version = APP
            timeout = 10

            def log_message(self, *args):
                pass

            def _send(self, code, body, ctype="application/json"):
                if isinstance(body, (dict, list)):
                    body = json.dumps(body, indent=1).encode()
                elif isinstance(body, str):
                    body = body.encode()
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                # Websites may not read it (it names the PC and its network card) or frame
                # the page (a framed page could be used to trick a click on a control).
                self.send_header("X-Frame-Options", "DENY")
                self.send_header("Content-Security-Policy", "frame-ancestors 'none'")
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(body)

            def do_GET(self):
                path = self.path.split("?", 1)[0]
                snap = None
                if path in ("/status", "/status.json", "/"):
                    try:
                        snap = owner.watcher.snapshot()
                    except Exception as e:
                        snap = {"state": "error", "error": str(e)}
                    # A website can get a browser to fetch this page under a name it controls
                    # (DNS rebinding) and read the reply. Under a name that isn't this PC's,
                    # answer only whether the AI can be used, not what's on the PC.
                    if not owner.host_allowed(self.headers.get("Host", "")):
                        snap = public_snapshot(snap, owner.host_hint())
                if path in ("/status", "/status.json"):
                    self._send(200, snap)
                elif path == "/":
                    self._send(200, render_status_page(snap), "text/html; charset=utf-8")
                elif path == "/api/models":
                    if not owner.host_allowed(self.headers.get("Host", "")):
                        return self._send(421, {"error": owner.host_hint()})
                    self._send(200, owner.watcher.api_models())
                else:
                    self._send(404, {"error": "not found"})

            do_HEAD = do_GET

            def do_POST(self):
                path = self.path.split("?", 1)[0]
                if not path.startswith("/api/"):
                    return self._send(404, {"error": "not found"})
                # A website can make a browser send requests to this page under a name the
                # website controls (DNS rebinding); real visitors use the PC's name or IP.
                if not owner.host_allowed(self.headers.get("Host", "")):
                    return self._send(421, {"error": owner.host_hint()})
                # JSON only: a plain HTML form on another site can't send this content type
                # (or the password header) without the browser asking first, and we don't
                # answer that question.
                if not self.headers.get("Content-Type", "").startswith("application/json"):
                    return self._send(415, {"error": "send JSON"})
                try:
                    length = int(self.headers.get("Content-Length") or 0)
                except ValueError:
                    length = -1
                if not 0 <= length <= owner.MAX_BODY:
                    return self._send(413, {"error": "request too large"})
                try:
                    data = json.loads(self.rfile.read(length) or b"{}")
                    if not isinstance(data, dict):
                        raise ValueError
                except (ValueError, RecursionError):      # RecursionError: absurdly nested
                    return self._send(400, {"error": "bad JSON"})
                # The page percent-encodes the password so any characters survive HTTP headers.
                password = urllib.parse.unquote(self.headers.get("X-GPU-Yield-Password", ""))
                self.server.request_read(self.request)
                code, reply = owner.watcher.api(path[len("/api/"):], data, password,
                                                client=self.client_address[0])
                self._send(code, reply)

            def do_OPTIONS(self):
                self._send(405, {"error": "cross-site requests aren't allowed"})

        # IPv4 only: `gpu-yield firewall` limits IPv4 to your network, but IPv6 addresses
        # are often reachable from the internet with no NAT in between. (Ollama itself
        # listens on IPv6 too; `gpu-yield firewall` limits that to local addresses.)
        try:
            server = PageServer(("0.0.0.0", self.port), Handler)
        except OSError as e:
            log(f"status page could not use port {self.port}: {e}")
            return False
        server.daemon_threads = True
        self.server = server
        threading.Thread(target=server.serve_forever, name="status-page", daemon=True).start()
        return True

    def stop(self):
        if self.server:
            self.server.shutdown()
            self.server.server_close()
            self.server = None

    def host_hint(self):
        # Worked out once: lan_address() runs `ip`, and any device can send a bad name.
        if getattr(self, "_hint", None):
            return self._hint
        ip, _ = lan_address()
        me = socket.gethostname().split(".", 1)[0]
        where = f" (http://{ip}:{self.port}/)" if ip else ""
        self._hint = (f"the controls only work when this page is opened as "
                      f"http://{me}.local:{self.port}/ or by the PC's IP address{where}, since "
                      "another name could belong to a website")
        return self._hint

    @staticmethod
    def host_allowed(host_header):
        """The PC's own name (with or without a domain), an IP address, or localhost."""
        host = host_header.strip().lower()
        host = host[1:].split("]", 1)[0] if host.startswith("[") else host.rsplit(":", 1)[0] \
            if host.count(":") == 1 else host
        if not host:
            return False
        try:
            ipaddress.ip_address(host)
            return True
        except ValueError:
            pass
        host = host.rstrip(".")
        full = socket.gethostname().lower()
        me = full.split(".", 1)[0]
        if host in ("localhost", me, full):
            return True
        # Not "<name>.anything": a website could point <name>.its-own-domain.com at this
        # PC (DNS rebinding). Only domains that can't be bought or that your network uses.
        name, _, domain = host.partition(".")
        return name == me and (domain in LOCAL_DOMAINS or domain in search_domains())


LOCAL_DOMAINS = {"local", "lan", "home", "home.arpa", "localdomain", "internal", "localhost"}


def search_domains():
    """Your network's own domains (from DHCP, via /etc/resolv.conf), e.g. "fritz.box"."""
    out = set()
    for line in _read_text(Path("/etc/resolv.conf")).splitlines():
        parts = line.split()
        if parts and parts[0] in ("search", "domain"):
            out.update(d.lower().rstrip(".") for d in parts[1:])
    return out


class QuietServer(ThreadingHTTPServer):
    """Sleeps until a connection arrives. The stock serve_forever wakes twice a second to
    check whether it should stop, which costs wakeups during a game for nothing."""

    def __init__(self, *args, **kw):
        self._stopping, self._running, self._done = False, False, threading.Event()
        super().__init__(*args, **kw)

    def serve_forever(self, poll_interval=None):
        self._running = True
        try:
            while not self._stopping:          # set before the thread started: exit at once
                self.handle_request()          # blocks: self.timeout is None
        finally:
            self._done.set()

    def shutdown(self):
        self._stopping = True
        try:      # wakes the blocked select at once, whatever address the server is bound to
            self.socket.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        if self._running and not self._done.wait(1):
            try:                               # fallback: a connection of our own
                socket.create_connection(("127.0.0.1", self.server_address[1]), timeout=1).close()
            except OSError:
                pass
            self._done.wait(4)


class PageServer(QuietServer):
    """At most MAX_CLIENTS connections at a time and PER_CLIENT from one address, each cut
    off after DEADLINE seconds however slowly it trickles in, so neither a flood nor a few
    deliberately slow connections can take the page away from everyone else."""
    request_queue_size = 64
    MAX_CLIENTS = 32
    PER_CLIENT = 6
    DEADLINE = 8

    def __init__(self, *args, **kw):
        self.slots = threading.BoundedSemaphore(self.MAX_CLIENTS)
        self.per_ip = collections.Counter()
        self.ip_lock = threading.Lock()
        self.timers = {}
        super().__init__(*args, **kw)

    def process_request(self, request, client_address):
        ip = client_address[0]
        with self.ip_lock:
            crowded = self.per_ip[ip] >= self.PER_CLIENT
            if not crowded:
                self.per_ip[ip] += 1
        if crowded or not self.slots.acquire(blocking=False):
            if not crowded:
                self._leave(ip)
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self.slots.release()
            self._leave(ip)
            raise

    def request_read(self, request):
        """The whole request is in: the deadline was for reading it, not for the work it
        asks for (deleting a model can take Ollama longer)."""
        timer = self.timers.get(request)
        if timer:
            timer.cancel()

    def _leave(self, ip):
        with self.ip_lock:
            self.per_ip[ip] -= 1
            if self.per_ip[ip] <= 0:
                del self.per_ip[ip]

    def process_request_thread(self, request, client_address):
        def cut():
            try:
                request.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
        timer = threading.Timer(self.DEADLINE, cut)
        timer.daemon = True
        self.timers[request] = timer
        timer.start()
        try:
            super().process_request_thread(request, client_address)
        finally:
            timer.cancel()
            self.timers.pop(request, None)
            self.slots.release()
            self._leave(client_address[0])


    def handle_error(self, request, client_address):
        if isinstance(sys.exc_info()[1], OSError):   # a visitor hung up or was cut off
            return
        super().handle_error(request, client_address)


class StandInServer(PageServer):
    """The stand-in's limits: apps like Hermes may open more connections than a browser."""
    MAX_CLIENTS = 64
    PER_CLIENT = 16



def render_status_page(snapshot):
    data = json.dumps(snapshot).replace("<", "\\u003c")     # can't close the <script> early
    return STATUS_PAGE.replace("__HOST__", html.escape(str(snapshot.get("host", "")))) \
                      .replace("__SNAPSHOT__", data)


# ----------------------------------------------------------------------------- watcher

class Watcher:
    OFF_STATES = ("gaming", "cooldown", "paused")

    def __init__(self, cfg):
        self.cfg = cfg
        self.ollama = Ollama(cfg)
        self.standin = StandIn(cfg["port"])
        self.page = None                  # the status page's server, while it's on
        self.host = socket.gethostname()
        self.stop_evt = threading.Event()
        self.state = None
        self.since = time.time()
        self.games = []
        self.cooldown_until = 0.0
        self.warm_gen = 0
        self.warm_status = "not loaded"
        self.warm_failed_at = None
        self.warm_retry = 300       # seconds before retrying a failed model load
        self.warming = False
        self.last_health = 0.0
        self.last_restart = 0.0
        self.ping_failures = 0
        self.empty_checks = 0       # consecutive health checks with no model loaded
        self.notice = ""            # client/setup problem worth showing in `status`
        self.warned = set()
        self.last_status = None
        self.last_status_write = 0.0
        self.last_error = ("", 0.0)
        self.in_use = False
        self.events = collections.deque(maxlen=30)
        self.loaded_name = None
        self.speed = {"state": "idle", "error": "", "result": None, "model": ""}
        self.speed_results = load_speed_results()
        self.speed_mtime = None
        self.alias_problem = ""
        self.actions = queue.Queue()     # changes requested from the page, applied by run()
        self.switching_to = None         # model being switched to right now
        # Held while deciding which model will be in use, and while a delete checks that
        # its model isn't one of them. Never held across a slow call.
        self.model_lock = threading.Lock()
        self.deleting = set()
        self.downloads = {}              # model name -> progress of a download
        self.dl_lock = threading.Lock()
        self.auth_lock = threading.Lock()
        self.failures = {}               # device -> wrong passwords and lockout
        self.recent_failures = collections.deque(maxlen=200)  # times of wrong passwords
        self.trusted = {}                # devices that gave the right password -> when
        self.lock_event_at = -1e9        # last lockout event (they're rate-limited)
        self.models_cache = {"models": [], "at": 0.0}
        self.wine_since = None
        self.last_used = None
        self.mac = nic_info()[1]
        self.next_update_check = time.clock_gettime(time.CLOCK_BOOTTIME) + 15 * 60   # first check 15 min after start
        self.updating = False
        self.restart_lock = threading.Lock()
        self.restart_request = None      # why a restart was asked for (page, out of memory)
        self.restart_signal = False      # set by SIGUSR1 (gpu-yield restart); no lock in a handler
        self.oom_retried = False         # one automatic restart per out-of-memory streak
        self.vram_report = ""            # what was left on the GPU after the last restart
        self.restart_busy = False        # inside restart_ai
        self.change_source = "the status page"   # who the next queued setting change is from
        self.block_reason = ""           # why gpu-yield paused the AI itself
        self.own_load = None             # (model, context, bytes) of our last successful load
        self.low_memory_at = None        # when the last low-memory reading was (shared chips)
        self.client_spills = {}          # (model, context) an app loaded that didn't fit -> times
        self.oom_checked = time.time()   # journal checked for out-of-memory kills up to here
        self.oom_kills = collections.deque(maxlen=5)
        self.restart_gen = None          # the load a restart started (its warm_gen)
        self.restart_count = 0           # lets `gpu-yield restart` see its restart begin

    # --- transitions
    def set_state(self, state):
        self.state = state
        self.since = time.time()

    def go_off(self, state, why):
        prev = self.state
        self.set_state(state)
        self.warm_gen += 1          # any warmup still in flight is now irrelevant
        self.oom_retried = False    # memory changes while it's off: a fresh try next time
        self.vram_report = ""
        self.warm_status = "not loaded"
        self.update_message(time.monotonic())
        self.event(why)
        if prev in self.OFF_STATES:
            return                  # already off; only the reason changed
        t = time.monotonic()
        self.ollama.stop()
        log(f"Ollama stopped ({time.monotonic() - t:.1f}s); GPU memory released")
        if self.standin.start():
            log(f"stand-in answering on port {self.cfg['port']}")

    def go_on(self, why):
        self.standin.stop()
        self.warm_status = "starting Ollama"     # not "ready" from before, while restarting
        self.set_state("ai")
        self.event(why)
        self.last_restart = time.monotonic()
        if not self.ollama.start():
            self.warm_status = "failed: Ollama would not start (journalctl --user -u " \
                               f"{self.cfg['ollama_unit']})"
            self.warm_failed_at = time.monotonic()
            return
        self.ping_failures = self.empty_checks = 0
        if not self.cfg["model"]:
            self.warm_status = "no model chosen (run: gpu-yield model)"
            return
        self.start_warm()

    def restart_in_progress(self):
        """Inside restart_ai, or its load is still the current one and still running. Any
        other load (a model or context change, a game in between) ends it."""
        return self.restart_busy or (self.restart_gen is not None
                                     and self.restart_gen == self.warm_gen and self.warming)

    def request_restart(self, why):
        """False if a restart is already pending or under way (one is enough)."""
        with self.restart_lock:
            if self.restart_request or self.restart_in_progress():
                return False
            self.restart_request = why
            return True

    def restarting(self):
        return bool(self.restart_request or self.restart_signal or self.restart_in_progress())

    def transfers_running(self):
        """A download or speed test that a restart would cut off."""
        return self.speed["state"] == "running" or \
            any(j["state"] == "running" for j in list(self.downloads.values()))

    def take_restart(self):
        """The pending restart's reason, if one should start now. Requests wait while a
        download or speed test runs, and are dropped while a restart is under way."""
        if self.restart_in_progress():
            self.restart_signal = False
            with self.restart_lock:
                self.restart_request = None
            return None
        if not (self.restart_signal or self.restart_request) or self.transfers_running():
            return None
        signalled, self.restart_signal = self.restart_signal, False
        with self.restart_lock:
            why, self.restart_request = self.restart_request, None
        return why or ("restart requested (gpu-yield restart)" if signalled else None)

    def restart_ai(self, why):
        """Unload everything, wait until the GPU memory has really come back, say what
        else is holding some, then load the model again. Holds up the main loop for up
        to ~10 s, and checks for a game before starting Ollama again."""
        self.restart_count += 1
        if self.state != "ai":
            self.event(f"{why}: nothing to restart, the AI is off right now; "
                       "it loads fresh when it comes back")
            return
        self.event(why)
        self.restart_busy, self.restart_gen = True, None
        try:
            self._restart(why)
        finally:
            self.restart_busy = False

    def _restart(self, why):
        self.oom_retried = True          # memory is as clear as a restart can make it
        self.warm_gen += 1               # abandon a load in progress
        self.warm_status = "restarting: freeing GPU memory"
        self.write_status(time.monotonic())
        before = gpu_used(memory_readings())
        self.ollama.stop()
        after = wait_vram_settled(10, self.stop_evt)
        self.report_vram(before, after)
        if self.stop_evt.is_set() or PAUSE_FILE.exists() or \
                self.confirm_wine(scan_games(self.cfg), time.monotonic()):
            return                       # the next pass turns this into "gaming"/"paused"
        self.go_on("starting Ollama again with the GPU memory cleared")
        if self.warming:
            self.restart_gen = self.warm_gen

    def report_vram(self, before, after, quiet=False):
        if after is None:
            self.vram_report = ""
            return
        others = vram_holders()
        freed = f"freed {size_text(before - after)}; " if before and before > after else ""
        self.vram_report = (f"{size_text(after)} of GPU memory still in use"
                            + (f" ({holders_text(others)})" if others else ""))
        if not quiet:
            self.event(f"{freed}{self.vram_report}")

    def out_of_memory(self, gen, model, detail):
        if gen != self.warm_gen:
            return
        if not self.oom_retried:
            self.oom_retried = True
            self.warm_status = "out of GPU memory; restarting Ollama to clear it"
            self.event(f"{model} didn't fit in GPU memory ({detail[:160]}); restarting Ollama "
                       "to clear it and trying once more", "warn")
            if self.request_restart("automatic restart after running out of GPU memory"):
                return
            # A restart is already under way or queued; this load still has to end.
        ctx = int(self.cfg["context_length"])
        self.report_vram(None, gpu_used(memory_readings()), quiet=True)
        where = f" {self.vram_report}." if self.vram_report else ""
        self._fail(gen, f"failed: not enough GPU memory for {model} at context {ctx}.{where} "
                        f"Close whatever is using it, or try a smaller context: "
                        f"gpu-yield config context_length {max(8192, ctx // 2)}")

    def start_warm(self):
        self.warm_gen += 1
        self.warm_failed_at = None
        self.low_memory_at = None
        self.warming = True
        threading.Thread(target=self._warm, args=(self.warm_gen,), name="warmup",
                         daemon=True).start()

    def _warm(self, gen):
        self.warming = True
        try:
            self._warm_inner(gen)
        finally:
            if gen == self.warm_gen:
                self.warming = False

    def _fail(self, gen, status, retry=300):
        if gen == self.warm_gen:
            self.warm_status = status
            self.warm_failed_at = time.monotonic()
            self.warm_retry = retry
            self.event(status)

    def _warm_inner(self, gen):
        model = self.cfg["model"]
        self.warm_status = "starting Ollama"
        if not self.ollama.wait_ready(90, self.stop_evt):
            return self._fail(gen, "failed: Ollama did not answer within 90s")
        if gen != self.warm_gen:
            return
        self.warm_status = f"loading {model}"
        t = time.monotonic()
        target = model
        try:
            self.alias_problem = ""
            alias = self.cfg["alias"]
            tags = self.ollama.request("/api/tags", timeout=10).get("models", [])
            if guards_shared_fit(self.cfg):
                # Shared memory: check the file against the pool before anything else,
                # including pointing the apps' fixed name at it (an app using that name
                # would load it). Running the pool out freezes the whole board.
                size = next((m.get("size") for m in tags if same_model(tag_name(m), model)), None)
                budget = shared_budget()
                if size and budget and size > budget:
                    return self.refuse_spill(gen, model, model, None, why=(
                        f"{model} ({size_text(size)}) is too big for this PC's shared memory: "
                        f"models up to about {size_text(budget)} leave Linux and the model's "
                        "context enough room, and running out freezes the whole board"),
                        advice="Choose a smaller model or a smaller build of it")
            self.forget_old_alias(tags, alias)
            if alias:
                # Point the fixed name at this model and load it under that name, so apps
                # using it get the loaded model with no reload. Copies share the files.
                if not any(same_model(tag_name(m), model) for m in tags):
                    raise urllib.error.HTTPError(self.ollama.base, 404, "not found", None, None)
                existing = next((m for m in tags if same_model(tag_name(m), alias)), None)
                rec = alias_record()
                if existing and not (same_model(rec.get("name", ""), alias)
                                     and alias_owns(rec, existing.get("digest"))):
                    # A model with this name that gpu-yield didn't make: never overwrite it.
                    self.alias_problem = (f"a model named {alias} already exists, so gpu-yield "
                                          f"won't overwrite it. Choose another fixed name: "
                                          f"gpu-yield config alias SOMETHING-ELSE")
                    self.event(self.alias_problem, "error")
                else:
                    try:
                        # A copy has its source's digest. Record it first, keeping the old
                        # one too, so an interruption at any point leaves the name ours.
                        source = next(m for m in tags if same_model(tag_name(m), model))
                        save_alias_record(alias, source.get("digest"),
                                          *(existing.get("digest"),) if existing else ())
                        self.ollama.request("/api/copy", {"source": model, "destination": alias},
                                            timeout=60)
                        save_alias_record(alias, source.get("digest"))
                        target = alias
                    except urllib.error.HTTPError as e:
                        if e.code == 404:
                            raise
                        self.alias_problem = (f"couldn't point {alias} at {model} "
                                              f"({http_error_detail(e)}); apps using {alias} may "
                                              f"get an older model")
                        self.event(self.alias_problem, "error")
            self.loaded_name = target
            self.ollama.warm(target)
        except urllib.error.HTTPError as e:
            if e.code == 404:   # not downloaded (yet): check again soon, it may be mid-pull
                return self._fail(gen, f"failed: {model} is not downloaded "
                                       f"(run: gpu-yield model {model})", retry=30)
            detail = http_error_detail(e)
            if self.ram_stop(gen):
                return
            if OOM_RE.search(detail):
                return self.out_of_memory(gen, model, detail)
            return self._fail(gen, f"failed: {detail}")
        except Exception as e:
            if self.ram_stop(gen):
                return
            return self._fail(gen, f"failed: {e}")
        if gen != self.warm_gen:
            return
        loaded = self.ollama.loaded()
        share = gpu_share(loaded)
        if guards_gpu_fit(self.cfg) and spilled(loaded):
            return self.refuse_spill(gen, model, target, share)
        shared = guards_shared_fit(self.cfg)
        if shared:
            left = mem_available()
            if left is not None and left < SHARED_MIN_FREE:
                return self.refuse_spill(gen, model, target, share, why=(
                    f"{model} at context {self.cfg['context_length']} left only "
                    f"{size_text(left)} of memory for the rest of the PC, so it was unloaded: "
                    "on a shared-memory board, running out freezes everything"))
        if fits(loaded):
            save_fit(model, self.cfg["context_length"])
        # Our own load only: an app's queued request may already have reloaded it differently.
        ctx = int(self.cfg["context_length"])
        mine = [m for m in loaded or [] if same_model(m.get("name") or m.get("model") or "", target)
                and (not m.get("context_length") or int(m["context_length"]) == ctx)]
        if mine and mine[0].get("size"):
            self.own_load = (model, ctx, mine[0]["size"], self.load_key())
        where = f", {share}% on GPU" if share is not None else ""
        named = f" as {target}" if target != model else ""
        self.warm_status = f"ready ({model}{named}{where})"
        self.warm_failed_at = None
        self.oom_retried = False
        self.event(f"{model} loaded{named} in {time.monotonic() - t:.1f}s{where}")
        problem, note = placement_note(self.ollama, model, share)
        if note and shared_memory_gpu() and share:
            # Shared memory: the model being in system memory is normal, but layers that
            # Ollama put on the CPU still make it several times slower.
            note = (f"{100 - share}% of {model} runs on the CPU, because Ollama sees less GPU "
                    "memory than the board has. It will be slow; gpu-yield doctor checks the "
                    "GPU memory limit (ttm.pages_limit)")
        if note:
            self.event(note, "error" if problem else "warn")

    def refuse_spill(self, gen, model, target, share, why=None, advice=None):
        """Unload a model that didn't fit in VRAM (ROCm) and go back to the last model and
        context that did, or wait and retry if there isn't one."""
        try:
            self.ollama.request("/api/generate", {"model": target, "keep_alive": 0}, timeout=60)
        except Exception:
            self.ollama.stop()            # it must not stay loaded either way
        if gen != self.warm_gen:
            return
        ctx = int(self.cfg["context_length"])
        why = why or (f"{model} at context {ctx} loaded only {share}% in GPU memory, so it was "
                      "unloaded: on ROCm, running part of a model from system RAM has stalled "
                      "the graphics driver and shut down a PC")
        prev = last_fit()
        try:
            installed = [tag_name(m) for m in self.ollama.request("/api/tags", timeout=10)
                         .get("models", [])]
        except Exception:
            installed = []
        back = {}
        if prev.get("model") and not same_model(prev["model"], model):
            back["model"] = prev["model"]
        if prev.get("context_length") and int(prev["context_length"]) != ctx:
            back["context_length"] = int(prev["context_length"])
        with self.model_lock:
            usable = back and any(same_model(prev["model"], m) for m in installed) and \
                not any(same_model(prev["model"], d) for d in self.deleting)
            if usable:
                self.event(f"{why}. Going back to {prev['model']} at context "
                           f"{prev['context_length']}, which fit.", "error")
                self.warm_status = "didn't fit in GPU memory; going back to the last model that did"
                self.change_source = "gpu-yield, going back to the last model that fit"
                for key, value in back.items():
                    self.actions.put(({"model": "model", "context_length": "context"}[key], value))
                return
        self.report_vram(None, gpu_used(memory_readings()), quiet=True)
        where = f" {self.vram_report}." if self.vram_report else ""
        self._fail(gen, f"failed: {why}.{where} " + (advice or (
            f"Free some GPU memory, choose a smaller model, or lower context_length "
            f"(gpu-yield config context_length {max(8192, ctx // 2)})")), retry=300)

    def note_ollama_exit(self):
        """Ollama (or the program running the model) ended unexpectedly: say if Linux
        stopped it for going over its RAM limit. "" if not, "once", or "repeated" if it
        keeps happening (twice in 10 minutes)."""
        since, self.oom_checked = self.oom_checked, time.time()
        if not oom_killed_since(self.cfg["ollama_unit"], since - 5):
            return ""
        limit = effective_ram_limit(self.cfg)
        self.oom_kills.append(time.monotonic())
        if limit:
            self.event(f"Ollama went over its RAM limit ({size_text(limit)}) and Linux stopped "
                       "it; the rest of the PC wasn't affected", "error")
        else:
            self.event("the PC ran out of memory and Linux stopped Ollama, first in line as "
                       f"set up; using memory: {memory_users()}", "error")
        recent = [t for t in self.oom_kills if time.monotonic() - t < 600]
        return "repeated" if len(recent) >= 2 else "once"

    def ram_stop(self, gen):
        """After a failed load: if Linux stopped Ollama for its RAM limit, handle it here
        (retry once later; give up if it repeats). True if it was that."""
        seen = self.note_ollama_exit()
        if seen == "repeated":
            self.give_up_on_ram(gen)
        elif seen == "once":
            what = ("went over its RAM limit" if effective_ram_limit(self.cfg)
                    else "was stopped by Linux for lack of memory")
            self._fail(gen, f"failed: Ollama {what} while loading "
                            f"{self.cfg['model']}; trying once more in 5 minutes", retry=300)
        return bool(seen)

    def give_up_on_ram(self, gen=None):
        """Stop reloading a model that keeps going over Ollama's RAM limit."""
        if gen is not None and gen != self.warm_gen:
            return
        self.warm_gen += 1
        self.warming = False             # this ends the load cycle; health checks resume
        what = ("keeps going over Ollama's RAM limit (see ollama_ram_limit)"
                if effective_ram_limit(self.cfg) else
                "keeps running the PC out of memory, so Linux keeps stopping Ollama")
        self.warm_status = (f"failed: {self.cfg['model']} {what}; not loading it again until "
                            "you change the model or context, or run gpu-yield restart")
        self.warm_failed_at, self.warm_retry = time.monotonic(), 10**9
        self.event(self.warm_status)

    def update_message(self, now):
        cd = int(self.cfg["cooldown_seconds"])
        if self.state == "gaming":
            self.standin.message = (f"The AI server on {self.host} is paused because a game is "
                                    f"running. It comes back automatically about {cd}s after "
                                    "the game closes.")
            self.standin.retry_after = 120
        elif self.state == "cooldown":
            left = max(0, int(self.cooldown_until - now))
            self.standin.message = (f"A game just closed on {self.host}. The AI server resumes "
                                    f"in about {left}s, plus model loading time.")
            self.standin.retry_after = left + 30
        elif self.state == "paused":
            self.standin.message = self.block_reason or (
                f"The AI server on {self.host} was paused manually (gpu-yield pause).")
            self.standin.retry_after = 600

    # --- main loop
    def step(self, games, paused, slept, now):
        self.games = sorted(set(games.values()))
        if paused:
            if self.state != "paused":
                self.go_off("paused", "paused manually")
        elif games:
            if self.state != "gaming":
                self.go_off("gaming", "game started: " + ", ".join(self.games))
        elif self.state == "gaming":
            self.set_state("cooldown")
            self.cooldown_until = now + float(self.cfg["cooldown_seconds"])
            self.event(f"game closed; reloading the model in {self.cfg['cooldown_seconds']}s "
                "unless another game starts")
        elif self.state == "cooldown":
            if now >= self.cooldown_until:
                self.go_on("cooldown over; starting Ollama")
        elif self.state is None:
            self.go_on("no game running; starting Ollama")
        elif self.state == "paused":
            self.block_reason = ""
            self.client_spills.clear()
            self.go_on("resumed; starting Ollama")
        elif self.state == "ai":
            if slept and self.cfg["restart_after_suspend"]:
                self.oom_retried, self.vram_report = False, ""
                self.ollama.stop()
                self.go_on("woke from sleep; restarting Ollama")
            else:
                self.health(now)
        if self.state in self.OFF_STATES:
            self.update_message(now)

    def health(self, now):
        """Every 15 s while the AI is on: is Ollama alive, answering, and holding our model?"""
        if now - self.last_health < 15:
            return
        self.last_health = now
        # A fresh start gets as long as the warmup waits for it (90 s) before silence counts.
        settling = now - self.last_restart < 120
        if not self.ollama.active():
            if now - self.last_restart >= 30:
                self.note_ollama_exit()
                self.go_on("Ollama is not running; restarting it")
            return
        if not self.ollama.ready():
            if settling:
                return
            self.ping_failures += 1
            if self.ping_failures >= 3:
                self.ollama.stop()
                self.go_on("Ollama stopped answering for 45s; restarting it")
            return
        self.ping_failures = 0
        models = None
        if guards_gpu_fit(self.cfg) and not self.warming:
            # Whatever else is going on (a failed or retrying load included), a model that
            # doesn't fit must not stay loaded: an app may have loaded one meanwhile.
            models = self.ollama.loaded()
            if spilled(models):
                self.unload_spilled(models)
                return
        if guards_shared_fit(self.cfg) and not self.warming:    # an APU on ROCm gets both
            if models is None:
                models = self.ollama.loaded()
            left = mem_available()
            if models and left is not None and left < SHARED_MIN_FREE:
                # One reading can be a passing moment, such as during a load: act on two
                # in a row (this check and the previous one, 15 s apart), or at once if
                # memory is critically low.
                prev, self.low_memory_at = self.low_memory_at, now
                if (prev is not None and now - prev <= 40) or left < SHARED_MIN_FREE // 2:
                    self.low_memory_at = None
                    self.shared_memory_low(models, left)
                    return
            else:
                self.low_memory_at = None
        if self.warming or not self.cfg["model"]:
            return
        if self.warm_failed_at is not None:
            if now - self.warm_failed_at > self.warm_retry:
                self.start_warm()
            return
        if models is None:
            models = self.ollama.loaded()
        if models is None:
            return
        self.check_loaded(models)

    def given_up(self):
        """True after gpu-yield stopped reloading its model for running out of memory."""
        return self.warm_failed_at is not None and self.warm_retry >= 10**9

    def own_size(self):
        """Bytes gpu-yield's own model took at its last successful load, if that load was of
        the current model and context; else None."""
        rec = self.own_load
        if rec and rec[0] == self.cfg["model"] and rec[1] == int(self.cfg["context_length"]) \
                and rec[3] == self.load_key():
            return rec[2]
        return None

    def load_key(self):
        """What else decides a load's size: Ollama's settings (context storage and so on)."""
        return json.dumps(self.cfg["ollama_env"], sort_keys=True)

    def bigger_than_ours(self, m):
        """True if an app's load uses more memory than gpu-yield's own model and context,
        the setup that already passed the memory check; False if it uses no more, so it
        can't be the cause; None if there's nothing to compare with."""
        model, ctx = self.cfg["model"], int(self.cfg["context_length"])
        ours = [n for n in (model, self.cfg["alias"]) if n]
        is_ours = any(same_model(m.get("name") or m.get("model") or "", n) for n in ours)
        got = int(m["context_length"]) if m.get("context_length") else None
        if is_ours and got in (None, ctx):
            return False                                # gpu-yield's own load
        size, own = m.get("size"), self.own_size()
        if own and size:
            return size > own * 1.02                    # Ollama's figures wobble a little
        if is_ours and got is not None:
            return got > ctx                            # our model, at a larger or smaller context
        pool = shared_pool()
        if size and pool and size > pool - SHARED_MIN_FREE:
            return True                                 # more than the whole board can hold
        return None

    def shared_memory_low(self, models, left):
        """Shared-memory chip, and the rest of the PC is nearly out of memory with a model
        loaded. An app's load that needs more memory than gpu-yield's own setup is handled
        like a model that doesn't fit (unloaded; the AI paused if it keeps happening).
        Otherwise something else used the memory: unload the model to keep the board
        alive, say what's using memory, and retry in 5 minutes. No pause, no blame."""
        model, ctx = self.cfg["model"], int(self.cfg["context_length"])
        hogs = memory_users()
        verdicts = [(m, self.bigger_than_ours(m)) for m in models]
        bigger = [m for m, v in verdicts if v]
        if bigger:
            return self.unload_spilled(models, bigger, why=(
                f"left the rest of the PC only {size_text(left)} of memory ({hogs})"))
        for m in models:
            try:
                self.ollama.request("/api/generate", {"model": m.get("name"), "keep_alive": 0},
                                    timeout=60)
            except Exception:
                pass
        ours = [n for n in (model, self.cfg["alias"]) if n]
        apps = [m for m in models
                if not any(same_model(m.get("name") or m.get("model") or "", n) for n in ours)
                or (m.get("context_length") and int(m["context_length"]) != ctx)]
        unsure = [m for m, v in verdicts if v is None and m in apps]
        app = unsure[0] if unsure else apps[0] if apps else None
        whose = ((f"{app.get('name')} at context {app.get('context_length', '?')}, loaded by an "
                  "app, may be the cause: there's no load of gpu-yield's own model to compare "
                  "it with. ") if unsure else
                 (f"{app.get('name')} at context {app.get('context_length', '?')}, loaded by an "
                  "app, uses no more memory than gpu-yield's own setup, so it isn't the "
                  "cause. ")) if app else ""
        if self.given_up():              # stay given up: say what happened, don't reschedule
            self.event(f"only {size_text(left)} of memory was left for the rest of the PC, so "
                       f"the loaded model was unloaded. Using memory: {hogs}", "error")
            return
        self.warm_gen += 1
        self.warm_status = (f"failed: only {size_text(left)} of memory was left for the rest of "
                            f"the PC, so the model was unloaded to keep the board from freezing. "
                            f"{whose}Using memory: {hogs}. Trying again in 5 minutes")
        self.warm_failed_at, self.warm_retry = time.monotonic(), 300
        self.event(self.warm_status, "error")

    def unload_spilled(self, models, offenders=None, why=None):
        """An app loaded a model, or a context, that doesn't fit in VRAM. Ollama only
        unloads it once the app's current request finishes, so it can't be stopped from
        running once; if the same thing is loaded again, the AI is paused instead, with
        the reason, until the app is fixed and you resume."""
        model, ctx = self.cfg["model"], int(self.cfg["context_length"])
        now = time.monotonic()
        repeat = []
        for m in offenders if offenders is not None else spilled(models):
            name = m.get("name") or m.get("model") or "?"
            key = (name, m.get("context_length"))
            times = [t for t in self.client_spills.get(key, []) if now - t < 3600] + [now]
            self.client_spills[key] = times[-5:]
            if len(times) >= 2:
                repeat.append(m)
            try:
                self.ollama.request("/api/generate", {"model": name, "keep_alive": 0}, timeout=60)
            except Exception:
                pass
            what = why or (f"didn't fit in GPU memory ({100 - gpu_share([m])}% was outside it); "
                           "unloaded it, since on ROCm that has shut down this PC")
            if why:
                what += "; unloaded it, since running out of memory freezes this board"
            self.event(f"an app loaded {name} at context {m.get('context_length', '?')}, and it "
                       f"{what}. Set the app to use {self.cfg['alias'] or model} at context {ctx}",
                       "error")
        if repeat:
            m = repeat[0]
            needs = (f"needs more memory than gpu-yield's own setup and leaves this board too "
                     f"little" if why else "doesn't fit in GPU memory")
            remote = (f", or press Resume on http://{self.host}:{self.cfg['status_port']}/"
                      if self.cfg["control_password"] and page_port(self.cfg) else "")
            self.block_reason = (f"The AI on {self.host} is paused: an app keeps loading "
                                 f"{m.get('name')} at context {m.get('context_length', '?')}, which "
                                 f"{needs}. Set the app to use {self.cfg['alias'] or model} at "
                                 f"context {ctx}, or leave its context unset, then resume: "
                                 f"gpu-yield resume on {self.host}{remote}.")
            self.event("paused the AI: " + self.block_reason, "error")
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            PAUSE_FILE.touch()            # step() turns this into a pause on the next pass
            return
        if not self.given_up():
            self.start_warm()

    def check_loaded(self, models):
        model, ctx = self.cfg["model"], int(self.cfg["context_length"])
        if not models:
            # Twice in a row, so a client briefly reloading the model isn't mistaken for
            # an empty server. Covers Ollama restarting itself after a crash, too.
            self.empty_checks += 1
            if self.empty_checks >= 2:
                self.empty_checks = 0
                if self.note_ollama_exit() == "repeated":
                    self.give_up_on_ram()
                    return
                self.event(f"{model} is no longer loaded; loading it again")
                self.start_warm()
            return
        if guards_gpu_fit(self.cfg) and spilled(models):
            self.unload_spilled(models)
            return
        self.empty_checks = 0
        trusted_alias = self.loaded_name if self.loaded_name and self.cfg["alias"] and \
            same_model(self.loaded_name, self.cfg["alias"]) else None
        ours = [n for n in (model, trusted_alias) if n]
        mine = [m for m in models
                if any(same_model(m.get("name") or m.get("model", ""), n) for n in ours)]
        if not mine:
            other = ", ".join(sorted(m.get("name", "?") for m in models))
            use = self.cfg["alias"] or model
            self.notice = (f"a client loaded {other} instead of {model}. Set your app's model "
                           f"to {use}, or switch with: gpu-yield model {other}")
            self.warn_once(("model", other), self.notice)
            return
        got = mine[0].get("context_length")
        if got and int(got) != ctx:
            self.notice = (f"a client reloaded {model} with context {got} instead of {ctx}. "
                           f"Set Hermes's context_length and ollama_num_ctx to {ctx}")
            self.warn_once(("ctx", got), self.notice)
            return
        self.notice = self.alias_problem
        self.warned.clear()

    def event(self, text, kind=None):
        """Log, and remember for the "Recent events" list on the page and in status.
        A repeat of the newest event is folded into it ("×N"), so a retry loop can't push
        everything else out of the list."""
        log(text)
        if kind is None:
            low = text.lower()
            kind = "error" if re.search(r"\b(failed|couldn't|error|not answering|stopped answering)\b", low) \
                else "warn" if low.startswith("note:") else "info"
        if self.events and self.events[0].get("text") == text:
            self.events[0]["at"] = time.time()
            self.events[0]["count"] = self.events[0].get("count", 1) + 1
            return
        self.events.appendleft({"at": time.time(), "text": text, "kind": kind})

    def forget_old_alias(self, tags, current):
        """If the fixed name was renamed or turned off, delete the old copy gpu-yield made,
        so it doesn't keep an old model's files on disk."""
        rec = alias_record()
        old = rec.get("name")
        if not old or (current and same_model(old, current)):
            return
        entry = next((m for m in tags if same_model(tag_name(m), old)), None)
        if entry and alias_owns(rec, entry.get("digest")):
            try:
                self.ollama.request("/api/delete", {"model": old}, method="DELETE", timeout=30)
                self.event(f"removed the old fixed name {old}")
            except Exception:
                return
        ALIAS_FILE.unlink(missing_ok=True)

    def warn_once(self, key, msg):
        if key not in self.warned:
            self.warned.add(key)
            self.event("note: " + msg)

    # --- controls from the status page. Handlers run on the page's threads; anything
    # that changes the config or Ollama is queued and applied by the main loop.
    MAX_FAILURES = 10           # wrong passwords per device before it's locked out
    LOCK_SECONDS = 60           # first lockout; doubles each time, up to MAX_LOCK
    MAX_LOCK = 3600
    NETWORK_FAILURES = 100      # wrong passwords from all devices in 10 minutes before
    NETWORK_LOCK = 600          # new devices are refused for this long

    def api(self, action, data, password, client="local"):
        secret = self.cfg["control_password"]
        if not secret:
            return 403, {"error": "Controls are off. Turn them on with: "
                                  "gpu-yield config control_password -"}
        # Counted per device: one device guessing can't lock the owner out of their own
        # page, and each lockout of the same device lasts twice as long as the last.
        with self.auth_lock:
            now = time.monotonic()
            rec = self.failures.get(client)
            if rec and rec["until"] > now:
                return 429, {"error": f"Too many wrong passwords from this device. Try again "
                                      f"in {int(rec['until'] - now) + 1} s."}
            # Many devices (or one using many addresses) guessing together: refuse devices
            # that haven't given the right password lately, so the owner's still work.
            recent = [t for t in self.recent_failures if now - t < 600]
            trusted = now - self.trusted.get(client, -1e9) < 86400
            if len(recent) >= self.NETWORK_FAILURES and not trusted:
                wait = int(recent[-self.NETWORK_FAILURES] + self.NETWORK_LOCK - now) + 1
                if wait > 0:
                    if now - self.lock_event_at > 600:
                        self.lock_event_at = now
                        self.event("status page: many wrong control passwords from several "
                                   "devices; devices that haven't signed in lately are refused "
                                   f"for {ago(self.NETWORK_LOCK)}", "warn")
                    return 429, {"error": "Too many wrong passwords on this network lately. "
                                          f"Try again in {wait} s."}
            if not hmac.compare_digest(str(password).encode(), secret.encode()):
                self.recent_failures.append(now)
                if client not in self.failures and len(self.failures) >= 1000:
                    # Bounded, whatever the network does: forget the oldest records that
                    # aren't locked out now. Never forget an active lockout.
                    idle = sorted((r["last"], ip) for ip, r in self.failures.items()
                                  if r["until"] <= now)
                    for _, ip in idle[:max(1, len(idle) // 4)]:
                        del self.failures[ip]
                    if len(self.failures) >= 1000:
                        return 429, {"error": "Too many devices are guessing the password. "
                                              "Try again later."}
                rec = self.failures.setdefault(client, {"count": 0, "locks": 0, "until": 0.0,
                                                        "last": now})
                if now - rec["last"] > 600:          # an occasional typo doesn't add up
                    rec["count"] = 0
                rec["count"] += 1
                rec["last"] = now
                if rec["count"] >= self.MAX_FAILURES:
                    lock = min(self.MAX_LOCK, self.LOCK_SECONDS * 2 ** rec["locks"])
                    rec.update(count=0, locks=rec["locks"] + 1, until=now + lock)
                    if now - self.lock_event_at > 600:   # many devices can't flood the events
                        self.lock_event_at = now
                        self.event(f"status page: too many wrong control passwords from "
                                   f"{client}; that device is locked out for {ago(lock)}")
                return 403, {"error": "Wrong password"}
            self.failures.pop(client, None)
            self.trusted[client] = now
            if len(self.trusted) > 32:
                del self.trusted[min(self.trusted, key=self.trusted.get)]
        handler = getattr(self, "_api_" + action.replace("-", "_"), None) \
            if re.fullmatch(r"[a-z_-]+", action) else None
        if handler is None:
            return 404, {"error": f"unknown action {action!r}"}
        try:
            return handler(data)
        except ValueError as e:
            return 400, {"error": str(e)}
        except Exception as e:      # a bad request must get an answer, not a dropped connection
            self.event(f"status page: {action} failed: {e!r}")
            return 500, {"error": f"{action} failed: {e}"}

    def _api_auth(self, data):
        return 200, {"message": "Unlocked"}

    def _api_pause(self, data):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if data.get("paused"):
            PAUSE_FILE.touch()
            return 200, {"message": "Paused. The AI stays off until you resume it."}
        PAUSE_FILE.unlink(missing_ok=True)
        return 200, {"message": "Resumed. The model loads in a moment if no game is running."}

    def _api_restart(self, data):
        if self.state != "ai":
            return 409, {"error": "The AI is off right now (a game is running or it's paused); "
                                  "it loads fresh when it comes back."}
        if self.transfers_running():
            return 409, {"error": "A download or speed test is running; restarting would cut it "
                                  "off. Try again when it's done."}
        if not self.request_restart("restart requested from the status page"):
            return 409, {"error": "Already restarting."}
        return 202, {"message": "Restarting: unloading the model, freeing GPU memory and "
                                "loading it again. Recent events show what's left on the GPU."}

    def _api_model(self, data):
        name = normalize_model_name(data.get("name"))
        if self.cfg["alias"] and same_model(name, self.cfg["alias"]):
            raise ValueError(f"{name} is the fixed name; pick the model it should point at")
        listing = self.api_models()
        installed = [m["name"] for m in listing["models"]]
        if not installed and not listing["available"]:
            return 409, {"error": "Can't check which models are downloaded while the AI is off. "
                                  "Try again when it's running."}
        if not any(same_model(name, m) for m in installed):
            raise ValueError(f"{name} isn't downloaded yet; download it first")
        name = next((m for m in installed if same_model(name, m)), name)
        with self.model_lock:
            if any(same_model(name, d) for d in self.deleting):
                return 409, {"error": f"{name} is being deleted"}
            self.actions.put(("model", name))
        when = "" if self.state == "ai" else " It loads when the AI is back on."
        apps = f"Apps using {self.cfg['alias']} follow automatically." if self.cfg["alias"] \
            else f"Set your AI apps to use {name} too."
        return 202, {"message": f"Switching to {name}. {apps}{when}"}

    def _api_context(self, data):
        n = data.get("context_length")
        if isinstance(n, bool) or not isinstance(n, (int, float)) or n != n or n in (float("inf"), float("-inf")):
            raise ValueError("context_length must be a number")
        n = int(n)
        if not 2048 <= n <= 1_048_576:
            raise ValueError("context_length must be between 2048 and 1048576")
        self.actions.put(("context", n))
        return 202, {"message": f"Context set to {n}; the model reloads. "
                              f"Set your AI apps to {n} too."}

    def _api_pull(self, data):
        name = normalize_model_name(data.get("name"))
        if self.state != "ai" or not self.ollama.ready():
            return 409, {"error": "Downloads need the AI running. Try again when no game is "
                                  "running and the AI isn't paused."}
        with self.dl_lock:
            job = self.downloads.get(name)
            if job and job["state"] == "running":
                return 409, {"error": f"{name} is already downloading"}
            if sum(j["state"] == "running" for j in self.downloads.values()) >= 3:
                return 409, {"error": "Three downloads are already running; wait for one to finish"}
            self.downloads[name] = {"name": name, "state": "running", "status": "starting",
                                    "completed": 0, "total": 0, "error": "",
                                    "use": bool(data.get("use")), "cancel": False, "finished": None}
        threading.Thread(target=self._pull, args=(name,), name="download", daemon=True).start()
        return 202, {"message": f"Downloading {name}"}

    def _api_speed(self, data):
        if self.state != "ai" or self.warming or not self.warm_status.startswith("ready"):
            return 409, {"error": "The speed test needs the model loaded and no game running."}
        recently = self.last_used and time.time() - self.last_used < 120
        if (self.in_use or recently) and not data.get("force"):
            return 409, {"busy": True,
                         "error": "The AI is in use. A speed test makes waiting requests queue "
                                  "behind it and clears the conversation Ollama has cached, so "
                                  "the next long request starts over."}
        with self.dl_lock:
            if self.speed["state"] == "running":
                return 409, {"error": "A speed test is already running"}
            self.speed = {"state": "running", "error": "", "result": None, "model": self.cfg["model"]}
        threading.Thread(target=self._speed, name="speed-test", daemon=True).start()
        return 202, {"message": f"Testing {self.cfg['model']}: reading about 2,000 tokens, "
                                f"then writing 128"}

    def _speed(self):
        model = self.cfg["model"]
        try:
            res = speed_test(self.ollama, self.loaded_name or model, self.cfg["context_length"],
                             label=model)
            save_speed_result(res)
            self.speed = {"state": "done", "error": "", "result": res, "model": model}
            self.event(f"speed test of {model}: reading {res['read_tps']} tokens/s, "
                       f"writing {res['write_tps']} tokens/s")
        except Exception as e:
            if self.state != "ai":
                err = "a game started, which stops the AI"
            elif isinstance(e, urllib.error.HTTPError):
                err = http_error_detail(e)
            else:
                err = str(e) or e.__class__.__name__
            self.speed = {"state": "failed", "error": err, "result": None, "model": model}
            self.event(f"speed test of {model} failed: {err}")

    def current_speed_results(self):
        try:
            mtime = SPEED_FILE.stat().st_mtime
        except OSError:
            mtime = None
        if mtime != self.speed_mtime:
            self.speed_mtime = mtime
            self.speed_results = load_speed_results()
        return self.speed_results

    def _api_cancel(self, data):
        with self.dl_lock:
            job = self.downloads.get(normalize_model_name(data.get("name")))
        if not job or job["state"] != "running":
            return 404, {"error": "no such download in progress"}
        job["cancel"] = True
        return 200, {"message": "Cancelling"}

    def _api_delete(self, data):
        name = normalize_model_name(data.get("name"))
        if self.cfg["alias"] and same_model(name, self.cfg["alias"]):
            return 409, {"error": f"{name} is the fixed name for your apps, not a separate "
                                  "model; it takes no extra space"}
        if self.state != "ai" or not self.ollama.ready():
            return 409, {"error": "Deleting needs the AI running. Try again when no game is "
                                  "running and the AI isn't paused."}
        # Everything that can make a model the one in use takes model_lock, so checked
        # together under it nothing can slip in between the check and the delete.
        with self.model_lock:
            with self.actions.mutex:
                queued = [v for k, v in self.actions.queue if k == "model"]
            in_use = [self.cfg["model"], self.switching_to, *queued,
                      *(j["name"] for j in list(self.downloads.values())
                        if j["use"] and j["state"] == "running")]
            if same_model(name, self.cfg["model"]):
                return 409, {"error": "That's the model in use. Switch to another one first."}
            if any(m and same_model(name, m) for m in in_use):
                return 409, {"error": f"{name} is about to become the model in use. "
                                      "Switch to another one first."}
            self.deleting.add(name)
        try:
            self.ollama.request("/api/delete", {"model": name}, method="DELETE", timeout=30)
        except urllib.error.HTTPError as e:
            return 400, {"error": http_error_detail(e)}
        except OSError:
            return 409, {"error": "Ollama didn't answer (did a game just start?). Try again later."}
        finally:
            with self.model_lock:
                self.deleting.discard(name)
        self.models_cache["at"] = 0
        self.event(f"deleted {name} (from the status page)")
        return 200, {"message": f"Deleted {name}"}

    def api_models(self):
        """Installed models (cached while Ollama is off), disk space and VRAM, for the page."""
        available = False
        if self.state == "ai" and time.monotonic() - self.models_cache["at"] > 5:
            try:
                tags = self.ollama.request("/api/tags", timeout=3).get("models", [])
                alias = self.cfg["alias"]
                self.models_cache = {"at": time.monotonic(), "models": sorted(
                    ({"name": m.get("name") or m.get("model"), "size": m.get("size", 0)}
                     for m in tags
                     if not (alias and same_model(m.get("name") or m.get("model", ""), alias))),
                    key=lambda m: m["name"])}
                available = True
            except Exception:
                pass
        elif self.state == "ai":
            available = True
        store = models_dir(self.cfg)
        vram = detect_memory()[1]
        if shared_memory_gpu() and shared_budget():
            vram = shared_budget() / 2**30   # what a model file can use on a shared chip
        return {"models": self.models_cache["models"], "available": available,
                "disk_free": models_free_space(store), "models_dir": tilde(store),
                "vram_gb": round(vram, 1) if vram else None, "shared": shared_memory_gpu()}

    def download_list(self):
        now = time.monotonic()
        with self.dl_lock:
            for name, job in list(self.downloads.items()):    # forget finished ones after 10 min
                if job["finished"] and now - job["finished"] > 600:
                    self.downloads.pop(name, None)
            return [{k: v for k, v in job.items() if k not in ("cancel", "finished")}
                    for job in self.downloads.values()]

    def _pull(self, name):
        job = self.downloads[name]
        layers = {}
        try:
            req = urllib.request.Request(self.ollama.base + "/api/pull",
                                         data=json.dumps({"model": name, "stream": True}).encode(),
                                         headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=120) as r:
                for line in r:
                    if job["cancel"]:
                        job["state"] = "cancelled"       # closing the stream stops Ollama's pull
                        self.event(f"download of {name} cancelled")
                        return
                    if not line.strip():
                        continue
                    msg = json.loads(line)
                    if msg.get("error"):
                        raise RuntimeError(msg["error"])
                    job["status"] = msg.get("status", job["status"])
                    if msg.get("digest") and msg.get("total"):
                        layers[msg["digest"]] = (msg.get("completed", 0), msg["total"])
                        job["completed"] = sum(c for c, _ in layers.values())
                        job["total"] = sum(tot for _, tot in layers.values())
            with self.model_lock:        # queued before it stops counting as "running"
                if job["use"]:
                    self.actions.put(("model", name))
                job["state"] = "done"
            self.models_cache["at"] = 0
            self.event(f"downloaded {name} (from the status page)")
        except Exception as e:
            job["state"] = "failed"
            if self.state != "ai":
                job["error"] = "a game started, which stops Ollama; download it again later"
            elif isinstance(e, urllib.error.HTTPError):
                job["error"] = http_error_detail(e)
            else:
                job["error"] = str(e) or e.__class__.__name__
            self.event(f"download of {name} failed: {job['error']}")
        finally:
            job["finished"] = time.monotonic()

    def process_actions(self):
        """Apply what the page asked for, at most one change per pass of the main loop:
        several clicks collapse into their latest values, so the loop gets back to
        checking for games quickly."""
        latest = {}
        with self.model_lock:            # see _api_delete
            while True:
                try:
                    kind, value = self.actions.get_nowait()
                except queue.Empty:
                    break
                latest[{"model": "model", "context": "context_length"}[kind]] = value
            self.switching_to = latest.get("model")
        if latest:
            try:
                self.apply_settings(latest)
            except Exception as e:
                self.event(f"couldn't apply {latest} from the status page: {e!r}")
            finally:
                with self.model_lock:
                    self.switching_to = None

    def apply_settings(self, values):
        """Change only these settings, keeping everything else as the watcher runs it.
        (Reloading the whole file would also pick up hand edits not yet applied.)"""
        new = dict(self.cfg, **values)
        problem = config_problem(new)
        if problem:
            self.event(f"status page: not applied: {problem}")
            return
        if CONFIG_FILE.exists():
            set_config_values(values)
        self.cfg = self.ollama.cfg = new
        self.notice = ""
        self.oom_retried = False         # a new model or context gets its own retry
        self.warned.clear()
        ensure_ollama_unit(new)
        source, self.change_source = self.change_source, "the status page"
        self.event(", ".join(f"{k} set to {v}" for k, v in values.items()) + f" (by {source})")
        if self.state != "ai" or game_running(new):
            return                       # applied when the AI next comes on
        if "context_length" in values:
            self.ollama.stop()           # the context default lives in Ollama's service
            self.go_on("restarting Ollama with the new context")
        else:
            self.start_warm()

    def confirm_wine(self, games, now):
        """Steam games count at once. A Windows program outside Steam has to keep running
        for WINE_CONFIRM_SECONDS first, so a short Wine run doesn't cost a model reload."""
        wine = {pid for pid, label in games.items() if label.endswith(WINE_SUFFIX)}
        if not wine:
            self.wine_since = None
            return games
        if self.state != "ai":       # Ollama is off (game, cooldown, pause, starting up):
            return games             # holding it off costs nothing, so no need to wait
        if self.wine_since is None:
            self.wine_since = now
        if now - self.wine_since >= WINE_CONFIRM_SECONDS:
            return games
        # A Windows program that has already been using the GPU a while counts at once:
        # what's filtered out is short Wine runs, not games running before we looked. Its
        # own age counts, not wineserver's (a Wine prefix can outlive many programs).
        if any(process_age(p) >= WINE_CONFIRM_SECONDS for p in _GPU_EXES):
            return games
        return {pid: label for pid, label in games.items() if pid not in wine}

    def busy(self):
        """Something the update's restart would cut off: a download, a speed test, a load."""
        return self.warming or self.speed["state"] == "running" or \
            any(j["state"] == "running" for j in list(self.downloads.values()))

    def maybe_auto_update(self, _now=None):
        """Once a day (if enabled), install updates while nothing is going on. Timed on the
        boot clock, which keeps counting while the PC sleeps: "a day" means a day."""
        now = time.clock_gettime(time.CLOCK_BOOTTIME)
        mode = self.cfg["auto_update"]
        if mode == "off" or self.updating or now < self.next_update_check:
            return
        idle = self.last_used is None or time.time() - self.last_used > 15 * 60
        if self.state != "ai" or self.in_use or not idle or self.busy():
            self.next_update_check = now + 30 * 60     # busy: look again in half an hour
            return
        self.next_update_check = now + 24 * 3600
        self.updating = True
        threading.Thread(target=self._auto_update, args=(mode,), name="auto-update",
                         daemon=True).start()

    def _auto_update(self, mode):
        try:
            try:
                _, source = fetch_latest(self.cfg)
            except SystemExit:
                self.event("auto-update: couldn't check for a new version; trying again tomorrow")
                return
            todo = []
            latest = declared_version(source) or "0"
            if parse_version(latest) > parse_version(VERSION):
                if auto_update_blocked(latest):
                    self.event(f"auto-update: skipping {latest} (you rolled back from it; "
                        "gpu-yield update installs it anyway)")
                else:
                    todo.append(f"gpu-yield {VERSION} -> {latest}")
            with_ollama = mode == "all" and self.cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT
            if with_ollama:
                have, newest = ollama_versions(self.cfg)
                if have and newest and parse_version(newest) > parse_version(have):
                    todo.append(f"Ollama {have} -> {newest}")
            if not todo:
                return
            # The checks above took a while; make sure nothing started in the meantime.
            if self.state != "ai" or self.in_use or self.busy() or game_running(self.cfg):
                self.next_update_check = time.clock_gettime(time.CLOCK_BOOTTIME) + 30 * 60
                return
            # The update restarts this watcher, so it has to run outside the watcher's
            # own service: a transient unit of its own.
            cmd = ["systemd-run", "--user", "--quiet", "--collect", f"--unit={AUTOUPDATE_UNIT}",
                   sys.executable, str(BIN_PATH), "update", "--if-idle"] \
                + (["--ollama"] if with_ollama else [])
            r = run(cmd)
            if r.returncode:
                self.event(f"auto-update: couldn't start ({r.stderr.strip()})")
            else:
                self.event(f"auto-update: installing {' and '.join(todo)} "
                    f"(log: journalctl --user -u {AUTOUPDATE_UNIT})")
        except Exception as e:
            self.event(f"auto-update: {e!r}")
        finally:
            self.updating = False

    def track_use(self):
        """Note when other machines are talking to Ollama (feeds `last used` and the
        idle check before automatic updates)."""
        self.in_use = self.state == "ai" and client_connections(int(self.cfg["port"])) > 0
        if self.in_use:
            self.last_used = time.time()

    def snapshot(self, now=None, memory=True):
        now = time.monotonic() if now is None else now
        if not self.mac:            # the network may not have been up when we started
            self.mac = nic_info()[1]
        cooldown = max(0, int(self.cooldown_until - now)) if self.state == "cooldown" else None
        ready = self.state == "ai" and self.warm_status.startswith("ready")
        retry = {"gaming": self.standin.retry_after, "paused": self.standin.retry_after,
                 "cooldown": (cooldown or 0) + 30}.get(self.state, 0 if ready else 30)
        return {
            "host": self.host,
            "version": VERSION,
            "state": self.state,
            "state_text": STATE_TEXT.get(self.state, str(self.state)),
            "since": self.since,
            "games": self.games,
            "cooldown_remaining": cooldown,
            "ai_available": ready,
            "retry_after": retry,
            "model": self.cfg["model"],
            "context_length": self.cfg["context_length"],
            "model_status": self.warm_status if self.state == "ai" else "unloaded",
            "notice": self.notice if self.state == "ai" else
                      self.block_reason if self.state == "paused" else "",
            "in_use": self.in_use,
            "last_used": self.last_used,
            "mac": self.mac,
            "port": self.cfg["port"],
            "pid": os.getpid(),
            "paused": PAUSE_FILE.exists(),
            "controls": bool(self.cfg["control_password"]),
            "downloads": self.download_list(),
            "alias": self.cfg["alias"] if self.loaded_name and same_model(
                self.loaded_name, self.cfg["alias"] or "-") else "",
            "loaded_name": self.loaded_name if ready else None,
            "memory": memory_readings() if memory else None,
            "events": list(self.events)[:20],
            "speed": self.speed,
            "speed_results": self.current_speed_results()[:8],
            "restarting": self.restarting(),
            "restart_count": self.restart_count,
        }

    def write_status(self, now):
        status = self.snapshot(now, memory=False)
        # Only write when something changed, plus a heartbeat so `status` can tell a
        # live watcher from a dead one. Memory readings change every poll, so they don't
        # count as a change; they're added when writing anyway.
        if status == self.last_status and now - self.last_status_write < 10:
            return
        self.last_status, self.last_status_write = status, now
        write_status_file(dict(status, memory=memory_readings(), updated=time.time()))

    def run(self):
        if threading.current_thread() is threading.main_thread():
            for sig in (signal.SIGTERM, signal.SIGINT):
                signal.signal(sig, lambda *_: self.stop_evt.set())
            signal.signal(signal.SIGUSR1, lambda *_: setattr(self, "restart_signal", True))
        ensure_ollama_unit(self.cfg)
        # Start from a known state: whatever Ollama was doing, it may carry an old config.
        self.ollama.stop()
        (STATE_DIR / "status.json").unlink(missing_ok=True)   # pre-1.5 location
        previous = read_status() or {}                            # survives watcher restarts
        self.last_used = previous.get("last_used")
        old = previous.get("events")
        self.events.extend(e for e in (old if isinstance(old, list) else [])
                           if isinstance(e, dict) and isinstance(e.get("at"), (int, float))
                           and isinstance(e.get("text"), str))
        self.event(f"gpu-yield {VERSION} watching for games (model {self.cfg['model']}, "
            f"context {self.cfg['context_length']}, cooldown {self.cfg['cooldown_seconds']}s)")
        self.sync_page()
        config_seen = None    # check once on the first pass: the file may have changed
                              # while this watcher was starting
        poll = max(0.5, float(self.cfg["poll_seconds"]))
        mono0, boot0 = time.monotonic(), time.clock_gettime(time.CLOCK_BOOTTIME)
        while not self.stop_evt.is_set():
            mono, boot = time.monotonic(), time.clock_gettime(time.CLOCK_BOOTTIME)
            slept = (boot - boot0) - (mono - mono0) > 15   # monotonic pauses during suspend
            mono0, boot0 = mono, boot
            try:
                games = self.confirm_wine(scan_games(self.cfg), mono)
                self.step(games, PAUSE_FILE.exists(), slept, mono)
                self.track_use()
                self.process_actions()
                why = self.take_restart()
                if why:
                    self.restart_ai(why)
                self.maybe_auto_update(mono)
                config_seen = self.reload_live_settings(config_seen)
            except Exception as e:  # never let one bad loop kill the watcher
                msg = f"watcher error: {e!r}"
                if msg != self.last_error[0] or mono - self.last_error[1] > 300:
                    self.event(msg)    # same error every 2 s would flood the journal
                    self.last_error = (msg, mono)
            try:
                self.write_status(mono)
            except Exception as e:
                self.event(f"couldn't write status: {e!r}")
            # A game ending only starts the cooldown, so while one runs, checking every 5 s
            # costs nothing noticeable and saves the game most of the watcher's work.
            self.stop_evt.wait(max(poll, 5) if self.state == "gaming" else poll)
        self.standin.stop()
        if self.page:
            self.page.stop()
            self.page = None
        self.event("watcher stopped")

    def sync_page(self):
        """Start, stop or move the status page to match the config."""
        port = page_port(self.cfg)
        if self.page and self.page.port == port:
            return
        if self.page:
            self.page.stop()
            self.page = None
            if not port:
                self.event("status page turned off")
        if port:
            page = StatusServer(port, self)
            if page.start():
                self.page = page
                log(f"status page on http://{self.host}:{port}/")

    @staticmethod
    def config_mtime():
        try:
            return CONFIG_FILE.stat().st_mtime_ns
        except OSError:
            return None

    def reload_live_settings(self, seen):
        """Settings that don't need a restart (turning the status page on or off) take
        effect within one poll of the config file changing; the AI keeps running."""
        mtime = self.config_mtime()
        if mtime == seen:
            return seen
        try:
            new = load_config()
        except SystemExit:        # a broken file is reported when the watcher next starts
            return mtime
        changed = {k: new[k] for k in LIVE_SETTINGS if new[k] != self.cfg[k]}
        if changed:
            self.cfg.update(changed)
            self.sync_page()
            if self.page:
                self.event(f"status page on at port {self.page.port}")
        return mtime


# ---------------------------------------------------------------------------- commands

def cmd_run(args):
    cfg = load_config_or_wait()
    if cfg is not None:
        Watcher(cfg).run()


def load_config_or_wait():
    """Load the config. If it's broken, don't crash-loop under systemd: make sure Ollama
    is off (a game may start at any moment), say why, and wait for the file to be fixed."""
    try:
        return load_config()
    except SystemExit:
        pass
    m = re.search(r"^\s*port\s*=\s*(\d+)", _read_text(CONFIG_FILE), re.M)
    port = int(m.group(1)) if m else DEFAULTS["port"]
    user_systemctl("stop", MANAGED_OLLAMA_UNIT)
    u = re.search(r"""^\s*ollama_unit\s*=\s*["']([\w@.:-]+\.service)["']""", _read_text(CONFIG_FILE), re.M)
    if u and u.group(1) != MANAGED_OLLAMA_UNIT:
        user_systemctl("stop", u.group(1))     # your own Ollama must not keep the GPU either
    standin = StandIn(port)
    standin.message = (f"The AI server on {socket.gethostname()} is off: gpu-yield's config "
                       f"file has an error ({CONFIG_FILE}).")
    standin.retry_after = 600
    standin.start()
    log(f"config error; Ollama kept off until {CONFIG_FILE} is fixed")
    stop = threading.Event()
    if threading.current_thread() is threading.main_thread():
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, lambda *_: stop.set())
    seen, since = None, time.time()
    while not stop.is_set():
        try:
            mtime = CONFIG_FILE.stat().st_mtime
        except OSError:
            mtime = None
        if mtime != seen:
            if seen is not None:
                try:
                    cfg = load_config()
                    standin.stop()
                    log("config fixed; starting normally")
                    return cfg
                except SystemExit:
                    pass
            seen = mtime
        write_status_file({"state": "config_error", "since": since, "games": [],
                           "model": "", "model_status": "unloaded", "notice": "",
                           "updated": time.time(), "pid": os.getpid(), "version": VERSION})
        stop.wait(3)
    standin.stop()
    return None


STATE_TEXT = {
    "ai": "AI running (no game)",
    "gaming": "game running, AI stopped",
    "cooldown": "game closed, waiting before reloading the model",
    "paused": "paused manually",
    "config_error": f"AI kept off: the config file has an error (fix {CONFIG_FILE})",
