def drain_body(rfile, headers, limit=64 * 2**20, seconds=120):
    """Read a request body and throw it away as it arrives (nothing is kept), so the
    client can read the reply. Handles Content-Length and chunked bodies; stops at
    `limit` bytes or `seconds`, and the socket's own timeout covers a client that stalls."""
    end, total = time.monotonic() + seconds, 0

    def take(n):
        nonlocal total
        while n > 0 and total < limit and time.monotonic() < end:
            chunk = rfile.read(min(n, 65536))
            if not chunk:
                return False
            n -= len(chunk)
            total += len(chunk)
        return n <= 0

    if "chunked" in headers.get("Transfer-Encoding", "").lower():
        while total < limit and time.monotonic() < end:
            size = int(rfile.readline(1024).split(b";", 1)[0].strip() or b"0", 16)
            if size == 0:
                while rfile.readline(1024).strip():      # trailers, then the blank line
                    pass
                return
            if not take(size + 2):                       # chunk data and its CRLF
                return
        return
    try:
        length = max(0, int(headers.get("Content-Length") or 0))
    except ValueError:
        length = 0
    take(length)


class StandIn:
    """Answers every request with 503 + a reason while Ollama is down.

    /v1/* gets an OpenAI-style error body (what Hermes reads); everything else gets
    Ollama's native {"error": "..."} shape. Retry-After tells clients when to come back.
    """

    def __init__(self, port):
        self.port = port
        self.server = None
        self.message = "AI server is paused."
        self.retry_after = 60

    def start(self):
        if self.server:
            return True
        owner = self

        class Handler(BaseHTTPRequestHandler):
            server_version = APP
            protocol_version = "HTTP/1.1"
            timeout = 5            # don't let idle client connections pin threads

            def log_message(self, *args):
                pass

            def _reply(self):
                # One request per connection: a client that keeps a connection open must
                # not keep talking to the stand-in after the real Ollama is back.
                self.close_connection = True
                # The headers are in: the server's short deadline was for them. A body can
                # take a while over slow Wi-Fi (a long prompt, an image), and the client
                # should still get the 503 and Retry-After, not a cut connection.
                self.server.request_read(self.request)
                try:
                    drain_body(self.rfile, self.headers)
                except (OSError, ValueError):
                    pass
                if self.path.startswith("/v1"):
                    body = {"error": {"message": owner.message, "type": "server_error",
                                      "code": "gpu_busy"}}
                else:
                    body = {"error": owner.message}
                data = json.dumps(body).encode()
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Retry-After", str(int(owner.retry_after)))
                self.send_header("Connection", "close")
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(data)

            do_GET = do_POST = do_PUT = do_DELETE = do_HEAD = do_OPTIONS = do_PATCH = _reply

        last = None
        for _ in range(30):  # the port can take a moment to free up after Ollama exits
            try:
                # The page's server class: a cap on connections overall and per client, and
                # a deadline for each, so nothing on the network can tie up the PC mid-game.
                server = StandInServer(("0.0.0.0", self.port), Handler)
                break
            except OSError as e:
                last = e
                time.sleep(0.5)
        else:
            log(f"stand-in could not bind port {self.port}: {last}")
            return False
        server.daemon_threads = True
        self.server = server
        threading.Thread(target=server.serve_forever, name="stand-in", daemon=True).start()
        return True

    def stop(self):
        if self.server:
            self.server.shutdown()
            self.server.server_close()
            self.server = None


