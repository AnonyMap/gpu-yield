def cmd_status(args):
    if args.host:
        try:
            host, port = split_host(args.host)
        except ValueError as e:
            die(str(e))
        try:
            st = fetch_remote_status(host, port)
        except ValueError:
            die(f"{host}:{port} answered, but it isn't a gpu-yield status page")
        except OSError as e:
            if refused(e):
                die(f"{host} is on, but nothing answers on port {port}: gpu-yield isn't running "
                    "there, or its status page is turned off (on that PC: "
                    "gpu-yield config status_page true)")
            die(f"can't reach {host}:{port} ({getattr(e, 'reason', e)}). If it's asleep, "
                f"wake it with: gpu-yield wake {host_key(host, port)}")
        remember_host(host, port, st)
        if st.get("redacted"):
            # Answered under a name that isn't the PC's own: only the public part.
            state = st.get("state")
            print(f"Host:     {host}, gpu-yield {clean_text(str(st.get('version')))}")
            print(f"AI:       {'ready' if st.get('ai_available') else 'not available'} "
                  f"({clean_text(str(STATE_TEXT.get(state, state)))})")
            print(f"Note:     that PC shares its details only under its own name or IP "
                  f"address. Try its IP, or its own name (like NAME.local).")
            return
        try:
            print(f"Host:     {st.get('host')} ({host}), gpu-yield {st.get('version')}")
            print_status(st)
        except (TypeError, ValueError, AttributeError, KeyError):
            die(f"{host}:{port} sent a status this version can't read")
        return
    active = user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0
    st = read_status()
    print(f"Watcher:  {'running' if active else 'NOT running'}"
          + ("" if active else f"   (start: systemctl --user start {WATCHER_UNIT})"))
    if not st:
        print("No status yet.")
        return
    stale = time.time() - st.get("updated", 0) > 30
    st["memory"] = memory_readings() or st.get("memory")    # same PC: read it fresh
    print_status(st, "   (stale: last update " + ago(time.time() - st['updated']) + " ago)"
                 if stale else "")
    if st.get("version") and st["version"] != VERSION:
        print(f"Version:  watcher runs {st['version']}, this command is {VERSION} "
              f"(apply with: systemctl --user restart {WATCHER_UNIT})")
    if PAUSE_FILE.exists():
        print("Paused:   yes (gpu-yield resume to undo)")


