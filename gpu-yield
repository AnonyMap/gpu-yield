def config_problem(cfg):
    """A human-readable reason the config is invalid, or None."""
    for key, default in DEFAULTS.items():
        value = cfg[key]
        if isinstance(default, bool):
            ok_type = isinstance(value, bool)
        elif isinstance(default, int):
            ok_type = isinstance(value, (int, float)) and not isinstance(value, bool)
        else:
            ok_type = isinstance(value, type(default))
        if not ok_type:
            kind = {bool: "true or false", int: "a number", str: "text in quotes",
                    list: "a list like [\"a\", \"b\"]", dict: "a table"}[type(default)]
            shown = "(the value isn't shown: it's a secret)" if key in SECRET_SETTINGS else repr(value)
            return f"{key} must be {kind}, not {shown}"
        if key in CHOICES and value not in CHOICES[key]:
            return f"{key} must be one of {', '.join(CHOICES[key])}, not {value!r}"
    limits = {"context_length": (512, 10_000_000), "port": (1, 65535), "status_port": (0, 65535),
              "cooldown_seconds": (0, 86400), "poll_seconds": (0.5, 60)}
    for key, (lo, hi) in limits.items():
        if not lo <= cfg[key] <= hi:
            return f"{key} must be between {lo} and {hi}, not {cfg[key]}"
    for key in WHOLE_NUMBERS:
        if isinstance(cfg[key], float) and not cfg[key].is_integer():
            return f"{key} must be a whole number, not {cfg[key]}"
    for k, v in (cfg["ollama_env"] or {}).items():
        # These go into the Ollama service file: a line break would add a line of its own.
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", str(k)):
            return f"ollama_env: {str(k)[:40]!r} isn't a valid environment variable name"
        if re.search(r"[\x00-\x1f\x7f]", str(v)):
            return f"ollama_env: {k} contains a line break or control character"
    if page_port(cfg) == cfg["port"]:
        return "status_port must differ from port"
    if ram_limit_bytes(cfg["ollama_ram_limit"]) is False:
        return (f"ollama_ram_limit must be \"auto\", \"off\" or a size in GB like \"12\", "
                f"not {cfg['ollama_ram_limit']!r}")
    if cfg["alias"] and not (MODEL_NAME_RE.fullmatch(cfg["alias"]) and len(cfg["alias"]) <= 100):
        return f"alias must be a simple model name like \"gpu-yield\", not {cfg['alias']!r}"
    if cfg["alias"] and cfg["model"] and same_model(cfg["alias"], cfg["model"]):
        return "alias must differ from the model's own name"
    return None


def repair_config(cfg, user):
    """Accept what older versions accepted, with a warning, instead of refusing to run:
    an upgrade must never turn a working config into one that keeps the AI off."""
    if isinstance(cfg.get("ollama_ram_limit"), (int, float)) and \
            not isinstance(cfg["ollama_ram_limit"], bool):
        cfg["ollama_ram_limit"] = str(cfg["ollama_ram_limit"])      # `= 12` means "12"
    for key, default in DEFAULTS.items():
        value = cfg[key]
        if isinstance(default, (dict, str)) or type(value) is type(default) \
                or (type(default) is int and type(value) is float):
            continue
        fixed = None
        if isinstance(default, list) and isinstance(value, (str, int, float)):
            fixed = [x.strip() for x in str(value).split(",") if x.strip()]
        elif isinstance(value, str):
            try:
                fixed = parse_setting(key, value)
            except ValueError:
                pass
        if fixed is not None:
            warn(f"config: reading {key} = {value!r} as {fmt_setting(fixed)}")
            cfg[key] = fixed
    if isinstance(cfg["extra_processes"], list):
        cfg["extra_processes"] = [str(x) for x in cfg["extra_processes"]]
    poll = cfg["poll_seconds"]
    if isinstance(poll, (int, float)) and not isinstance(poll, bool) and not 0.5 <= poll <= 60:
        cfg["poll_seconds"] = min(60, max(0.5, poll))     # 1.5 and earlier clamped silently
        warn(f"config: poll_seconds = {poll} is out of range; using {cfg['poll_seconds']}")
    if "alias" not in user and cfg["alias"] and isinstance(cfg["model"], str) and cfg["model"] \
            and same_model(cfg["alias"], cfg["model"]):
        cfg["alias"] = ""
        warn(f"config: your model is named {cfg['model']}, like the new fixed name for apps; "
             "turned the fixed name off (set alias to choose one)")
    if "status_port" not in user and cfg["status_port"] == cfg["port"]:
        cfg["status_port"] = cfg["port"] + 1 if cfg["port"] < 65535 else 0
        warn(f"config: port {cfg['port']} is also the status page's default; status page "
             f"moved to {cfg['status_port']} (set status_port to choose)")


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))
    if CONFIG_FILE.exists():
        if tomllib is None:
            die("Python 3.11+ is needed to read the config file")
        with open(CONFIG_FILE, "rb") as f:
            try:
                user = tomllib.load(f)
            except tomllib.TOMLDecodeError as e:
                die(f"{CONFIG_FILE} has a syntax error: {e}")
        unknown = set(user) - set(DEFAULTS)
        if unknown:
            warn(f"ignoring unknown config keys: {', '.join(sorted(unknown))}")
        for k in DEFAULTS:
            if k in user:
                cfg[k] = user[k]
        repair_config(cfg, user)
    problem = config_problem(cfg)
    if problem:
        die(f"{CONFIG_FILE}: {problem}")
    for key in WHOLE_NUMBERS:
        cfg[key] = int(cfg[key])          # `port = 11434.0` in the file is still a port
    cfg["ignore_appids"] = [str(a) for a in cfg["ignore_appids"]]
    cfg["ollama_env"] = {str(k): str(v) for k, v in cfg["ollama_env"].items()}
    return cfg


def write_private(path, text):
    """Replace a file atomically, readable only by you (it can hold passwords and tokens)."""
    tmp = path.with_name(path.name + ".tmp")
    tmp.unlink(missing_ok=True)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def _value_end(lines, i):
    """Index of the last line of the value that starts on line i: a list or inline table
    written over several lines ends where its brackets close."""
    depth, quote = 0, None
    for j in range(i, len(lines)):
        text = lines[j].split("=", 1)[1] if j == i else lines[j]
        k = 0
        while k < len(text):
            c = text[k]
            if quote:
                if c == "\\" and quote == '"':
                    k += 1
                elif c == quote:
                    quote = None
            elif c in "\"'":
                quote = c
            elif c == "#":
                break
            elif c in "[{":
                depth += 1
            elif c in "]}":
                depth -= 1
            k += 1
        if depth <= 0:
            return j
    return i          # unbalanced: leave the rest alone and let the check report it


def set_config_values(values):
    """Rewrite top-level `key = value` lines in the config file, keeping comments.

    Written to a temp file and renamed into place, so an interruption can't leave a
    half-written config behind."""
    lines = CONFIG_FILE.read_text().splitlines()
    first_table = next((i for i, l in enumerate(lines) if l.strip().startswith("[")), len(lines))
    for key, value in values.items():
        if isinstance(value, bool):
            rendered = str(value).lower()
        elif isinstance(value, (str, list)):
            rendered = json.dumps(value, ensure_ascii=False)   # JSON strings/arrays are TOML
        else:
            rendered = str(value)
        for i, line in enumerate(lines[:first_table]):
            name = line.split("=", 1)[0].strip().strip("\"'")
            if "=" in line and name == key and not line.lstrip().startswith("#"):
                end = _value_end(lines, i)
                lines[i:end + 1] = [f"{key} = {rendered}"]
                first_table -= end - i
                break
        else:
            lines.insert(first_table, f"{key} = {rendered}")
            first_table += 1
    write_private(CONFIG_FILE, "\n".join(lines) + "\n")


def set_env_value(name, value):
    """Set (or with value "" remove) a key in the [ollama_env] table, keeping comments."""
    lines = CONFIG_FILE.read_text().splitlines()
    if any(re.match(r"\s*ollama_env\s*=", l) for l in lines):
        die("ollama_env is written as an inline table in the config file; edit it by hand")
    header = next((i for i, l in enumerate(lines)
                   if re.fullmatch(r"\s*\[\s*ollama_env\s*\]\s*(#.*)?", l)), None)
    if header is None:
        lines += ["", "[ollama_env]"]
        header = len(lines) - 1
    end = next((i for i in range(header + 1, len(lines)) if lines[i].strip().startswith("[")),
               len(lines))
    rendered = (f"{json.dumps(name, ensure_ascii=False) if not re.fullmatch(r'[A-Za-z0-9_-]+', name) else name}"
                f" = {json.dumps(value, ensure_ascii=False)}")
    for i in range(header + 1, end):
        if "=" in lines[i] and lines[i].split("=", 1)[0].strip().strip("\"'") == name \
                and not lines[i].lstrip().startswith("#"):
            if value == "":
                del lines[i]
            else:
                lines[i] = rendered
            break
    else:
        if value != "":
            lines.insert(end, rendered)
    write_private(CONFIG_FILE, "\n".join(lines) + "\n")


def change_settings(values=None, env=None):
    """Write settings, then check the whole file the way the watcher will read it. On any
    problem the file is put back exactly as it was and this stops with the reason, so a
    bad value never sits in the file waiting for the next restart."""
    before = CONFIG_FILE.read_text()
    try:
        if env:
            set_env_value(*env)
        if values:
            set_config_values(values)
        cfg = load_config()                      # stops with the reason if it's broken
        # load_config forgives old values (it clamps or converts them); a value being set
        # now must be valid as written.
        with open(CONFIG_FILE, "rb") as f:
            raw = tomllib.load(f)
        problem = config_problem(dict(cfg, **{k: raw[k] for k in values or {} if k in raw}))
        if problem:
            die(problem)
        return cfg
    except SystemExit:
        write_private(CONFIG_FILE, before)
        print("Nothing changed.", file=sys.stderr)
        raise


def parse_setting(key, text):
    """Turn command-line text into the type the setting needs."""
    default = DEFAULTS[key]
    if isinstance(default, bool):
        low = text.strip().lower()
        if low in ("true", "yes", "on", "1"):
            return True
        if low in ("false", "no", "off", "0"):
            return False
        raise ValueError(f"{key} must be true or false")
    if isinstance(default, int):
        try:
            number = float(text)
        except ValueError:
            raise ValueError(f"{key} must be a number") from None
        if number.is_integer() and "." not in text.strip() or key in WHOLE_NUMBERS:
            if not number.is_integer():
                raise ValueError(f"{key} must be a whole number")
            return int(number)
        return number
    if isinstance(default, list):
        return [x.strip() for x in text.split(",") if x.strip()]
    return text


def default_route_dev():
    """Network interface carrying the default route (e.g. "enp5s0"), or None."""
    for line in _read_text(Path("/proc/net/route")).splitlines()[1:]:
        parts = line.split()
        if len(parts) > 2 and parts[1] == "00000000":
            return parts[0]
    return None


def nic_info():
    """(interface, MAC, is_wireless) for the default route."""
    dev = default_route_dev()
    if not dev:
        return None, None, False
    mac = _read_text(Path(f"/sys/class/net/{dev}/address")).strip() or None
    return dev, mac, Path(f"/sys/class/net/{dev}/wireless").exists()


def _loopback_hex(addr):
    """True for 127.x/::1/::ffff:127.x in /proc/net/tcp's little-endian hex."""
    if len(addr) == 8:
        return addr[6:8] == "7F"
    if addr == "00000000000000000000000001000000":
        return True
    return addr.startswith("0000000000000000FFFF0000") and addr[30:32] == "7F"


def client_connections(port):
    """TCP connections to `port` from other machines (ignores loopback, e.g. our own
    health checks). Includes connections just closing, so a short request between two
    polls still counts."""
    n = 0
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        for line in _read_text(Path(table)).splitlines()[1:]:
            parts = line.split()
            if len(parts) < 4 or parts[3] == "0A":         # 0A = LISTEN
                continue
            local, remote = parts[1].rsplit(":", 1), parts[2].rsplit(":", 1)
            if int(local[1], 16) == port and not _loopback_hex(remote[0]):
                n += 1
    return n


def lan_address():
    """(ip, network) of the interface carrying the default route, or (None, None)."""
    try:
        dev = None
        out = run(["ip", "-4", "route", "show", "default"]).stdout.split()
        if "dev" in out:
            dev = out[out.index("dev") + 1]
        cmd = ["ip", "-4", "-o", "addr", "show", "scope", "global"] + (["dev", dev] if dev else [])
        for line in run(cmd).stdout.splitlines():
            parts = line.split()
            if "inet" in parts:
                iface = ipaddress.ip_interface(parts[parts.index("inet") + 1])
                return str(iface.ip), str(iface.network)
    except (OSError, ValueError, IndexError):
        pass
    return None, None


