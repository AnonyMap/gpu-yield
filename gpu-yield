def process_age(pid):
    """Seconds since a process started, or 0 if unknown."""
    try:
        start = int(_read_text(Path(f"/proc/{pid}/stat")).rsplit(")", 1)[1].split()[19])
        uptime = float(_read_text(Path("/proc/uptime")).split()[0])
        return uptime - start / os.sysconf("SC_CLK_TCK")
    except (ValueError, IndexError):
        return 0.0


_NO_CMDLINE = set()   # (pid, inode) of kernel threads and zombies: their cmdline stays empty
_GPU_EXES = []        # Windows programs outside Steam using the GPU, from the last scan
PF_KTHREAD = 0x00200000


def _never_has_cmdline(pid):
    """A kernel thread or a zombie: neither will ever have a command line."""
    try:
        fields = _read_text(Path(f"/proc/{pid}/stat")).rsplit(")", 1)[1].split()
        return fields[0] == "Z" or bool(int(fields[6]) & PF_KTHREAD)
    except (IndexError, ValueError):
        return False


def scan_games(cfg):
    """Return {pid: label} for every running game.

    Steam starts each game as `reaper SteamLaunch AppId=<id> -- <game command>` and the
    reaper lives as long as the game does, so it is a reliable "a game is running" flag.

    Windows games launched outside Steam (Heroic, Lutris, or a Heroic shortcut that hands
    off to an already-running Heroic and exits) have no reaper, but Wine/Proton keeps a
    `wineserver` process alive for as long as the game runs. It only counts when no Steam
    game is present, because Steam's Proton games run one too and `ignore_appids` must
    still be able to exempt them.
    """
    found = {}
    extra = {_norm_proc(x.encode()) for x in cfg["extra_processes"]}
    ignore = set(cfg["ignore_appids"])
    detect_wine = cfg["detect_wine"]
    steam_present = False
    wine_pids, exes = [], []
    try:          # scandir gives each /proc entry's inode for free: a reused pid gets a new one
        entries = [(e.name, e.inode()) for e in os.scandir("/proc") if e.name.isdigit()]
    except OSError:
        return found
    empty = set()
    for pid, inode in entries:
        if (pid, inode) in _NO_CMDLINE:
            empty.add((pid, inode))
            continue
        raw = _read_cmdline(pid)
        if not raw:
            # Half of /proc on a typical desktop is kernel threads, which never get a
            # command line. A process caught mid-exec (Steam starting a game) briefly has
            # none either, so only the kernel's own threads and zombies are remembered.
            if _never_has_cmdline(pid):
                empty.add((pid, inode))
            continue
        base = _basename(raw.partition(b"\0")[0])
        if base == b"reaper" and b"\0SteamLaunch\0" in raw:
            steam_present = True
            if len(raw) >= _CMDLINE_PEEK:
                raw = _read_cmdline(pid, full=True)
            argv = raw.rstrip(b"\0").split(b"\0")
            appid = next((a[6:].decode(errors="replace") for a in argv if a.startswith(b"AppId=")), "?")
            if appid == "0" or appid in ignore:
                continue
            found[int(pid)] = game_label(appid, argv)
        elif extra and (_norm_proc(base) in extra or _norm_proc(_read_comm(pid)) in extra):
            found[int(pid)] = base.decode(errors="replace")
        elif detect_wine:
            if base == b"wineserver":
                wine_pids.append(int(pid))
            elif base[-4:].lower() == b".exe" and not _is_wine_helper(base):
                exes.append((pid, base.decode(errors="replace")))
    _NO_CMDLINE.clear()
    _NO_CMDLINE.update(empty)          # only those still present: the set can't grow
    _GPU_EXES.clear()
    if wine_pids and not steam_present:
        # Wine also runs briefly for things that aren't games: Steam's install scripts,
        # redistributable installers, Proton's own helpers. A game draws with the GPU, so
        # only a Windows program that has the GPU open counts.
        gpu = [(pid, name) for pid, name in exes if _uses_gpu(pid)]
        _GPU_EXES[:] = [int(pid) for pid, _ in gpu]
        playing = [name for _, name in gpu]
        if playing:
            for pid in wine_pids:
                found[pid] = playing[0] + WINE_SUFFIX
    return found


WINE_SUFFIX = " (Wine, outside Steam)"
WINE_CONFIRM_SECONDS = 5
GPU_DEVICE_DIR = "/dev/dri/"


def _uses_gpu(pid):
    """True if the process has a GPU device (/dev/dri/renderD*, card*) open."""
    try:
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return False
    for fd in fds:
        try:
            if os.readlink(f"/proc/{pid}/fd/{fd}").startswith(GPU_DEVICE_DIR):
                return True
        except OSError:
            continue
    return False


def _is_wine_helper(base):
    name = base.lower()
    return name in _WINE_HELPERS or name.startswith(_WINE_HELPER_PREFIXES)


def game_running(cfg):
    return bool(scan_games(cfg))


_CMDLINE_PEEK = 4096

# Programs Wine itself runs inside every prefix; never the game.
_WINE_HELPERS = {s.encode() for s in (
    "services.exe", "winedevice.exe", "explorer.exe", "plugplay.exe", "svchost.exe",
    "rpcss.exe", "conhost.exe", "start.exe", "tabtip.exe", "rundll32.exe", "wineboot.exe",
    "winemenubuilder.exe", "steam.exe", "steamwebhelper.exe", "cmd.exe", "winedbg.exe",
    "regsvr32.exe", "msiexec.exe", "mscorsvw.exe", "iexplore.exe", "control.exe",
    # Proton's controller-navigation helper, and what Steam runs around installs
    "xalia.exe", "iscriptevaluator.exe", "steamerrorreporter.exe",
    "steamerrorreporter64.exe", "crashhandler.exe", "unitycrashhandler64.exe")}
# Redistributable installers and uninstallers Steam and launchers run in the background.
_WINE_HELPER_PREFIXES = tuple(s.encode() for s in (
    "vc_redist", "vcredist", "dxsetup", "dotnet", "ndp", "physx", "oalinst",
    "directx", "unins", "ue4prereq", "ueprereq", "easyanticheat_setup"))


def _read_cmdline(pid, full=False):
    """Raw /proc/<pid>/cmdline. Reads only the first 4 KiB unless full; os.read avoids
    the cost of a Python file object, which dominates a scan of hundreds of processes."""
    try:
        fd = os.open(f"/proc/{pid}/cmdline", os.O_RDONLY)
    except OSError:
        return b""
    try:
        data = os.read(fd, _CMDLINE_PEEK)
        if full:
            while chunk := os.read(fd, 65536):
                data += chunk
        return data
    except OSError:
        return b""
    finally:
        os.close(fd)


def _read_comm(pid):
    """The kernel's process name, as `ps -e` prints it (cut to 15 characters)."""
    try:
        fd = os.open(f"/proc/{pid}/comm", os.O_RDONLY)
    except OSError:
        return b""
    try:
        return os.read(fd, 64).rstrip(b"\n")
    except OSError:
        return b""
    finally:
        os.close(fd)


def _basename(path):
    """Last component of a Linux or Windows path (Wine shows `Z:\\...\\Game.exe`)."""
    return path.rpartition(b"/")[2].rpartition(b"\\")[2]


def _norm_proc(name):
    """Case-insensitive, `.exe` optional, so "Game", "game.exe" and "Game.EXE" all match."""
    name = name.lower()
    return name[:-4] if name.endswith(b".exe") else name


# ---------------------------------------------------------------------------- game names

_label_cache = {}


def game_label(appid, argv):
    """`Name (AppId N)` for status and logs; looked up once per AppId."""
    if appid not in _label_cache:
        name = None
        try:
            name = steam_app_name(appid) or shortcut_name(appid) or command_name(argv)
        except Exception:      # a name is nice to have; never let it break detection
            pass
        _label_cache[appid] = f"{name} (AppId {appid})" if name else f"Steam AppId {appid}"
    return _label_cache[appid]


def steam_roots():
    roots = []
    for r in (HOME / ".local/share/Steam", HOME / ".steam/steam",
              HOME / ".var/app/com.valvesoftware.Steam/.local/share/Steam"):
        try:
            r = r.resolve()
        except OSError:
            continue
        if r.is_dir() and r not in roots:
            roots.append(r)
    return roots


def _read_text(path):
    try:
        return path.read_text(errors="replace")
    except OSError:
        return ""


def steam_app_name(appid):
    """Name from steamapps/appmanifest_<id>.acf in any Steam library folder."""
    for root in steam_roots():
        libraries = [root] + [Path(p) for p in re.findall(
            r'"path"\s+"([^"]+)"', _read_text(root / "steamapps/libraryfolders.vdf"))]
        for lib in libraries:
            m = re.search(r'"name"\s+"([^"]+)"',
                          _read_text(lib / "steamapps" / f"appmanifest_{appid}.acf"))
            if m:
                return m.group(1)
    return None


def parse_binary_vdf(data):
    """Steam's binary KeyValues format (shortcuts.vdf) -> nested dicts."""
    pos = 0

    def cstr():
        nonlocal pos
        end = data.index(b"\0", pos)
        s = data[pos:end].decode("utf-8", "replace")
        pos = end + 1
        return s

    def node():
        nonlocal pos
        out = {}
        while pos < len(data):
            kind = data[pos]
            pos += 1
            if kind == 0x08:
                return out
            key = cstr()
            if kind == 0x00:
                out[key] = node()
            elif kind == 0x01:
                out[key] = cstr()
            elif kind in (0x02, 0x03):           # int32 / float32
                out[key] = int.from_bytes(data[pos:pos + 4], "little")
                pos += 4
            elif kind == 0x07:                   # uint64
                out[key] = int.from_bytes(data[pos:pos + 8], "little")
                pos += 8
            else:
                raise ValueError(f"unknown VDF field type {kind}")
        return out

    return node()


def shortcut_name(appid):
    """Name of a non-Steam game added to the library (userdata/*/config/shortcuts.vdf)."""
    try:
        n = int(appid)
    except ValueError:
        return None
    for root in steam_roots():
        for f in (root / "userdata").glob("*/config/shortcuts.vdf"):
            try:
                tree = parse_binary_vdf(f.read_bytes())
            except (OSError, ValueError, IndexError):
                continue
            for entry in (tree.get("shortcuts") or {}).values():
                if not isinstance(entry, dict):
                    continue
                low = {k.lower(): v for k, v in entry.items()}
                u = low.get("appid")
                # Steam shows a shortcut's id as unsigned, signed, or as a 64-bit game id.
                if isinstance(u, int) and n in (u, u - 2**32, (u << 32) | 0x02000000):
                    return low.get("appname") or None
    return None


def command_name(argv):
    """Last resort: the Windows .exe in the launch command (Proton games)."""
    try:
        rest = argv[argv.index(b"--") + 1:]
    except ValueError:
        return None
    for arg in reversed(rest):
        base = _basename(arg)
        if base[-4:].lower() == b".exe" and not _is_wine_helper(base):
            return base[:-4].decode(errors="replace")
    return None


# ------------------------------------------------------------------------------ Ollama

# GPU targets Ollama's ROCm build supports on Linux. Anything else uses Vulkan.
ROCM_TARGETS = {"gfx906", "gfx908", "gfx90a", "gfx942", "gfx1030", "gfx1100", "gfx1101",
                "gfx1102", "gfx1151", "gfx1200", "gfx1201"}
KFD_NODES = Path("/sys/class/kfd/kfd/topology/nodes")
PCI_DIR = Path("/sys/bus/pci/devices")
JOURNAL_DIR = Path("/var/log/journal")   # present when the journal survives reboots


def gpu_targets():
    """AMD GPU architectures present, e.g. {"gfx1101"} for an RX 7800 XT."""
    targets = set()
    for props in KFD_NODES.glob("*/properties"):
        m = re.search(r"^gfx_target_version (\d+)$", _read_text(props), re.M)
        if m and int(m.group(1)):
            v = int(m.group(1))   # 110001 -> gfx1101, 100301 -> gfx1031, 90010 -> gfx90a
            targets.add(f"gfx{v // 10000}{v // 100 % 100:x}{v % 100:x}")
    return targets


def backend_installed(cfg):
    """False if the managed Ollama install lacks the libraries the chosen backend needs
    (ROCm comes in a separate download); True or None (can't tell) otherwise."""
    if resolve_backend(cfg) != "rocm" or cfg["ollama_unit"] != MANAGED_OLLAMA_UNIT:
        return True
    lib = OLLAMA_DIR / "lib/ollama"
    if not lib.is_dir():
        return None
    return (lib / "rocm").is_dir() or any(lib.rglob("libggml-hip*"))


def resolve_backend(cfg):
    if cfg["backend"] != "auto":
        return cfg["backend"]
    targets = gpu_targets()
    return "rocm" if targets & ROCM_TARGETS else "vulkan"


def systemd_quote(value):
    """Escape a value for use inside Environment="..." (backslash, quote, % specifiers)."""
    return str(value).replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")


def total_ram():
    m = re.search(r"^MemTotal:\s+(\d+) kB", _read_text(Path("/proc/meminfo")), re.M)
    return int(m.group(1)) * 1024 if m else None


def ram_limit_bytes(setting):
    """Bytes for ollama_ram_limit, None for no limit, False if the setting is invalid."""
    text = str(setting).strip().lower()
    if text == "off":
        return None
    if text == "auto":
        total = total_ram()
        if not total:
            return None
        return max(4 * 2**30, total // 3 // 2**29 * 2**29)     # a third, in 0.5 GiB steps
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*(g|gb|gib)?", text)
    if not m or not 1 <= float(m.group(1)) <= 4096:
        return False
    return int(float(m.group(1)) * 2**30)


def effective_ram_limit(cfg):
    """Bytes for Ollama's RAM ceiling, or None. "auto" applies only where models are kept
    entirely in VRAM (ROCm with the fit guard): elsewhere part of a model may run from
    RAM on purpose, and a ceiling would get it stopped or make it crawl."""
    if str(cfg["ollama_ram_limit"]).strip().lower() == "auto" and not guards_gpu_fit(cfg):
        return None
    return ram_limit_bytes(cfg["ollama_ram_limit"]) or None


def ollama_unit_text(cfg):
    env = {
        "OLLAMA_HOST": f"0.0.0.0:{cfg['port']}",
        "OLLAMA_KEEP_ALIVE": "-1",               # stay loaded while idle; we decide when it goes
        "OLLAMA_CONTEXT_LENGTH": str(cfg["context_length"]),
        "OLLAMA_NUM_PARALLEL": "1",              # parallel slots multiply context memory
        "OLLAMA_MAX_LOADED_MODELS": "1",
    }
    # BC-250: store the context at 8 bits unless you chose otherwise. It halves context
    # memory in a pool shared with Linux; and models with few KV heads (Muse Glimmer has
    # 2) must never use q4_0, which can wreck their output.
    if is_bc250() and "OLLAMA_KV_CACHE_TYPE" not in cfg["ollama_env"]:
        env["OLLAMA_KV_CACHE_TYPE"] = "q8_0"
    # The BC-250 and APUs report themselves as integrated GPUs, which Ollama drops unless
    # told otherwise ("dropping integrated GPU"), running everything on the CPU. When it's
    # the PC's only GPU, admit it. Not on PCs with a graphics card as well: admitting the
    # processor's own graphics there would split models across both.
    if is_bc250() or only_one_gpu():
        env["OLLAMA_IGPU_ENABLE"] = "1"
    # Shared-memory chips: the program that runs the model (llama-server, inheriting this
    # environment) keeps a prompt cache in ordinary RAM, by default up to 8 GiB, plus up
    # to 32 context snapshots per conversation. There, RAM is the GPU's memory too, and a
    # BC-250 has about 2 GB to spare once the model is loaded, so the cache alone can run
    # the board out over hours of agent traffic. 512 MiB holds one Muse Glimmer
    # conversation at 64K (about 7 KB a token at q8_0); a saved state bigger than the cap
    # is just skipped, so models with bigger context memory get no cache rather than more.
    # And load the file with direct I/O, as Ollama itself does for integrated CUDA and ROCm
    # GPUs, so a reload doesn't also push the whole file through the page cache.
    if shared_memory_gpu():
        env["LLAMA_ARG_CACHE_RAM"] = str(SHARED_PROMPT_CACHE_MIB)
        env["LLAMA_ARG_CTX_CHECKPOINTS"] = "4"
        env["LLAMA_ARG_LOAD_MODE"] = "dio"
    # Until the ROCm download is installed (gpu-yield setup --reinstall), keep using Vulkan
    # rather than silently falling back to the CPU.
    if resolve_backend(cfg) == "vulkan" or backend_installed(cfg) is False:
        env["OLLAMA_VULKAN"] = "1"
    env.update(cfg["ollama_env"])
    env_lines = "\n".join(f'Environment="{systemd_quote(k)}={systemd_quote(v)}"'
                          for k, v in env.items())
    # RAM: a ceiling (Linux stops Ollama alone if it goes over), no swap (a model paged
    # out to disk would crawl and take the PC with it), and first in line if RAM runs out.
    limit = effective_ram_limit(cfg)
    ram_lines = (f"MemoryMax={limit}\n" if limit else "") + "MemorySwapMax=0\nOOMScoreAdjust=800\n"
    # BindsTo+After: Ollama may only run while the watcher is active. If the watcher dies
    # or crash-loops, Ollama is stopped instead of being left holding the GPU.
    return f"""\
# Generated by gpu-yield from {CONFIG_FILE}. Edit the config, not this file.
[Unit]
Description=Ollama (managed by gpu-yield)
BindsTo={WATCHER_UNIT}
After={WATCHER_UNIT}

[Service]
ExecStart={OLLAMA_BIN} serve
{env_lines}
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
{ram_lines}"""


def watcher_unit_text():
    return f"""\
[Unit]
Description=gpu-yield: run Ollama while the GPU is idle, stop it for games

[Service]
ExecStart={sys.executable if sys.executable.startswith('/usr/') else '/usr/bin/python3'} {BIN_PATH} run
Restart=always
RestartSec=5
# The game comes first for CPU time, and the kernel may batch the watcher's wakeups.
Nice=10
TimerSlackNSec=50ms

[Install]
WantedBy=default.target
"""


def write_unit(name, text):
    """Write a user unit if its content changed. Returns True if it changed."""
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    path = UNIT_DIR / name
    if path.exists() and path.read_text() == text:
        return False
    path.write_text(text)
    return True


def ensure_ollama_unit(cfg):
    if cfg["ollama_unit"] != MANAGED_OLLAMA_UNIT:
        return False
    changed = write_unit(MANAGED_OLLAMA_UNIT, ollama_unit_text(cfg))
    if changed:
        user_systemctl("daemon-reload")
    return changed


class Ollama:
    def __init__(self, cfg):
        self.cfg = cfg
        self.unit = cfg["ollama_unit"]
        self.base = f"http://127.0.0.1:{cfg['port']}"

    def active(self):
        return user_systemctl("is-active", "--quiet", self.unit).returncode == 0

    def start(self):
        r = user_systemctl("start", self.unit)
        if r.returncode:
            log(f"could not start {self.unit}: {r.stderr.strip()}")
            return False
        return True

    def stop(self):
        r = user_systemctl("stop", self.unit)
        if r.returncode:
            log(f"could not stop {self.unit}: {r.stderr.strip()}")
            return False
        return True

    def request(self, path, payload=None, timeout=5.0, method=None):
        data = json.dumps(payload).encode() if payload is not None else None
        headers = {"Content-Type": "application/json"} if data else {}
        req = urllib.request.Request(self.base + path, data=data, headers=headers, method=method)
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read()
        return json.loads(body) if body else {}

    def ready(self):
        try:
            self.request("/api/version", timeout=2)
            return True
        except Exception:
            return False

    def wait_ready(self, timeout, stop_evt=None):
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            if self.ready():
                return True
            if stop_evt is not None:
                if stop_evt.wait(1):
                    return False
            else:
                time.sleep(1)
        return False

    def warm(self, name=None):
        """Load the model into VRAM and keep it there (empty prompt = load only).

        Deliberately no num_gpu: setting it switches Ollama from expert-aware placement
        (MoE experts to RAM first) to a plain layer split, which is much slower.
        """
        self.request("/api/generate", {
            "model": name or self.cfg["model"],
            "prompt": "",
            "keep_alive": -1,
            "options": {"num_ctx": int(self.cfg["context_length"])},
        }, timeout=900)

    def loaded(self):
        try:
            return self.request("/api/ps", timeout=3).get("models", [])
        except Exception:
            return None

    def is_moe(self, model):
        """True if the model is mixture-of-experts (its GGUF metadata has an expert count)."""
        try:
            info = self.request("/api/show", {"model": model}, timeout=10).get("model_info", {})
        except Exception:
            return False
        return any(k.endswith(".expert_count") and v for k, v in info.items())


def guards_shared_fit(cfg):
    """True where a model must leave Linux enough memory: shared-memory chips like the
    BC-250, where model and system draw on one pool and running out freezes the board."""
    return not cfg["allow_partial_gpu"] and shared_memory_gpu()


def guards_gpu_fit(cfg):
    """True where a model must fit entirely in VRAM: ROCm (unless allowed). Through ROCm
    the GPU reads spilled weights from system RAM via the driver, which has stalled the
    driver and shut down a PC; on Vulkan spilling only costs speed."""
    return not cfg["allow_partial_gpu"] and resolve_backend(cfg) == "rocm" \
        and backend_installed(cfg) is not False


def spilled(models):
    """Loaded models with part of them outside VRAM."""
    return [m for m in models or [] if m.get("size") and 0 < m.get("size_vram", 0) < m["size"]]


def fits(models):
    """Evidence that everything loaded is entirely in VRAM."""
    return bool(models) and all(m.get("size") and m.get("size_vram", 0) >= m["size"]
                                for m in models)


FIT_FILE = STATE_DIR / "last-fit.json"


def last_fit():
    """The model and context that last loaded entirely in VRAM: {"model", "context_length"}."""
    try:
        rec = json.loads(FIT_FILE.read_text())
        return rec if isinstance(rec, dict) and isinstance(rec.get("model"), str) else {}
    except (OSError, ValueError):
        return {}


def save_fit(model, ctx):
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        FIT_FILE.write_text(json.dumps({"model": model, "context_length": int(ctx)}))
    except OSError:
        pass


def oom_killed_since(unit, since):
    """True if systemd recorded an out-of-memory kill in this unit since `since` (epoch)."""
    r = run(["journalctl", "--user", "-u", unit, "--since", f"@{int(since)}", "-o", "cat",
             "-q", "--no-pager", "-n", "200"])
    return bool(re.search(r"killed by the OOM killer|oom-kill", r.stdout or "", re.I))


_LOG_FIELD = re.compile(r'(\w+)=("(?:[^"\\]|\\.)*"|\S*)')
OLLAMA_START_LINES = "server config|inference compute|dropping integrated GPU"


def memory_users(count=3):
    """What's using memory, for low-memory messages: the GPU's share (the model, which
    process lists don't show) and the biggest programs. E.g. "GPU 12.1 GB; cargo 3.2 GB"."""
    parts = []
    used = gpu_used(memory_readings())
    if used:
        parts.append(f"GPU {size_text(used)}")
    procs = []
    for d in Path("/proc").glob("[0-9]*"):
        status = _read_text(d / "status")
        rss = re.search(r"^RssAnon:\s+(\d+) kB", status, re.M)
        name = re.search(r"^Name:\s+(.*)$", status, re.M)
        if rss and name:
            procs.append((int(rss.group(1)) * 1024, clean_text(name.group(1))[:30]))
    totals = {}
    for rss, name in procs:                       # many rustc or chrome processes add up
        totals[name] = totals.get(name, 0) + rss
    parts += [f"{n} {size_text(b)}" for n, b in
              sorted(totals.items(), key=lambda x: -x[1])[:count]]
    return "; ".join(parts) or "unknown"


def ollama_devices(unit):
    """What Ollama's own startup log says it found, since it last started:
    {"devices": [{library, name, description, type, total, available}], "dropped": [...]}
    ("dropped": integrated GPUs it ignored), or None if the log can't be read."""
    # Ollama logs every HTTP request, about 1800 lines an hour from gpu-yield's own checks,
    # so ask journalctl for just the startup lines rather than the last N of everything.
    base = ["journalctl", "--user", "-u", unit, "-b", "-o", "cat", "-q", "--no-pager"]
    try:
        r = run(base + ["-g", OLLAMA_START_LINES, "-n", "500"], timeout=15)
        if r.returncode and not r.stdout:      # journalctl built without pattern support
            r = run(base + ["-n", "100000"], timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = (r.stdout or "").splitlines()
    if not lines:
        return None
    starts = [i for i, ln in enumerate(lines) if 'msg="server config"' in ln]
    if starts:
        lines = lines[starts[-1]:]
    found = {"devices": [], "dropped": []}
    for ln in lines:
        kind = "devices" if 'msg="inference compute"' in ln else \
            "dropped" if "dropping integrated GPU" in ln else None
        if not kind:
            continue
        fields = {k: clean_text(v[1:-1] if v.startswith('"') else v)[:120]
                  for k, v in _LOG_FIELD.findall(ln)}
        found[kind].append({k: fields.get(k, "") for k in
                            ("library", "name", "description", "type", "total", "available")})
    return found


def describe_devices(found):
    """One line per device Ollama found, for doctor."""
    out = []
    for d in found["devices"]:
        if d["library"].lower() == "cpu":
            out.append("CPU only")
            continue
        what = d["description"] or d["name"] or "?"
        kind = f", {d['type']}" if d["type"] else ""
        room = f": {d['available']} free of {d['total']}" if d["total"] else ""
        out.append(f"{d['library']} {what}{kind}{room}")
    return out


def igpu_turned_off(cfg):
    """True if OLLAMA_IGPU_ENABLE is set to a value Ollama reads as false. Ollama strips
    spaces and quotes, then uses Go's ParseBool: only these mean false, and anything it
    can't read counts as true."""
    value = str(cfg["ollama_env"].get("OLLAMA_IGPU_ENABLE", "")).strip().strip("\"'")
    return value in ("0", "f", "F", "false", "FALSE", "False")


def only_one_gpu():
    """True if the PC has a single graphics device of any make (read from the PCI bus, so
    a card whose driver shows no screen device still counts)."""
    return sum(_read_text(d / "class").strip().startswith("0x03")
               for d in PCI_DIR.glob("*")) == 1


def cpu_only_advice(ollama):
    """Why Ollama put nothing on the GPU, from its own log, and what to do about it."""
    cfg = ollama.cfg
    try:
        found = ollama_devices(ollama.unit) if cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT \
            else None
    except Exception:
        found = None
    if found and found["dropped"]:
        if igpu_turned_off(cfg):
            return ("Ollama ignored the GPU because it's an integrated one and "
                    "OLLAMA_IGPU_ENABLE is set to off. Turn it on: "
                    "gpu-yield config env.OLLAMA_IGPU_ENABLE 1")
        return ("Ollama ignored the GPU because it's an integrated one. Let it use it: "
                "gpu-yield config env.OLLAMA_IGPU_ENABLE 1")
    if resolve_backend(cfg) == "vulkan":
        return ("Ollama found no usable GPU through Vulkan. Run gpu-yield doctor: it shows "
                "what Ollama found, and checks the Vulkan driver")
    return ("Run gpu-yield doctor; if it doesn't show a fix, try the other backend: "
            "gpu-yield setup --backend vulkan --reinstall")


def placement_note(ollama, model, share):
    """(is_problem, message) describing how much of the model is in VRAM."""
    if share is None or share >= 100:
        return False, ""
    if share == 0:
        return True, ("the model is running entirely on the CPU, so the GPU backend isn't "
                      "working. " + cpu_only_advice(ollama))
    if ollama.is_moe(model):
        return False, (f"{100 - share}% of this mixture-of-experts model is in system RAM. "
                       "That's expected for models bigger than VRAM: expert weights go to RAM "
                       "first, so generation stays usable, but long prompts are processed "
                       "more slowly.")
    return True, (f"{100 - share}% of this dense model spilled to system RAM, so it will be slow. "
                  "Lower context_length or pick a smaller model.")


def models_dir(cfg):
