    custom = cfg["ollama_env"].get("OLLAMA_MODELS")
    return Path(custom).expanduser() if custom else HOME / ".ollama/models"


def models_free_space(path):
    """Free bytes on the filesystem that holds `path` (only that drive, not every drive
    in the PC). Measured at the nearest folder that exists, since the model folder is
    only created by the first download."""
    p = Path(path)
    while not p.exists() and p != p.parent:
        p = p.parent
    try:
        return shutil.disk_usage(p).free
    except OSError:
        return None


def tilde(path):
