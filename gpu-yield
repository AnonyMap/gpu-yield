def warn(msg):
    print(f"WARNING: {msg}", flush=True)


def die(msg):
    print(f"ERROR: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def run(cmd, check=False, quiet=True, **kw):
    if quiet:
        kw.setdefault("capture_output", True)
    return subprocess.run(cmd, text=True, check=check, **kw)


def user_systemctl(*args):
    return run(["systemctl", "--user", *args])


def ago(seconds):
    seconds = int(max(0, seconds))
    if seconds < 90:
        return f"{seconds}s"
    if seconds < 5400:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h {seconds % 3600 // 60}m"


def config_problem(cfg):
    """A human-readable reason the config is invalid, or None."""
    for key, default in DEFAULTS.items():
        value = cfg[key]
        if isinstance(default, bool):
            ok_type = isinstance(value, bool)
        elif isinstance(default, int):
            ok_type = isinstance(value, (int, float)) and not isinstance(value, bool)
        else:
            ok_type = isinstance(value, type(default))
        if not ok_type:
            kind = {bool: "true or false", int: "a number", str: "text in quotes",
                    list: "a list like [\"a\", \"b\"]", dict: "a table"}[type(default)]
            return f"{key} must be {kind}, not {value!r}"
        if key in CHOICES and value not in CHOICES[key]:
            return f"{key} must be one of {', '.join(CHOICES[key])}, not {value!r}"
    limits = {"context_length": (512, 10_000_000), "port": (1, 65535), "status_port": (0, 65535),
              "cooldown_seconds": (0, 86400), "poll_seconds": (0.5, 60)}
    for key, (lo, hi) in limits.items():
        if not lo <= cfg[key] <= hi:
            return f"{key} must be between {lo} and {hi}, not {cfg[key]}"
    if cfg["status_port"] == cfg["port"]:
        return "status_port must differ from port"
    return None


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))
    if CONFIG_FILE.exists():
        if tomllib is None:
            die("Python 3.11+ is needed to read the config file")
        with open(CONFIG_FILE, "rb") as f:
            try:
                user = tomllib.load(f)
            except tomllib.TOMLDecodeError as e:
                die(f"{CONFIG_FILE} has a syntax error: {e}")
        unknown = set(user) - set(DEFAULTS)
        if unknown:
            warn(f"ignoring unknown config keys: {', '.join(sorted(unknown))}")
        for k in DEFAULTS:
            if k in user:
                cfg[k] = user[k]
    problem = config_problem(cfg)
    if problem:
        die(f"{CONFIG_FILE}: {problem}")
    cfg["ignore_appids"] = [str(a) for a in cfg["ignore_appids"]]
    cfg["ollama_env"] = {str(k): str(v) for k, v in cfg["ollama_env"].items()}
    return cfg


def set_config_values(values):
    """Rewrite top-level `key = value` lines in the config file, keeping comments.

    Written to a temp file and renamed into place, so an interruption can't leave a
    half-written config behind."""
    lines = CONFIG_FILE.read_text().splitlines()
    first_table = next((i for i, l in enumerate(lines) if l.strip().startswith("[")), len(lines))
    for key, value in values.items():
        if isinstance(value, bool):
            rendered = str(value).lower()
        elif isinstance(value, str):
            rendered = json.dumps(value)
        else:
            rendered = str(value)
        for i, line in enumerate(lines[:first_table]):
            name = line.split("=", 1)[0].strip().strip("\"'")
            if "=" in line and name == key and not line.lstrip().startswith("#"):
                lines[i] = f"{key} = {rendered}"
                break
        else:
            lines.insert(first_table, f"{key} = {rendered}")
            first_table += 1
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.replace(tmp, CONFIG_FILE)


def set_env_value(name, value):
    """Set (or with value "" remove) a key in the [ollama_env] table, keeping comments."""
    lines = CONFIG_FILE.read_text().splitlines()
    header = next((i for i, l in enumerate(lines) if l.strip() == "[ollama_env]"), None)
    if header is None:
        lines += ["", "[ollama_env]"]
        header = len(lines) - 1
    end = next((i for i in range(header + 1, len(lines)) if lines[i].strip().startswith("[")),
               len(lines))
    rendered = f"{json.dumps(name) if not re.fullmatch(r'[A-Za-z0-9_-]+', name) else name} = {json.dumps(value)}"
    for i in range(header + 1, end):
        if "=" in lines[i] and lines[i].split("=", 1)[0].strip().strip("\"'") == name \
                and not lines[i].lstrip().startswith("#"):
            if value == "":
                del lines[i]
            else:
                lines[i] = rendered
            break
    else:
        if value != "":
            lines.insert(end, rendered)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.replace(tmp, CONFIG_FILE)


def parse_setting(key, text):
    """Turn command-line text into the type the setting needs."""
    default = DEFAULTS[key]
    if isinstance(default, bool):
        low = text.strip().lower()
        if low in ("true", "yes", "on", "1"):
            return True
        if low in ("false", "no", "off", "0"):
            return False
        raise ValueError(f"{key} must be true or false")
    if isinstance(default, int):
        try:
            return int(text)
        except ValueError:
            try:
                return float(text)
            except ValueError:
                raise ValueError(f"{key} must be a number") from None
    if isinstance(default, list):
        return [x.strip() for x in text.split(",") if x.strip()]
    return text


def default_route_dev():
    """Network interface carrying the default route (e.g. "enp5s0"), or None."""
    for line in _read_text(Path("/proc/net/route")).splitlines()[1:]:
        parts = line.split()
        if len(parts) > 2 and parts[1] == "00000000":
            return parts[0]
    return None


def nic_info():
    """(interface, MAC, is_wireless) for the default route."""
    dev = default_route_dev()
    if not dev:
        return None, None, False
    mac = _read_text(Path(f"/sys/class/net/{dev}/address")).strip() or None
    return dev, mac, Path(f"/sys/class/net/{dev}/wireless").exists()


def _loopback_hex(addr):
    """True for 127.x/::1/::ffff:127.x in /proc/net/tcp's little-endian hex."""
    if len(addr) == 8:
        return addr[6:8] == "7F"
    if addr == "00000000000000000000000001000000":
        return True
    return addr.startswith("0000000000000000FFFF0000") and addr[30:32] == "7F"


def client_connections(port):
    """TCP connections to `port` from other machines (ignores loopback, e.g. our own
    health checks). Includes connections just closing, so a short request between two
    polls still counts."""
    n = 0
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        for line in _read_text(Path(table)).splitlines()[1:]:
            parts = line.split()
            if len(parts) < 4 or parts[3] == "0A":         # 0A = LISTEN
                continue
            local, remote = parts[1].rsplit(":", 1), parts[2].rsplit(":", 1)
            if int(local[1], 16) == port and not _loopback_hex(remote[0]):
                n += 1
    return n


def lan_address():
    """(ip, network) of the interface carrying the default route, or (None, None)."""
    try:
        dev = None
        out = run(["ip", "-4", "route", "show", "default"]).stdout.split()
        if "dev" in out:
            dev = out[out.index("dev") + 1]
        cmd = ["ip", "-4", "-o", "addr", "show", "scope", "global"] + (["dev", dev] if dev else [])
        for line in run(cmd).stdout.splitlines():
            parts = line.split()
            if "inet" in parts:
                iface = ipaddress.ip_interface(parts[parts.index("inet") + 1])
                return str(iface.ip), str(iface.network)
    except (OSError, ValueError, IndexError):
        pass
    return None, None


# ----------------------------------------------------------------------- game detection

def scan_games(cfg):
    """Return {pid: label} for every running game.

    Steam starts each game as `reaper SteamLaunch AppId=<id> -- <game command>` and the
    reaper lives as long as the game does, so it is a reliable "a game is running" flag.

    Windows games launched outside Steam (Heroic, Lutris, or a Heroic shortcut that hands
    off to an already-running Heroic and exits) have no reaper, but Wine/Proton keeps a
    `wineserver` process alive for as long as the game runs. It only counts when no Steam
    game is present, because Steam's Proton games run one too and `ignore_appids` must
    still be able to exempt them.
    """
    found = {}
    extra = {_norm_proc(x.encode()) for x in cfg["extra_processes"]}
    ignore = set(cfg["ignore_appids"])
    detect_wine = cfg["detect_wine"]
    steam_present = False
    wine_pids, exes = [], []
    try:
        pids = os.listdir("/proc")
    except OSError:
        return found
    for pid in pids:
        if not pid.isdigit():
            continue
        raw = _read_cmdline(pid)
        if not raw:
            continue
        base = _basename(raw.partition(b"\0")[0])
        if base == b"reaper" and b"\0SteamLaunch\0" in raw:
            steam_present = True
            if len(raw) >= _CMDLINE_PEEK:
                raw = _read_cmdline(pid, full=True)
            argv = raw.rstrip(b"\0").split(b"\0")
            appid = next((a[6:].decode(errors="replace") for a in argv if a.startswith(b"AppId=")), "?")
            if appid == "0" or appid in ignore:
                continue
            found[int(pid)] = game_label(appid, argv)
        elif extra and (_norm_proc(base) in extra or _norm_proc(_read_comm(pid)) in extra):
            found[int(pid)] = base.decode(errors="replace")
        elif detect_wine:
            if base == b"wineserver":
                wine_pids.append(int(pid))
            elif base[-4:].lower() == b".exe" and base.lower() not in _WINE_HELPERS:
                exes.append(base.decode(errors="replace"))
    if wine_pids and not steam_present:
        what = f"{exes[0]} (Wine, outside Steam)" if exes else "Wine/Proton game (outside Steam)"
        for pid in wine_pids:
            found[pid] = what
    return found


_CMDLINE_PEEK = 4096

# Programs Wine itself runs inside every prefix; never the game.
_WINE_HELPERS = {s.encode() for s in (
    "services.exe", "winedevice.exe", "explorer.exe", "plugplay.exe", "svchost.exe",
    "rpcss.exe", "conhost.exe", "start.exe", "tabtip.exe", "rundll32.exe", "wineboot.exe",
    "winemenubuilder.exe", "steam.exe", "steamwebhelper.exe", "cmd.exe", "winedbg.exe",
    "regsvr32.exe", "msiexec.exe", "mscorsvw.exe", "iexplore.exe", "control.exe")}


def _read_cmdline(pid, full=False):
    """Raw /proc/<pid>/cmdline. Reads only the first 4 KiB unless full; os.read avoids
    the cost of a Python file object, which dominates a scan of hundreds of processes."""
    try:
        fd = os.open(f"/proc/{pid}/cmdline", os.O_RDONLY)
    except OSError:
        return b""
    try:
        data = os.read(fd, _CMDLINE_PEEK)
        if full:
            while chunk := os.read(fd, 65536):
                data += chunk
        return data
    except OSError:
        return b""
    finally:
        os.close(fd)


def _read_comm(pid):
    """The kernel's process name, as `ps -e` prints it (cut to 15 characters)."""
    try:
        fd = os.open(f"/proc/{pid}/comm", os.O_RDONLY)
    except OSError:
        return b""
    try:
        return os.read(fd, 64).rstrip(b"\n")
    except OSError:
        return b""
    finally:
        os.close(fd)


def _basename(path):
    """Last component of a Linux or Windows path (Wine shows `Z:\\...\\Game.exe`)."""
    return path.rpartition(b"/")[2].rpartition(b"\\")[2]


def _norm_proc(name):
    """Case-insensitive, `.exe` optional, so "Game", "game.exe" and "Game.EXE" all match."""
    name = name.lower()
    return name[:-4] if name.endswith(b".exe") else name


# ---------------------------------------------------------------------------- game names

_label_cache = {}


def game_label(appid, argv):
    """`Name (AppId N)` for status and logs; looked up once per AppId."""
    if appid not in _label_cache:
        name = None
        try:
            name = steam_app_name(appid) or shortcut_name(appid) or command_name(argv)
        except Exception:      # a name is nice to have; never let it break detection
            pass
        _label_cache[appid] = f"{name} (AppId {appid})" if name else f"Steam AppId {appid}"
    return _label_cache[appid]


def steam_roots():
    roots = []
    for r in (HOME / ".local/share/Steam", HOME / ".steam/steam",
              HOME / ".var/app/com.valvesoftware.Steam/.local/share/Steam"):
        try:
            r = r.resolve()
        except OSError:
            continue
        if r.is_dir() and r not in roots:
            roots.append(r)
    return roots


def _read_text(path):
    try:
        return path.read_text(errors="replace")
    except OSError:
        return ""


def steam_app_name(appid):
    """Name from steamapps/appmanifest_<id>.acf in any Steam library folder."""
    for root in steam_roots():
        libraries = [root] + [Path(p) for p in re.findall(
            r'"path"\s+"([^"]+)"', _read_text(root / "steamapps/libraryfolders.vdf"))]
        for lib in libraries:
            m = re.search(r'"name"\s+"([^"]+)"',
                          _read_text(lib / "steamapps" / f"appmanifest_{appid}.acf"))
            if m:
                return m.group(1)
    return None


def parse_binary_vdf(data):
    """Steam's binary KeyValues format (shortcuts.vdf) -> nested dicts."""
    pos = 0

    def cstr():
        nonlocal pos
        end = data.index(b"\0", pos)
        s = data[pos:end].decode("utf-8", "replace")
        pos = end + 1
        return s

    def node():
        nonlocal pos
        out = {}
        while pos < len(data):
            kind = data[pos]
            pos += 1
            if kind == 0x08:
                return out
            key = cstr()
            if kind == 0x00:
                out[key] = node()
            elif kind == 0x01:
                out[key] = cstr()
            elif kind in (0x02, 0x03):           # int32 / float32
                out[key] = int.from_bytes(data[pos:pos + 4], "little")
                pos += 4
            elif kind == 0x07:                   # uint64
                out[key] = int.from_bytes(data[pos:pos + 8], "little")
                pos += 8
            else:
                raise ValueError(f"unknown VDF field type {kind}")
        return out

    return node()


def shortcut_name(appid):
    """Name of a non-Steam game added to the library (userdata/*/config/shortcuts.vdf)."""
    try:
        n = int(appid)
    except ValueError:
        return None
    for root in steam_roots():
        for f in (root / "userdata").glob("*/config/shortcuts.vdf"):
            try:
                tree = parse_binary_vdf(f.read_bytes())
            except (OSError, ValueError, IndexError):
                continue
            for entry in (tree.get("shortcuts") or {}).values():
                if not isinstance(entry, dict):
                    continue
                low = {k.lower(): v for k, v in entry.items()}
                u = low.get("appid")
                # Steam shows a shortcut's id as unsigned, signed, or as a 64-bit game id.
                if isinstance(u, int) and n in (u, u - 2**32, (u << 32) | 0x02000000):
                    return low.get("appname") or None
    return None


def command_name(argv):
    """Last resort: the Windows .exe in the launch command (Proton games)."""
    try:
        rest = argv[argv.index(b"--") + 1:]
    except ValueError:
        return None
    for arg in reversed(rest):
        base = _basename(arg)
        if base[-4:].lower() == b".exe" and base.lower() not in _WINE_HELPERS:
            return base[:-4].decode(errors="replace")
    return None


# ------------------------------------------------------------------------------ Ollama

# GPU targets Ollama's ROCm build supports on Linux. Anything else uses Vulkan.
ROCM_TARGETS = {"gfx906", "gfx908", "gfx90a", "gfx942", "gfx1030", "gfx1100", "gfx1101",
                "gfx1102", "gfx1151", "gfx1200", "gfx1201"}
KFD_NODES = Path("/sys/class/kfd/kfd/topology/nodes")


def gpu_targets():
    """AMD GPU architectures present, e.g. {"gfx1101"} for an RX 7800 XT."""
    targets = set()
    for props in KFD_NODES.glob("*/properties"):
        m = re.search(r"^gfx_target_version (\d+)$", _read_text(props), re.M)
        if m and int(m.group(1)):
            v = int(m.group(1))   # 110001 -> gfx1101, 100301 -> gfx1031, 90010 -> gfx90a
            targets.add(f"gfx{v // 10000}{v // 100 % 100:x}{v % 100:x}")
    return targets


def resolve_backend(cfg):
    if cfg["backend"] != "auto":
        return cfg["backend"]
    targets = gpu_targets()
    return "rocm" if targets & ROCM_TARGETS else "vulkan"


def systemd_quote(value):
    """Escape a value for use inside Environment="..." (backslash, quote, % specifiers)."""
    return str(value).replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")


def ollama_unit_text(cfg):
    env = {
        "OLLAMA_HOST": f"0.0.0.0:{cfg['port']}",
        "OLLAMA_KEEP_ALIVE": "-1",               # stay loaded while idle; we decide when it goes
        "OLLAMA_CONTEXT_LENGTH": str(cfg["context_length"]),
        "OLLAMA_NUM_PARALLEL": "1",              # parallel slots multiply context memory
        "OLLAMA_MAX_LOADED_MODELS": "1",
    }
    if resolve_backend(cfg) == "vulkan":
        env["OLLAMA_VULKAN"] = "1"
    env.update(cfg["ollama_env"])
    env_lines = "\n".join(f'Environment="{systemd_quote(k)}={systemd_quote(v)}"'
                          for k, v in env.items())
    # BindsTo+After: Ollama may only run while the watcher is active. If the watcher dies
    # or crash-loops, Ollama is stopped instead of being left holding the GPU.
    return f"""\
# Generated by gpu-yield from {CONFIG_FILE}. Edit the config, not this file.
[Unit]
Description=Ollama (managed by gpu-yield)
BindsTo={WATCHER_UNIT}
After={WATCHER_UNIT}

[Service]
ExecStart={OLLAMA_BIN} serve
{env_lines}
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
"""


def watcher_unit_text():
    return f"""\
[Unit]
Description=gpu-yield: run Ollama while the GPU is idle, stop it for games

[Service]
ExecStart={sys.executable if sys.executable.startswith('/usr/') else '/usr/bin/python3'} {BIN_PATH} run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
"""


def write_unit(name, text):
    """Write a user unit if its content changed. Returns True if it changed."""
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    path = UNIT_DIR / name
    if path.exists() and path.read_text() == text:
        return False
    path.write_text(text)
    return True


def ensure_ollama_unit(cfg):
    if cfg["ollama_unit"] != MANAGED_OLLAMA_UNIT:
        return False
    changed = write_unit(MANAGED_OLLAMA_UNIT, ollama_unit_text(cfg))
    if changed:
        user_systemctl("daemon-reload")
    return changed


class Ollama:
    def __init__(self, cfg):
        self.cfg = cfg
        self.unit = cfg["ollama_unit"]
        self.base = f"http://127.0.0.1:{cfg['port']}"

    def active(self):
        return user_systemctl("is-active", "--quiet", self.unit).returncode == 0

    def start(self):
        r = user_systemctl("start", self.unit)
        if r.returncode:
            log(f"could not start {self.unit}: {r.stderr.strip()}")
            return False
        return True

    def stop(self):
        r = user_systemctl("stop", self.unit)
        if r.returncode:
            log(f"could not stop {self.unit}: {r.stderr.strip()}")
            return False
        return True

    def request(self, path, payload=None, timeout=5.0):
        data = json.dumps(payload).encode() if payload is not None else None
        headers = {"Content-Type": "application/json"} if data else {}
        req = urllib.request.Request(self.base + path, data=data, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read()
        return json.loads(body) if body else {}

    def ready(self):
        try:
            self.request("/api/version", timeout=2)
            return True
        except Exception:
            return False

    def wait_ready(self, timeout, stop_evt=None):
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            if self.ready():
                return True
            if stop_evt is not None:
                if stop_evt.wait(1):
                    return False
            else:
                time.sleep(1)
        return False

    def warm(self):
        """Load the model into VRAM and keep it there (empty prompt = load only).

        Deliberately no num_gpu: setting it switches Ollama from expert-aware placement
        (MoE experts to RAM first) to a plain layer split, which is much slower.
        """
        self.request("/api/generate", {
            "model": self.cfg["model"],
            "prompt": "",
            "keep_alive": -1,
            "options": {"num_ctx": int(self.cfg["context_length"])},
        }, timeout=900)

    def loaded(self):
        try:
            return self.request("/api/ps").get("models", [])
        except Exception:
            return None

    def is_moe(self, model):
        """True if the model is mixture-of-experts (its GGUF metadata has an expert count)."""
        try:
            info = self.request("/api/show", {"model": model}, timeout=10).get("model_info", {})
        except Exception:
            return False
        return any(k.endswith(".expert_count") and v for k, v in info.items())


def placement_note(ollama, model, share):
    """(is_problem, message) describing how much of the model is in VRAM."""
    if share is None or share >= 100:
        return False, ""
    if share == 0:
        return True, ("the model is running entirely on the CPU, so the GPU backend isn't "
                      "working. Run gpu-yield doctor; if it doesn't show a fix, try the other "
                      "backend: gpu-yield setup --backend vulkan --reinstall")
    if ollama.is_moe(model):
        return False, (f"{100 - share}% of this mixture-of-experts model is in system RAM. "
                       "That's expected for models bigger than VRAM: expert weights go to RAM "
                       "first, so generation stays usable, but long prompts are processed "
                       "more slowly.")
    return True, (f"{100 - share}% of this dense model spilled to system RAM, so it will be slow. "
                  "Lower context_length or pick a smaller model.")


def same_model(a, b):
    """Ollama reports "qwen3.5" as "qwen3.5:latest"; treat the two as the same model."""
    def norm(n):
        n = n.strip().lower()
        return n if ":" in n.rsplit("/", 1)[-1] else n + ":latest"
    return norm(a) == norm(b)


def write_status_file(status):
    try:
        STATUS_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATUS_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(status, indent=1))
        os.replace(tmp, STATUS_FILE)
    except OSError:
        pass


def gpu_share(models):
    """Percent of the loaded model that sits in VRAM (100 = fully on the GPU)."""
    if not models:
        return None
    size = sum(m.get("size", 0) for m in models)
    vram = sum(m.get("size_vram", 0) for m in models)
    return round(100 * vram / size) if size else None


def http_error_detail(e):
    try:
        return json.loads(e.read()).get("error") or str(e)
    except Exception:
        return str(e)


# ---------------------------------------------------------------------------- stand-in

class StandIn:
    """Answers every request with 503 + a reason while Ollama is down.

    /v1/* gets an OpenAI-style error body (what Hermes reads); everything else gets
    Ollama's native {"error": "..."} shape. Retry-After tells clients when to come back.
    """

    def __init__(self, port):
        self.port = port
        self.server = None
        self.message = "AI server is paused."
        self.retry_after = 60

    def start(self):
        if self.server:
            return True
        owner = self

        class Handler(BaseHTTPRequestHandler):
            server_version = APP
            protocol_version = "HTTP/1.1"
            timeout = 5            # don't let idle client connections pin threads

            def log_message(self, *args):
                pass

            def _reply(self):
                # One request per connection: a client that keeps a connection open must
                # not keep talking to the stand-in after the real Ollama is back.
                self.close_connection = True
                try:
                    length = int(self.headers.get("Content-Length") or 0)
                except ValueError:
                    length = 0
                if length:
                    self.rfile.read(min(length, 50_000_000))
                if self.path.startswith("/v1"):
                    body = {"error": {"message": owner.message, "type": "server_error",
                                      "code": "gpu_busy"}}
                else:
                    body = {"error": owner.message}
                data = json.dumps(body).encode()
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Retry-After", str(int(owner.retry_after)))
                self.send_header("Connection", "close")
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(data)

            do_GET = do_POST = do_PUT = do_DELETE = do_HEAD = do_OPTIONS = do_PATCH = _reply

        last = None
        for _ in range(30):  # the port can take a moment to free up after Ollama exits
            try:
                server = ThreadingHTTPServer(("0.0.0.0", self.port), Handler)
                break
            except OSError as e:
                last = e
                time.sleep(0.5)
        else:
            log(f"stand-in could not bind port {self.port}: {last}")
            return False
        server.daemon_threads = True
        self.server = server
        threading.Thread(target=server.serve_forever, name="stand-in", daemon=True).start()
        return True

    def stop(self):
        if self.server:
            self.server.shutdown()
            self.server.server_close()
            self.server = None


