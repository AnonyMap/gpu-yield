def cmd_status(args):
    if args.host:
        host, port = split_host(args.host)
        try:
            st = fetch_remote_status(host, port)
        except OSError as e:
            die(f"can't reach {host}:{port} ({getattr(e, 'reason', e)}). If it's asleep, "
                f"wake it with: gpu-yield wake {args.host}")
        remember_host(args.host, st)
        print(f"Host:     {st.get('host')} ({host}), gpu-yield {st.get('version')}")
        print_status(st)
        return
    active = user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0
    st = read_status()
    print(f"Watcher:  {'running' if active else 'NOT running'}"
          + ("" if active else f"   (start: systemctl --user start {WATCHER_UNIT})"))
    if not st:
        print("No status yet.")
        return
    stale = time.time() - st.get("updated", 0) > 30
    print_status(st, "   (stale: last update " + ago(time.time() - st['updated']) + " ago)"
                 if stale else "")
    if st.get("version") and st["version"] != VERSION:
        print(f"Version:  watcher runs {st['version']}, this command is {VERSION} "
              f"(apply with: systemctl --user restart {WATCHER_UNIT})")
    if PAUSE_FILE.exists():
        print("Paused:   yes (gpu-yield resume to undo)")


def print_status(st, suffix=""):
    print(f"State:    {STATE_TEXT.get(st.get('state'), st.get('state'))}"
          f" for {ago(time.time() - st.get('since', time.time()))}{suffix}")
    if st.get("games"):
        print(f"Games:    {', '.join(st['games'])}")
    if st.get("cooldown_remaining") is not None:
        print(f"Resumes:  in {st['cooldown_remaining']}s")
    if st.get("state") == "config_error":
        print(f"Fix:      gpu-yield doctor shows the error; edit {CONFIG_FILE}")
    elif st.get("model"):
        print(f"Model:    {st['model']} @ {st.get('context_length')} ctx: {st.get('model_status')}")
    else:
        print("Model:    none chosen (run: gpu-yield model)")
    if st.get("in_use"):
        print("Used:     right now")
    elif st.get("last_used"):
        print(f"Used:     {ago(time.time() - st['last_used'])} ago")
    if st.get("notice"):
        print(f"Note:     {st['notice']}")


# --- other computers: remote status and wake-up

MAC_RE = re.compile(r"^[0-9a-f]{2}([:-][0-9a-f]{2}){5}$", re.I)
HOSTS_FILE = CACHE_DIR / "hosts.json"


def split_host(target):
    host, _, port = target.partition(":") if target.count(":") == 1 else (target, "", "")
    return host, int(port) if port else DEFAULTS["status_port"]


def fetch_remote_status(host, port, timeout=4):
    req = urllib.request.Request(f"http://{host}:{port}/status",
                                 headers={"User-Agent": f"{APP}/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def load_hosts():
    try:
        return json.loads(HOSTS_FILE.read_text())
    except (OSError, ValueError):
        return {}


def remember_host(target, st):
    """Cache what we need to wake this PC later, while it's awake to tell us."""
    hosts = load_hosts()
    entry = hosts.get(target, {})
    if st.get("mac"):
        entry["mac"] = st["mac"]
    try:
        entry["ip"] = socket.gethostbyname(split_host(target)[0])
    except OSError:
        pass
    hosts[target] = entry
    try:
        HOSTS_FILE.parent.mkdir(parents=True, exist_ok=True)
        HOSTS_FILE.write_text(json.dumps(hosts, indent=1))
    except OSError:
        pass


def magic_packet(mac):
    return b"\xff" * 6 + bytes.fromhex(re.sub(r"[:-]", "", mac)) * 16


def send_magic_packet(mac, ip=None):
    targets = {"255.255.255.255"}
    if ip:
        targets.add(ip.rsplit(".", 1)[0] + ".255")   # the usual /24 home network
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for addr in targets:
            for port in (9, 7):
                try:
                    s.sendto(magic_packet(mac), (addr, port))
                except OSError:
                    pass


def cmd_wake(args):
    hosts = load_hosts()
    target = args.target or (next(iter(hosts)) if len(hosts) == 1 else None)
    if not target:
        die("which PC? gpu-yield wake HOSTNAME (or its MAC address, like 1c:2b:...)")
    if MAC_RE.match(target):
        send_magic_packet(target)
        print(f"Wake-up packet sent to {target}.")
        return
    host, port = split_host(target)
    try:
        st = fetch_remote_status(host, port, timeout=2)
        remember_host(target, st)
        print(f"{host} is already awake ({STATE_TEXT.get(st.get('state'), st.get('state'))}).")
        return
    except OSError:
        pass
    info = hosts.get(target, {})
    if not info.get("mac"):
        die(f"don't know {host}'s network card address yet. While it's awake, run once:\n"
            f"  gpu-yield status --host {target}\n"
            f"or pass the address directly: gpu-yield wake AA:BB:CC:DD:EE:FF "
            f"(shown by gpu-yield wol on that PC)")
    send_magic_packet(info["mac"], info.get("ip"))
    print(f"Wake-up packet sent to {host} ({info['mac']}).")
    if args.no_wait:
        return
    print("Waiting for it to come up", end="", flush=True)
    end = time.time() + 120
    while time.time() < end:
        time.sleep(3)
        print(".", end="", flush=True)
        try:
            st = fetch_remote_status(host, port, timeout=2)
        except OSError:
            continue
        print(f" awake ({STATE_TEXT.get(st.get('state'), st.get('state'))}).")
        return
    print()
    die(f"no answer from {host} after 2 minutes. On that PC, check Wake-on-LAN with "
        "gpu-yield wol, and that it's enabled in the BIOS/UEFI.")


def wol_state(dev):
    """(supported modes, current mode) from ethtool, e.g. ("pumbg", "g"); Nones if unknown."""
    if not shutil.which("ethtool"):
        return None, None
    out = run(["ethtool", dev]).stdout
    sup = re.search(r"Supports Wake-on:\s*(\S+)", out)
    cur = re.search(r"^\s*Wake-on:\s*(\S+)", out, re.M)
    return (sup.group(1) if sup else None), (cur.group(1) if cur else None)


def enable_wol(args):
    dev, mac, wireless = nic_info()
    if not dev:
        warn("no network connection found")
        return
    if wireless:
        log(f"  {dev} is Wi-Fi; Wake-on-LAN generally needs a wired connection. Skipped.")
        return
    supported, current = wol_state(dev)
    if supported is not None and "g" not in supported:
        log(f"  {dev}'s network card doesn't support Wake-on-LAN")
        return
    if current and "g" in current:
        log(f"  already on for {dev} ({mac})")
        return
    if not ask(f"Turn on Wake-on-LAN for {dev}, so your other computers can wake this PC? "
               "Needs sudo.", args):
        return
    conn = run(["nmcli", "-g", "GENERAL.CONNECTION", "device", "show", dev]).stdout.strip()
    saved = bool(conn) and sudo(["nmcli", "connection", "modify", conn,
                                 "802-3-ethernet.wake-on-lan", "magic"])
    now = shutil.which("ethtool") and sudo(["ethtool", "-s", dev, "wol", "g"])
    if saved or now:
        log(f"  Wake-on-LAN on for {dev} ({mac})" + ("" if saved else " until the next reboot")
            + ("" if now else "; takes effect after a reboot"))
        log("  If waking doesn't work, also enable \"Wake on LAN\" / \"Power on by PCI-E\" "
            "in the BIOS/UEFI.")
    else:
        warn("couldn't turn on Wake-on-LAN")


def cmd_wol(args):
    dev, mac, wireless = nic_info()
    print(f"Network:  {dev or 'none'}" + (" (Wi-Fi)" if wireless else "") + (f", MAC {mac}" if mac else ""))
