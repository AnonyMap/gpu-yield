def fmt_setting(value):
    if isinstance(value, bool):
        return str(value).lower()
    if isinstance(value, (str, list, dict)):
        return json.dumps(value)
    return str(value)


def cmd_config(args):
    if not CONFIG_FILE.exists():
        die("no config yet; run: gpu-yield setup")
    if args.key is None:
        cfg = load_config()
        print(f"Settings ({CONFIG_FILE}):")
        for k in DEFAULTS:
            if k == "ollama_env":
                continue
            v = ('"(set)"' if cfg[k] else '""') if k in SECRET_SETTINGS else fmt_setting(cfg[k])
            if k == "backend" and cfg[k] == "auto":
                v += f"  (currently {resolve_backend(cfg)})"
            print(f"  {k:<22} {v}" + ("" if cfg[k] == DEFAULTS[k] else "   *changed"))
        for k, v in cfg["ollama_env"].items():
            print(f"  {'env.' + k:<22} {json.dumps(v)}")
        print("\nChange a setting:   gpu-yield config KEY VALUE")
        print("Ollama variables:   gpu-yield config env.NAME VALUE   (\"\" removes it)")
        print("Lists take commas:  gpu-yield config extra_processes \"game1,game2.exe\"")
        return
    key = args.key
    if args.value is None:
        cfg = load_config()
        if key.startswith("env."):
            print(json.dumps(cfg["ollama_env"].get(key[4:], "")))
        elif key in DEFAULTS:
            print(('"(set)"' if cfg[key] else '""') if key in SECRET_SETTINGS else fmt_setting(cfg[key]))
        else:
            die(f"unknown setting {key!r}; run gpu-yield config to list them")
        return
    if key == "model":
        die(f"use: gpu-yield model {args.value}   (it downloads the model as well)")
    if key == "ollama_env" or (key not in DEFAULTS and not key.startswith("env.")):
        die(f"unknown setting {key!r}; run gpu-yield config to list them")
    if key in SECRET_SETTINGS and args.value not in ("-", ""):
        # On the command line, other users can see it while it runs, and it's kept in
        # your shell history.
        die(f"type it at a prompt instead: gpu-yield config {key} -   (nothing changed)")
    if key in SECRET_SETTINGS and args.value == "-":
        # Typed at a prompt, so it stays out of shell history and process listings.
        import getpass
        if not sys.stdin.isatty():
            args.value = sys.stdin.readline().rstrip("\n")
        else:
            args.value = getpass.getpass(f"{key} (input hidden" + (
                "; press Enter to make up a strong one): " if key == "control_password" else "): "))
        if not args.value and key == "control_password":
            import secrets
            args.value = secrets.token_urlsafe(15)
            print(f"Generated password: {args.value}\n(Saved in the browser after you enter it "
                  "once on the status page.)")
    if key == "control_password" and args.value and len(args.value) < 8:
        die("use at least 8 characters for the control password; nothing changed")
    if key.startswith("env."):
        # llama-server stops on a value it can't read, and then no model loads at all.
        name, value = key[4:], args.value.strip()
        if value and name in ("LLAMA_ARG_CACHE_RAM", "LLAMA_ARG_CTX_CHECKPOINTS") and \
                not re.fullmatch(r"-?\d+", value):
            die(f"{name} must be a whole number (MiB for the cache; -1 means no limit); "
                "nothing changed")
        if value and name == "LLAMA_ARG_LOAD_MODE" and \
                value not in ("auto", "none", "mmap", "mlock", "mmap+mlock", "dio"):
            die("LLAMA_ARG_LOAD_MODE must be one of auto, none, mmap, mlock, mmap+mlock, dio; "
                "nothing changed")
        cfg = change_settings(env=(key[4:], args.value))
    else:
        try:
            value = parse_setting(key, args.value)
        except ValueError as e:
            die(f"{e}; nothing changed")
        cfg = change_settings({key: value})
    shown = json.dumps(cfg["ollama_env"].get(key[4:], "")) if key.startswith("env.") \
        else ('"(set)"' if cfg[key] else '""') if key in SECRET_SETTINGS else fmt_setting(cfg[key])
    print(f"{key} = {shown}")
    running = user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0
    if running and key in LIVE_SETTINGS:
        print("Applied within a few seconds; the AI keeps running.")
    elif running:
        user_systemctl("restart", WATCHER_UNIT)
        print("Applied (watcher restarted; the model reloads in a moment).")
    if key == "context_length":
        print(f"Set context_length and ollama_num_ctx to {cfg[key]} in Hermes's config too.")
    elif key == "backend":
        print("The ROCm backend is a separate download: if it isn't installed yet, Ollama keeps "
              "using Vulkan until you run: gpu-yield setup --reinstall")
    elif key == "status_page":
        print(f"Status page: http://{socket.gethostname()}:{cfg['status_port']}/" if page_port(cfg)
              else "Status page off. gpu-yield status still works on this PC; status --host "
                   "and wake from other PCs need the page.")
    elif key in ("port", "status_port"):
        print("If the firewall is on, open the new port with: gpu-yield firewall")
    elif key == "control_password":
        print(f"Controls on the status page are {'on' if cfg[key] else 'off'}"
              + (f": http://{socket.gethostname()}:{cfg['status_port']}/" if page_port(cfg)
                 else ", but the page itself is off (gpu-yield config status_page true)"))


