    return f"""\
# ~/.hermes/config.yaml on the other computer
model:
  default: {cfg['model'] or '<the model you choose with gpu-yield model>'}
  provider: custom
  base_url: http://{ip or '<this-pc-ip>'}:{cfg['port']}/v1
  context_length: {cfg['context_length']}
  ollama_num_ctx: {cfg['context_length']}"""


def cmd_setup(args):
    if os.geteuid() == 0:
        die("run setup as your normal user, not with sudo (it asks for sudo when needed)")
    if tomllib is None:
        die("Python 3.11+ is required")
    if user_systemctl("show-environment").returncode:
        die("cannot reach the systemd user manager")

    log("1/7 Config")
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_FILE.exists():
        CONFIG_FILE.write_text(CONFIG_TEMPLATE)
        log(f"  wrote {CONFIG_FILE}")
    overrides = {k: v for k, v in (("model", args.model), ("context_length", args.context),
                                   ("backend", args.backend)) if v is not None}
    if overrides:
        set_config_values(overrides)
    cfg = load_config()
    if not cfg["model"]:
        choice = choose_model(args)
        if choice:
            set_config_values({"model": choice})
            cfg = load_config()
    managed = cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT
    log(f"  model {cfg['model'] or 'none yet'}, context {cfg['context_length']}, "
        f"backend {cfg['backend']}")

    log("2/7 Checking for other Ollama installs")
    check_conflicts(args)

    log("3/7 Ollama")
    if user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0:
        user_systemctl("stop", WATCHER_UNIT)
    if not managed:
        log(f"  using your own unit {cfg['ollama_unit']}")
    elif OLLAMA_BIN.exists() and not args.reinstall:
        log(f"  already installed at {OLLAMA_DIR} (--reinstall to update)")
    else:
        install_ollama(cfg["backend"])

    log("4/7 Services")
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    me = Path(__file__).resolve()
    if me != BIN_PATH.resolve():
        shutil.copy2(me, BIN_PATH)
    BIN_PATH.chmod(0o755)
    write_unit(WATCHER_UNIT, watcher_unit_text())
    ensure_ollama_unit(cfg)
    user_systemctl("daemon-reload")
    r = user_systemctl("enable", "--now", WATCHER_UNIT)
    if r.returncode:
        die(f"could not start the watcher: {r.stderr.strip()}")
    enable_linger(args)
    log(f"  watcher running; installed as {BIN_PATH}")

    log("5/7 Firewall")
    if args.no_firewall:
        log("  skipped")
    else:
        setup_firewall(cfg, args)

    log("6/7 Model")
    if not cfg["model"]:
        log("  none chosen; pick one any time with: gpu-yield model")
    elif args.skip_pull:
        log("  skipped")
    elif not Ollama(cfg).wait_ready(60):
        st = read_status() or {}
        warn(f"Ollama isn't up (state: {STATE_TEXT.get(st.get('state'))}). "
             f"Download the model later with: gpu-yield model {cfg['model']}")
    else:
        pull_and_load(cfg, cfg["model"])

    log("7/7 Done\n")
    print(hermes_snippet(cfg))
    print(f"""
Useful commands:
  gpu-yield status      gpu-yield doctor
  gpu-yield pause       gpu-yield resume
  journalctl --user -u gpu-yield -f
Config: {CONFIG_FILE}  (then: systemctl --user restart gpu-yield)""")


def cmd_uninstall(args):
    user_systemctl("disable", "--now", WATCHER_UNIT)
    user_systemctl("stop", MANAGED_OLLAMA_UNIT)
    for unit in (WATCHER_UNIT, MANAGED_OLLAMA_UNIT):
        (UNIT_DIR / unit).unlink(missing_ok=True)
    user_systemctl("daemon-reload")
    BIN_PATH.unlink(missing_ok=True)
    link = BIN_DIR / "ollama"
    if link.is_symlink() and str(OLLAMA_DIR) in os.readlink(link):
        link.unlink()
    print("Services removed.")
    if args.purge:
        for d in (OLLAMA_DIR, CONFIG_DIR, STATE_DIR, CACHE_DIR):
            shutil.rmtree(d, ignore_errors=True)
        print("Ollama install, config and state removed.")
    print(f"Downloaded models are kept in {HOME / '.ollama/models'} (delete it to free the space).")
    print("If setup opened the firewall: sudo firewall-cmd --permanent --list-rich-rules, then "
          "--remove-rich-rule='<rule>' and sudo firewall-cmd --reload")


# --- update

def parse_version(text):
    try:
        return tuple(int(x) for x in text.strip().lstrip("v").split("-")[0].split("."))
    except ValueError:
        return (0,)


def declared_version(source):
    m = re.search(rb'^VERSION = "([^"]+)"', source, re.M)
    return m.group(1).decode() if m else None


def github_get(cfg, path, raw=False, timeout=30):
    headers = {
        "User-Agent": f"{APP}/{VERSION}",
        "Accept": "application/vnd.github.raw" if raw else "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if cfg["github_token"]:
        headers["Authorization"] = f"Bearer {cfg['github_token']}"
    req = urllib.request.Request(GITHUB_API + path, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def fetch_latest(cfg):
    repo = cfg["update_repo"] or BUILTIN_REPO
    if not repo:
        die("no update source: set update_repo = \"owner/name\" in " + str(CONFIG_FILE))
    branch = cfg["update_branch"]
    try:
        data = github_get(cfg, f"/repos/{repo}/contents/{APP}?ref={branch}", raw=True)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            die(f"{APP} not found in {repo} on branch {branch}. "
                "If the repo is private, set github_token in the config.")
        if e.code in (401, 403):
            die(f"GitHub refused the request ({e.code}: {http_error_detail(e)}). Check "
                "github_token; without one GitHub allows 60 requests an hour.")
        die(f"GitHub error {e.code}: {http_error_detail(e)}")
    except urllib.error.URLError as e:
        die(f"could not reach GitHub: {e.reason}")
    return repo, data


def install_script(source, label):
    """Validate a gpu-yield script, swap it in atomically, and let it migrate itself."""
    version = declared_version(source)
    if not version:
        die(f"{label} doesn't look like gpu-yield (no VERSION line); nothing changed")
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    tmp = BIN_DIR / f".{APP}.new"
    tmp.write_bytes(source)
    tmp.chmod(0o755)
    check = run([sys.executable, str(tmp), "--version"])
    if check.returncode or check.stdout.strip() != version:
        tmp.unlink(missing_ok=True)
        die(f"{label} failed its self-test, so nothing changed:\n{check.stderr.strip()[-800:]}")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    installed = declared_version(BIN_PATH.read_bytes()) if BIN_PATH.exists() else None
    # Keep the backup pointing at a genuinely different version: reinstalling the same
    # version (--force, or --file with an equal number) must not overwrite it.
    if installed and installed != version:
        shutil.copy2(BIN_PATH, PREVIOUS_FILE)
    os.replace(tmp, BIN_PATH)
    # The NEW code rewrites its own units and restarts the watcher, so changes to the
    # service files in a release take effect without re-running setup. Versions before
    # 1.1 have no _post-update step; restart the watcher directly for those.
    post = run([sys.executable, str(BIN_PATH), "_post-update"])
    if post.returncode == 0:
        print(post.stdout, end="", flush=True)
    else:
        user_systemctl("daemon-reload")
        if user_systemctl("is-enabled", "--quiet", WATCHER_UNIT).returncode == 0:
            user_systemctl("restart", WATCHER_UNIT)
    return version


def cmd_post_update(args):
    try:
        cfg = load_config()
    except SystemExit:
        cfg = None          # the watcher itself waits safely for a broken config to be fixed
    write_unit(WATCHER_UNIT, watcher_unit_text())
    if cfg:
        ensure_ollama_unit(cfg)
    user_systemctl("daemon-reload")
    if user_systemctl("is-enabled", "--quiet", WATCHER_UNIT).returncode == 0:
        user_systemctl("restart", WATCHER_UNIT)
        log("watcher restarted on the new version (the model reloads in a moment)")


def ollama_versions(cfg):
    installed = latest = None
    if OLLAMA_BIN.exists():
        m = re.search(r"(\d+\.\d+\.\d+)", run([str(OLLAMA_BIN), "--version"]).stdout)
        installed = m.group(1) if m else None
    try:
        latest = json.loads(github_get(cfg, "/repos/ollama/ollama/releases/latest"))["tag_name"].lstrip("v")
    except Exception:
        pass
    return installed, latest


def update_from_file(path):
    src = Path(path).expanduser()
    if not src.is_file():
        die(f"no such file: {src}")
    if BIN_PATH.exists() and src.resolve() == BIN_PATH.resolve():
        die(f"{src} is the installed copy; point --file at the new version instead")
    source = src.read_bytes()
    version = declared_version(source)
    if not version:
        die(f"{src} doesn't look like gpu-yield (no VERSION line); nothing changed")
    if parse_version(version) < parse_version(VERSION):
        log(f"note: {src} is version {version}, older than the installed {VERSION} (installing it anyway)")
    elif parse_version(version) == parse_version(VERSION):
        log(f"note: {src} has the same version number as the installed copy ({VERSION})")
    log(f"installing gpu-yield {version} from {src}")
    install_script(source, str(src))
    log(f"gpu-yield is now {version}. Undo with: gpu-yield rollback")


def cmd_update(args):
    if os.geteuid() == 0:
        die("run as your normal user, not with sudo")
    if args.file:
        update_from_file(args.file)
        return
    cfg = load_config()
    repo, source = fetch_latest(cfg)
    latest = declared_version(source)
    if not latest:
        die(f"the {APP} file in {repo} has no VERSION line")
    newer = parse_version(latest) > parse_version(VERSION)

    managed = cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT
    o_installed, o_latest = ollama_versions(cfg) if managed else (None, None)
    o_newer = bool(o_installed and o_latest and parse_version(o_latest) > parse_version(o_installed))

    if args.check:
        print(f"gpu-yield: installed {VERSION}, latest {latest} in {repo}"
              + ("  -> update available" if newer else "  (up to date)"))
        if managed:
            print(f"Ollama:    installed {o_installed or '?'}, latest {o_latest or '?'}"
                  + ("  -> run: gpu-yield update --ollama" if o_newer else ""))
        return

    if newer or args.force:
        log(f"updating gpu-yield {VERSION} -> {latest} from {repo}")
        install_script(source, f"version {latest} from {repo}")
        log(f"gpu-yield is now {latest}. Undo with: gpu-yield rollback")
    else:
        log(f"gpu-yield {VERSION} is up to date")

    if args.ollama:
        if not managed:
            log("Ollama is managed outside gpu-yield; update it the way you installed it")
        elif not o_newer and not args.force:
            log(f"Ollama {o_installed} is up to date")
        else:
            log(f"updating Ollama {o_installed} -> {o_latest} (backend {cfg['backend']})")
            user_systemctl("stop", WATCHER_UNIT)
            try:
                install_ollama(cfg["backend"])
            finally:
                user_systemctl("start", WATCHER_UNIT)
    elif o_newer:
        log(f"Ollama {o_latest} is available (you have {o_installed}): gpu-yield update --ollama")


def cmd_rollback(args):
    if not PREVIOUS_FILE.exists():
        die("no previous version saved; rollback only works after an update")
    source = PREVIOUS_FILE.read_bytes()
    target = declared_version(source)
    current = BIN_PATH.read_bytes() if BIN_PATH.exists() else None
    log(f"rolling back gpu-yield {VERSION} -> {target}")
    install_script(source, "the saved previous version")
    if current:                       # so a second rollback undoes the first
        PREVIOUS_FILE.write_bytes(current)
    log(f"gpu-yield is now {target}")


def main():
    if sys.argv[1:2] == ["_post-update"]:   # internal step run by the new version after an update
        return cmd_post_update(None)
    p = argparse.ArgumentParser(prog=APP, description="Run Ollama while the GPU is idle; "
                                "stop it whenever a Steam game runs.")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("setup", help="install Ollama, this tool and its services")
    s.add_argument("--model", help="model to keep loaded (asks if not given)")
    s.add_argument("--context", type=int, help="context length in tokens (default 65536)")
    s.add_argument("--backend", choices=["rocm", "vulkan"], help="GPU backend (default rocm)")
    s.add_argument("--reinstall", action="store_true", help="re-download Ollama (updates it)")
    s.add_argument("--skip-pull", action="store_true", help="don't download the model")
    s.add_argument("--no-firewall", action="store_true", help="don't touch the firewall")
    s.add_argument("-y", "--yes", action="store_true", help="accept all prompts")
    s.set_defaults(func=cmd_setup)
    for name, fn, text in (("run", cmd_run, "run the watcher (systemd does this)"),
                           ("status", cmd_status, "show the current state"),
                           ("pause", cmd_pause, "keep the AI off until resume"),
                           ("resume", cmd_resume, "undo pause"),
                           ("doctor", cmd_doctor, "check the setup")):
        sub.add_parser(name, help=text).set_defaults(func=fn)
    up = sub.add_parser("update", help="update gpu-yield from GitHub (and optionally Ollama)")
    up.add_argument("--file", metavar="PATH", help="install from a local file instead of GitHub")
    up.add_argument("--check", action="store_true", help="only report what's available")
    up.add_argument("--ollama", action="store_true", help="also update Ollama")
    up.add_argument("--force", action="store_true", help="reinstall even if up to date")
    up.set_defaults(func=cmd_update)
    m = sub.add_parser("model", help="choose or change the model (downloads it)")
    m.add_argument("name", nargs="?", help="Ollama model name; omit to pick from a list")
    m.set_defaults(func=cmd_model)
    sub.add_parser("rollback", help="go back to the version before the last update") \
        .set_defaults(func=cmd_rollback)
    u = sub.add_parser("uninstall", help="remove the services")
    u.add_argument("--purge", action="store_true", help="also remove Ollama, config and state")
    u.set_defaults(func=cmd_uninstall)
    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
