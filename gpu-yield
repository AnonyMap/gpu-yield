# --- other computers: remote status and wake-up

MAC_RE = re.compile(r"^[0-9a-f]{2}([:-][0-9a-f]{2}){5}$", re.I)
HOSTS_FILE = CACHE_DIR / "hosts.json"


def split_host(target):
    """"pc", "pc:11435", "http://pc:11435/", "[fd00::5]:11435" -> (host, port)."""
    t = re.sub(r"^[a-z][a-z0-9+.-]*://", "", target.strip(), flags=re.I).split("/", 1)[0]
    m = re.fullmatch(r"\[([^\]]+)\](?::(.*))?", t)
    if m:
        host, port = m.group(1), m.group(2)
    elif t.count(":") == 1:
        host, port = t.split(":")
    else:
        host, port = t, None                      # plain name, or a bare IPv6 address
    if not host:
        raise ValueError(f"no host name in {target!r}")
    if port is not None and not (port.isdigit() and 0 < int(port) < 65536):
        raise ValueError(f"{port!r} isn't a port number")
    return host, int(port) if port else DEFAULTS["status_port"]


def host_key(host, port):
    """How a PC is stored in the wake cache: just the name unless the port is unusual."""
    if port == DEFAULTS["status_port"]:
        return host
    return f"[{host}]:{port}" if ":" in host else f"{host}:{port}"


REMOTE_MAX = 2**20


def clean_text(value):
    """Remote text, safe to print: no escape sequences or other control characters (they
    could retitle the terminal, write to the clipboard, or fake output)."""
    import unicodedata
    return "".join(c for c in value if not unicodedata.category(c).startswith("C"))


def _clean(value):
    if isinstance(value, str):
        return clean_text(value)
    if isinstance(value, list):
        return [_clean(v) for v in value]
    if isinstance(value, dict):
        return {clean_text(str(k)): _clean(v) for k, v in value.items()}
    return value


def fetch_remote_status(host, port, timeout=4):
    """Another PC's /status, checked: at most 1 MiB within `timeout` seconds, a JSON
    object, and every string stripped of control characters. ValueError otherwise."""
    shown = f"[{host}]" if ":" in host else host
    req = urllib.request.Request(f"http://{shown}:{port}/status",
                                 headers={"User-Agent": f"{APP}/{VERSION}"})
    end = time.monotonic() + timeout
    data = b""
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            while True:
                chunk = r.read1(65536) if hasattr(r, "read1") else r.read(65536)
                if not chunk:
                    break
                data += chunk
                if len(data) > REMOTE_MAX:
                    raise ValueError("the reply is too large to be a gpu-yield status")
                if time.monotonic() > end:
                    raise ValueError("the reply took too long")
    except http.client.HTTPException as e:     # something that isn't a web server
        raise ValueError(f"that port doesn't answer like a web page ({e!r})") from None
    try:
        st = json.loads(data)
        if not isinstance(st, dict) or not ("state" in st or "version" in st):
            raise ValueError("the reply isn't a gpu-yield status")
        st = _clean(st)
    except RecursionError:
        raise ValueError("the reply is nested too deeply to be a gpu-yield status") from None
    if st.get("mac") is not None and not (isinstance(st["mac"], str) and MAC_RE.match(st["mac"])):
        st["mac"] = None
    return st


def refused(e):
    """The PC answered but nothing listens on the port: it's awake, the page is just off."""
    return isinstance(getattr(e, "reason", e), ConnectionRefusedError)


def load_hosts():
    try:
        return json.loads(HOSTS_FILE.read_text())
    except (OSError, ValueError):
        return {}


def remember_host(host, port, st):
    """Cache what we need to wake this PC later, while it's awake to tell us."""
    hosts = load_hosts()
    key = host_key(host, port)
    entry = hosts.get(key, {})
    if st.get("mac"):
        entry["mac"] = st["mac"]
        entry.pop("redacted", None)
    elif st.get("redacted"):
        entry["redacted"] = True       # this name gets only the public status
    try:
        entry["ip"] = socket.gethostbyname(host)
    except OSError:
        pass
    hosts[key] = entry
    try:
        HOSTS_FILE.parent.mkdir(parents=True, exist_ok=True)
        HOSTS_FILE.write_text(json.dumps(hosts, indent=1))
    except OSError:
        pass


def magic_packet(mac):
    return b"\xff" * 6 + bytes.fromhex(re.sub(r"[:-]", "", mac)) * 16


def send_magic_packet(mac, ip=None):
    targets = {"255.255.255.255"}
    if ip:
        targets.add(ip.rsplit(".", 1)[0] + ".255")   # the usual /24 home network
        targets.add(ip)    # direct too: some Wi-Fi routers drop broadcasts to sleeping clients
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for addr in targets:
            for port in (9, 7):
                try:
                    s.sendto(magic_packet(mac), (addr, port))
                except OSError:
                    pass


def cmd_wake(args):
    """Wake a PC and wait until its AI answers (not just the PC): exit 0 when the AI is
    ready, 1 when the PC is up but the AI isn't available (a game, a pause) or never
    came up, so `gpu-yield wake pc && my-ai-script` does what it says."""
    hosts = load_hosts()
    target = args.target or (next(iter(hosts)) if len(hosts) == 1 else None)
    if not target:
        die("which PC? gpu-yield wake HOSTNAME (or its MAC address, like 1c:2b:...)")
    if MAC_RE.match(target):
        send_magic_packet(target)
        print(f"Wake-up packet sent to {target}.")
        return
    try:
        host, port = split_host(target)
    except ValueError as e:
        die(str(e))

    def probe():
        """("status", st), ("refused", None) or ("silent", None)."""
        try:
            st = fetch_remote_status(host, port, timeout=2)
            remember_host(host, port, st)
            return "status", st
        except OSError as e:
            return ("refused" if refused(e) else "silent"), None
        except ValueError:
            return "silent", None

    kind, st = probe()
    if kind == "refused":
        print(f"{host} is already awake (its status page is off or gpu-yield isn't running).")
        return
    if kind == "silent":
        info = hosts.get(host_key(host, port), {})
        if not info.get("mac") and info.get("redacted"):
            die(f"{host} isn't that PC's own name, so it doesn't share its network card "
                "address under it. While it's awake, run once with its IP address or its own "
                "name (like NAME.local):\n  gpu-yield status --host <IP or NAME.local>\n"
                "or pass the address directly: gpu-yield wake AA:BB:CC:DD:EE:FF")
        if not info.get("mac"):
            die(f"don't know {host}'s network card address yet. While it's awake, run once:\n"
                f"  gpu-yield status --host {target}\n"
                f"or pass the address directly: gpu-yield wake AA:BB:CC:DD:EE:FF "
                f"(shown by gpu-yield wol on that PC)")
        send_magic_packet(info["mac"], info.get("ip"))
        print(f"Wake-up packet sent to {host} ({info['mac']}).")
        if args.no_wait:
            return
    elif args.no_wait or st.get("ai_available"):
        print(f"{host} is already awake ({STATE_TEXT.get(st.get('state'), st.get('state'))}).")
        return
    # Up to 2 minutes for the PC to come up, then up to 3 more for the model to load.
    print("Waiting for the AI to be ready", end="", flush=True)
    start, seen_up, answered = time.time(), kind == "status", False
    while time.time() < start + (300 if seen_up else 120):
        if kind == "status":
            seen_up = True
            state = st.get("state")
            if st.get("ai_available"):
                print(f" ready ({st.get('model_status') or STATE_TEXT.get(state)}).")
                return
            if state in ("gaming", "paused", "config_error"):
                print(f" {host} is awake, but the AI isn't available: {STATE_TEXT.get(state, state)}.")
                sys.exit(1)
            status = str(st.get("model_status") or "")
            if state == "ai" and status.startswith(("failed", "no model")):
                print(f" {host} is awake, but the model isn't loading: {status}")
                sys.exit(1)
        answered = answered or kind == "refused"
        time.sleep(3)
        print(".", end="", flush=True)
        kind, st = probe()
    print()
    if seen_up:
        die(f"{host} is awake, but the AI still isn't ready ({(st or {}).get('model_status') or 'no answer'}); "
            f"see: gpu-yield status --host {target}")
    if answered:
        print(f"{host} is awake, but its status page never answered: it's turned off there, "
              "or gpu-yield isn't running.")
        return
    die(f"no answer from {host} after 2 minutes. On that PC, check Wake-on-LAN with "
        "gpu-yield wol, and that it's enabled in the BIOS/UEFI.")


def nm_connection(dev):
    """NetworkManager connection UUID for a device ("" if unknown). UUIDs, unlike names,
    need no escaping."""
    if not shutil.which("nmcli"):
        return ""
    return run(["nmcli", "-g", "GENERAL.CON-UUID", "device", "show", dev]).stdout.strip()


def wifi_phy(dev):
    return _read_text(Path(f"/sys/class/net/{dev}/phy80211/name")).strip() or None


def wol_state(dev, wireless=False):
    """(supported, current) wake modes: "g" means wake on a magic packet. Wired cards are
    read with ethtool ("pumbg", "g"); Wi-Fi cards with iw (Wake on Wireless LAN).
    Nones if it can't be told."""
    if wireless:
        phy = wifi_phy(dev)
        if not phy or not shutil.which("iw"):
            return None, None
        info = run(["iw", "phy", phy, "info"]).stdout
        supported = "g" if re.search(r"WoWLAN support:(\n\s+\*.*)*?magic packet", info) else ""
        shown = run(["iw", "phy", phy, "wowlan", "show"]).stdout
        current = "g" if "magic packet" in shown else ("d" if shown else None)
        return supported, current
    if not shutil.which("ethtool"):
        return None, None
    out = run(["ethtool", dev]).stdout
    sup = re.search(r"Supports Wake-on:\s*(\S+)", out)
    cur = re.search(r"^\s*Wake-on:\s*(\S+)", out, re.M)
    return (sup.group(1) if sup else None), (cur.group(1) if cur else None)


def enable_wol(args):
    dev, mac, wireless = nic_info()
    if not dev:
        warn("no network connection found")
        return
    if wireless:
        return enable_wowlan(dev, mac, args)
    supported, current = wol_state(dev)
    if supported is not None and "g" not in supported:
        log(f"  {dev}'s network card doesn't support Wake-on-LAN")
        return
    if current and "g" in current:
        log(f"  already on for {dev} ({mac})")
        return
    if not ask(f"Turn on Wake-on-LAN for {dev}, so your other computers can wake this PC? "
               "Needs sudo.", args):
        return
    conn = nm_connection(dev)
    saved = bool(conn) and sudo(["nmcli", "connection", "modify", conn,
                                 "802-3-ethernet.wake-on-lan", "magic"])
    now = shutil.which("ethtool") and sudo(["ethtool", "-s", dev, "wol", "g"])
    if saved or now:
        log(f"  Wake-on-LAN on for {dev} ({mac})" + ("" if saved else " until the next reboot")
            + ("" if now else "; takes effect after a reboot"))
        log("  If waking doesn't work, also enable \"Wake on LAN\" / \"Power on by PCI-E\" "
            "in the BIOS/UEFI.")
    else:
        warn("couldn't turn on Wake-on-LAN")


def enable_wowlan(dev, mac, args):
    """Wake on Wireless LAN: some Wi-Fi cards can wake a sleeping PC on a magic packet."""
    supported, current = wol_state(dev, wireless=True)
    if supported is None:
        log(f"  {dev} is Wi-Fi. Can't tell whether it can wake the PC (needs the `iw` tool). "
            "Wired Wake-on-LAN is far more reliable; otherwise set Steam's sleep timer to Never.")
        return
    if not supported:
        log(f"  {dev} is Wi-Fi and its card can't wake the PC. Use a wired connection for "
            "Wake-on-LAN, or set Steam's sleep timer to Never so the AI stays reachable.")
        return
    if current == "g":
        log(f"  Wake on Wireless LAN already on for {dev} ({mac})")
        return
    if not ask(f"{dev} is Wi-Fi, and its card supports Wake on Wireless LAN. Turn it on, so "
               "your other computers can wake this PC from sleep? Needs sudo.", args):
        return
    conn = nm_connection(dev)
    saved = bool(conn) and sudo(["nmcli", "connection", "modify", conn,
                                 "802-11-wireless.wake-on-wlan", "magic"])
    now = sudo(["iw", "phy", wifi_phy(dev), "wowlan", "enable", "magic-packet"])
    if saved or now:
        log(f"  Wake on Wireless LAN on for {dev} ({mac})" + ("" if saved else " until the next reboot"))
        log("  It wakes the PC from sleep, not when it's shut down, and only while the router "
            "stays on. Some Wi-Fi drivers don't honor it; test with gpu-yield wake.")
    else:
        warn("couldn't turn on Wake on Wireless LAN")


def cmd_wol(args):
    dev, mac, wireless = nic_info()
    print(f"Network:  {dev or 'none'}" + (" (Wi-Fi)" if wireless else "") + (f", MAC {mac}" if mac else ""))
