def same_model(a, b):
    """Ollama reports "qwen3.5" as "qwen3.5:latest", and also accepts it as
    "library/qwen3.5" or "registry.ollama.ai/library/qwen3.5": all the same model."""
    def norm(n):
        n = n.strip().lower()
        n = re.sub(r"^registry\.ollama\.ai/", "", n)
        n = re.sub(r"^library/", "", n)
        return n if ":" in n.rsplit("/", 1)[-1] else n + ":latest"
    return norm(a) == norm(b)


