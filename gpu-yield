def cmd_restart(args):
    st = read_status()
    if user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode or not st:
        die(f"gpu-yield isn't running (start it: systemctl --user start {WATCHER_UNIT})")
    running = str(st.get("version") or "0")
    if parse_version(running) < parse_version("1.10.0"):
        # Older watchers don't handle the signal; it would stop them instead.
        die(f"the running watcher is version {running}, which can't restart the AI on its own. "
            f"Load this version first: systemctl --user restart {WATCHER_UNIT}")
    if st.get("state") != "ai":
        print(f"The AI is off right now ({STATE_TEXT.get(st.get('state'), st.get('state'))}); "
              "it loads fresh when it comes back. Nothing to restart.")
        return
    if st.get("restarting"):
        print("Already restarting; follow it with: gpu-yield status")
        return
    busy = [d.get("name") for d in st.get("downloads") or [] if d.get("state") == "running"]
    if busy or (st.get("speed") or {}).get("state") == "running":
        die("a " + (f"download ({', '.join(map(str, busy))})" if busy else "speed test")
            + " is running; restarting would cut it off. Try again when it's done.")
    main = user_systemctl("show", "-p", "MainPID", "--value", WATCHER_UNIT).stdout.strip()
    pid = st.get("pid")
    if not main.isdigit() or int(main) != pid:
        die(f"couldn't confirm which process is the watcher; try: systemctl --user restart {WATCHER_UNIT}")
    count, t0 = st.get("restart_count", 0), time.time()
    os.kill(pid, signal.SIGUSR1)
    print("Restarting: unloading the model and freeing GPU memory...")
    shown, end = set(), time.time() + 240
    while time.time() < end:
        time.sleep(1)
        st = read_status() or {}
        for e in reversed(st.get("events") or []):
            key = (e.get("at"), e.get("text"))
            if isinstance(e.get("at"), (int, float)) and e["at"] >= t0 and key not in shown:
                shown.add(key)
                print("  " + str(e.get("text")))
        if st.get("pid") != pid or (time.time() - t0) % 10 < 1 and \
                user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode:
            die("the watcher stopped while restarting; see: journalctl --user -u gpu-yield")
        if st.get("restart_count", 0) <= count or st.get("restarting"):
            continue                       # not picked up yet, or still going
        status = str(st.get("model_status", ""))
        if st.get("state") != "ai":
            print(f"Stopped waiting: {STATE_TEXT.get(st.get('state'), st.get('state'))}.")
            return
        if status.startswith("ready"):
            print("Done: " + status)
            return
        print(status)
        sys.exit(0 if status.startswith("no model") else 1)
    die("still not loaded after 4 minutes; see: gpu-yield status")


