    ensure_ollama_unit(cfg)
    user_systemctl("daemon-reload")
    if user_systemctl("is-enabled", "--quiet", WATCHER_UNIT).returncode == 0:
        user_systemctl("restart", WATCHER_UNIT)
        log("watcher restarted on the new version (the model reloads in a moment)")


def ollama_versions(cfg):
    installed = latest = None
    if OLLAMA_BIN.exists():
        m = re.search(r"(\d+\.\d+\.\d+)", run([str(OLLAMA_BIN), "--version"]).stdout)
        installed = m.group(1) if m else None
    try:
        latest = json.loads(github_get(cfg, "/repos/ollama/ollama/releases/latest"))["tag_name"].lstrip("v")
    except Exception:
        pass
    return installed, latest


def update_from_file(path):
    src = Path(path).expanduser()
    if not src.is_file():
        die(f"no such file: {src}")
    if BIN_PATH.exists() and src.resolve() == BIN_PATH.resolve():
        die(f"{src} is the installed copy; point --file at the new version instead")
    source = src.read_bytes()
    version = declared_version(source)
    if not version:
        die(f"{src} doesn't look like gpu-yield (no VERSION line); nothing changed")
    if parse_version(version) < parse_version(VERSION):
        log(f"note: {src} is version {version}, older than the installed {VERSION} (installing it anyway)")
    elif parse_version(version) == parse_version(VERSION):
        log(f"note: {src} has the same version number as the installed copy ({VERSION})")
    log(f"installing gpu-yield {version} from {src}")
    install_script(source, str(src))
    log(f"gpu-yield is now {version}. Undo with: gpu-yield rollback")


def cmd_update(args):
    if os.geteuid() == 0:
        die("run as your normal user, not with sudo")
    if args.file:
        update_from_file(args.file)
        return
    cfg = load_config()
    repo, source = fetch_latest(cfg)
    latest = declared_version(source)
    if not latest:
        die(f"the {APP} file in {repo} has no VERSION line")
    newer = parse_version(latest) > parse_version(VERSION)

    managed = cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT
    o_installed, o_latest = ollama_versions(cfg) if managed else (None, None)
    o_newer = bool(o_installed and o_latest and parse_version(o_latest) > parse_version(o_installed))

    if args.check:
        print(f"gpu-yield: installed {VERSION}, latest {latest} in {repo}"
              + ("  -> update available" if newer else "  (up to date)"))
        if managed:
            print(f"Ollama:    installed {o_installed or '?'}, latest {o_latest or '?'}"
                  + ("  -> run: gpu-yield update --ollama" if o_newer else ""))
        return

    if newer or args.force:
        log(f"updating gpu-yield {VERSION} -> {latest} from {repo}")
        install_script(source, f"version {latest} from {repo}")
        log(f"gpu-yield is now {latest}. Undo with: gpu-yield rollback")
    else:
        log(f"gpu-yield {VERSION} is up to date")

    if args.ollama:
        if not managed:
            log("Ollama is managed outside gpu-yield; update it the way you installed it")
        elif not o_newer and not args.force:
            log(f"Ollama {o_installed} is up to date")
        else:
            log(f"updating Ollama {o_installed} -> {o_latest} (backend {cfg['backend']})")
            user_systemctl("stop", WATCHER_UNIT)
            try:
                install_ollama(cfg["backend"])
            finally:
                user_systemctl("start", WATCHER_UNIT)
    elif o_newer:
        log(f"Ollama {o_latest} is available (you have {o_installed}): gpu-yield update --ollama")


def cmd_rollback(args):
    if not PREVIOUS_FILE.exists():
        die("no previous version saved; rollback only works after an update")
    source = PREVIOUS_FILE.read_bytes()
    target = declared_version(source)
    current = BIN_PATH.read_bytes() if BIN_PATH.exists() else None
    log(f"rolling back gpu-yield {VERSION} -> {target}")
    install_script(source, "the saved previous version")
    if current:                       # so a second rollback undoes the first
        PREVIOUS_FILE.write_bytes(current)
    log(f"gpu-yield is now {target}")


def main():
    if sys.argv[1:2] == ["_post-update"]:   # internal step run by the new version after an update
        return cmd_post_update(None)
    p = argparse.ArgumentParser(prog=APP, description="Run Ollama while the GPU is idle; "
                                "stop it whenever a Steam game runs.")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("setup", help="install Ollama, this tool and its services")
    s.add_argument("--model", help="model to keep loaded (asks if not given)")
    s.add_argument("--context", type=int, help="context length in tokens (default 65536)")
    s.add_argument("--backend", choices=["rocm", "vulkan"], help="GPU backend (default rocm)")
    s.add_argument("--reinstall", action="store_true", help="re-download Ollama (updates it)")
    s.add_argument("--skip-pull", action="store_true", help="don't download the model")
    s.add_argument("--no-firewall", action="store_true", help="don't touch the firewall")
    s.add_argument("-y", "--yes", action="store_true", help="accept all prompts")
    s.set_defaults(func=cmd_setup)
    for name, fn, text in (("run", cmd_run, "run the watcher (systemd does this)"),
                           ("status", cmd_status, "show the current state"),
                           ("pause", cmd_pause, "keep the AI off until resume"),
                           ("resume", cmd_resume, "undo pause"),
                           ("doctor", cmd_doctor, "check the setup")):
        sub.add_parser(name, help=text).set_defaults(func=fn)
    up = sub.add_parser("update", help="update gpu-yield from GitHub (and optionally Ollama)")
    up.add_argument("--file", metavar="PATH", help="install from a local file instead of GitHub")
    up.add_argument("--check", action="store_true", help="only report what's available")
    up.add_argument("--ollama", action="store_true", help="also update Ollama")
    up.add_argument("--force", action="store_true", help="reinstall even if up to date")
    up.set_defaults(func=cmd_update)
    m = sub.add_parser("model", help="choose or change the model (downloads it)")
    m.add_argument("name", nargs="?", help="Ollama model name; omit to pick from a list")
    m.set_defaults(func=cmd_model)
    sub.add_parser("rollback", help="go back to the version before the last update") \
        .set_defaults(func=cmd_rollback)
    u = sub.add_parser("uninstall", help="remove the services")
    u.add_argument("--purge", action="store_true", help="also remove Ollama, config and state")
    u.set_defaults(func=cmd_uninstall)
    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
