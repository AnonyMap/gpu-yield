def write_unit(name, text):
    """Write a user unit if its content changed. Returns True if it changed."""
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    path = UNIT_DIR / name
    if path.exists() and path.read_text() == text:
        return False
    path.write_text(text)
    return True


def ensure_ollama_unit(cfg):
    if cfg["ollama_unit"] != MANAGED_OLLAMA_UNIT:
        return False
    changed = write_unit(MANAGED_OLLAMA_UNIT, ollama_unit_text(cfg))
    if changed:
        user_systemctl("daemon-reload")
    return changed


class Ollama:
    def __init__(self, cfg):
        self.cfg = cfg
        self.unit = cfg["ollama_unit"]
        self.base = f"http://127.0.0.1:{cfg['port']}"

    def active(self):
        return user_systemctl("is-active", "--quiet", self.unit).returncode == 0

    def start(self):
        r = user_systemctl("start", self.unit)
        if r.returncode:
            log(f"could not start {self.unit}: {r.stderr.strip()}")
            return False
        return True

    def stop(self):
        r = user_systemctl("stop", self.unit)
        if r.returncode:
            log(f"could not stop {self.unit}: {r.stderr.strip()}")
            return False
        return True

    def request(self, path, payload=None, timeout=5.0):
        data = json.dumps(payload).encode() if payload is not None else None
        headers = {"Content-Type": "application/json"} if data else {}
        req = urllib.request.Request(self.base + path, data=data, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read()
        return json.loads(body) if body else {}

    def ready(self):
        try:
            self.request("/api/version", timeout=2)
            return True
        except Exception:
            return False

    def wait_ready(self, timeout, stop_evt=None):
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            if self.ready():
                return True
            if stop_evt is not None:
                if stop_evt.wait(1):
                    return False
            else:
                time.sleep(1)
        return False

    def warm(self):
        """Load the model into VRAM and keep it there (empty prompt = load only).

        Deliberately no num_gpu: setting it switches Ollama from expert-aware placement
        (MoE experts to RAM first) to a plain layer split, which is much slower.
        """
        self.request("/api/generate", {
            "model": self.cfg["model"],
            "prompt": "",
            "keep_alive": -1,
            "options": {"num_ctx": int(self.cfg["context_length"])},
        }, timeout=900)

    def loaded(self):
        try:
            return self.request("/api/ps").get("models", [])
        except Exception:
            return None

    def is_moe(self, model):
        """True if the model is mixture-of-experts (its GGUF metadata has an expert count)."""
        try:
            info = self.request("/api/show", {"model": model}, timeout=10).get("model_info", {})
        except Exception:
            return False
        return any(k.endswith(".expert_count") and v for k, v in info.items())


def placement_note(ollama, model, share):
    """(is_problem, message) describing how much of the model is in VRAM."""
    if share is None or share >= 100:
        return False, ""
    if ollama.is_moe(model):
        return False, (f"{100 - share}% of this mixture-of-experts model is in system RAM. "
                       "That's expected for models bigger than VRAM: expert weights go to RAM "
                       "first, so generation stays usable, but long prompts are processed "
                       "more slowly.")
    return True, (f"{100 - share}% of this dense model spilled to system RAM, so it will be slow. "
                  "Lower context_length or pick a smaller model.")


def gpu_share(models):
    """Percent of the loaded model that sits in VRAM (100 = fully on the GPU)."""
    if not models:
        return None
    size = sum(m.get("size", 0) for m in models)
    vram = sum(m.get("size_vram", 0) for m in models)
    return round(100 * vram / size) if size else None


def http_error_detail(e):
    try:
        return json.loads(e.read()).get("error") or str(e)
    except Exception:
        return str(e)


# ---------------------------------------------------------------------------- stand-in

class StandIn:
    """Answers every request with 503 + a reason while Ollama is down.

    /v1/* gets an OpenAI-style error body (what Hermes reads); everything else gets
    Ollama's native {"error": "..."} shape. Retry-After tells clients when to come back.
    """

    def __init__(self, port):
        self.port = port
        self.server = None
        self.message = "AI server is paused."
        self.retry_after = 60

    def start(self):
        if self.server:
            return True
        owner = self

        class Handler(BaseHTTPRequestHandler):
            server_version = APP
            protocol_version = "HTTP/1.1"

            def log_message(self, *args):
                pass

            def _reply(self):
                length = int(self.headers.get("Content-Length") or 0)
                if length:
                    self.rfile.read(min(length, 50_000_000))
                if self.path.startswith("/v1"):
                    body = {"error": {"message": owner.message, "type": "server_error",
                                      "code": "gpu_busy"}}
                else:
                    body = {"error": owner.message}
                data = json.dumps(body).encode()
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Retry-After", str(int(owner.retry_after)))
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(data)

            do_GET = do_POST = do_PUT = do_DELETE = do_HEAD = do_OPTIONS = do_PATCH = _reply

        last = None
        for _ in range(30):  # the port can take a moment to free up after Ollama exits
            try:
                server = ThreadingHTTPServer(("0.0.0.0", self.port), Handler)
                break
            except OSError as e:
                last = e
                time.sleep(0.5)
        else:
            log(f"stand-in could not bind port {self.port}: {last}")
            return False
        server.daemon_threads = True
        self.server = server
        threading.Thread(target=server.serve_forever, name="stand-in", daemon=True).start()
        return True

    def stop(self):
        if self.server:
            self.server.shutdown()
            self.server.server_close()
            self.server = None


# ----------------------------------------------------------------------------- watcher

class Watcher:
    OFF_STATES = ("gaming", "cooldown", "paused")

    def __init__(self, cfg):
        self.cfg = cfg
        self.ollama = Ollama(cfg)
        self.standin = StandIn(cfg["port"])
        self.host = socket.gethostname()
        self.stop_evt = threading.Event()
        self.state = None
        self.since = time.time()
        self.games = []
        self.cooldown_until = 0.0
        self.warm_gen = 0
        self.warm_status = "not loaded"
        self.warm_failed_at = None
        self.last_health = 0.0
        self.last_restart = 0.0

    # --- transitions
    def set_state(self, state):
        self.state = state
        self.since = time.time()

    def go_off(self, state, why):
        prev = self.state
        self.set_state(state)
        self.warm_gen += 1          # any warmup still in flight is now irrelevant
        self.warm_status = "not loaded"
        self.update_message(time.monotonic())
        log(why)
        if prev in self.OFF_STATES:
            return                  # already off; only the reason changed
        t = time.monotonic()
        self.ollama.stop()
        log(f"Ollama stopped ({time.monotonic() - t:.1f}s); GPU memory released")
        if self.standin.start():
            log(f"stand-in answering on port {self.cfg['port']}")

    def go_on(self, why):
        self.standin.stop()
        self.set_state("ai")
        log(why)
        self.last_restart = time.monotonic()
        if not self.ollama.start():
            self.warm_status = "failed: Ollama would not start (journalctl --user -u " \
                               f"{self.cfg['ollama_unit']})"
            self.warm_failed_at = time.monotonic()
            return
        if not self.cfg["model"]:
            self.warm_status = "no model chosen (run: gpu-yield model)"
            return
        self.warm_gen += 1
        gen = self.warm_gen
        threading.Thread(target=self._warm, args=(gen,), name="warmup", daemon=True).start()

    def _warm(self, gen):
        model = self.cfg["model"]
        self.warm_status = "starting Ollama"
        if not self.ollama.wait_ready(90, self.stop_evt):
            if gen == self.warm_gen:
                self.warm_status = "failed: Ollama did not answer within 90s"
                self.warm_failed_at = time.monotonic()
                log(self.warm_status)
            return
        if gen != self.warm_gen:
            return
        self.warm_status = f"loading {model}"
        t = time.monotonic()
        try:
            self.ollama.warm()
        except urllib.error.HTTPError as e:
            detail = http_error_detail(e)
            if gen == self.warm_gen:
                hint = f" (run: ollama pull {model})" if e.code == 404 else ""
                self.warm_status = f"failed: {detail}{hint}"
                self.warm_failed_at = time.monotonic()
                log(f"model load failed: {detail}{hint}")
            return
        except Exception as e:
            if gen == self.warm_gen:
                self.warm_status = f"failed: {e}"
                self.warm_failed_at = time.monotonic()
                log(f"model load failed: {e}")
            return
        if gen != self.warm_gen:
            return
        share = gpu_share(self.ollama.loaded())
        where = f", {share}% on GPU" if share is not None else ""
        self.warm_status = f"ready ({model}{where})"
        self.warm_failed_at = None
        log(f"{model} loaded in {time.monotonic() - t:.1f}s{where}")
        _, note = placement_note(self.ollama, model, share)
        if note:
            log(note)

    def update_message(self, now):
        cd = int(self.cfg["cooldown_seconds"])
        if self.state == "gaming":
            self.standin.message = (f"The AI server on {self.host} is paused because a game is "
                                    f"running. It comes back automatically about {cd}s after "
                                    "the game closes.")
            self.standin.retry_after = 120
        elif self.state == "cooldown":
            left = max(0, int(self.cooldown_until - now))
            self.standin.message = (f"A game just closed on {self.host}. The AI server resumes "
                                    f"in about {left}s, plus model loading time.")
            self.standin.retry_after = left + 30
        elif self.state == "paused":
            self.standin.message = (f"The AI server on {self.host} was paused manually "
                                    "(gpu-yield pause).")
            self.standin.retry_after = 600

    # --- main loop
    def step(self, games, paused, slept, now):
        self.games = sorted(set(games.values()))
        if paused:
            if self.state != "paused":
                self.go_off("paused", "paused manually")
        elif games:
            if self.state != "gaming":
                self.go_off("gaming", "game started: " + ", ".join(self.games))
        elif self.state == "gaming":
            self.set_state("cooldown")
            self.cooldown_until = now + float(self.cfg["cooldown_seconds"])
            log(f"game closed; reloading the model in {self.cfg['cooldown_seconds']}s "
                "unless another game starts")
        elif self.state == "cooldown":
            if now >= self.cooldown_until:
                self.go_on("cooldown over; starting Ollama")
        elif self.state is None:
            self.go_on("no game running; starting Ollama")
        elif self.state == "paused":
            self.go_on("resumed; starting Ollama")
        elif self.state == "ai":
            if slept and self.cfg["restart_after_suspend"]:
                self.ollama.stop()
                self.go_on("woke from sleep; restarting Ollama")
            else:
                self.health(now)
        if self.state in self.OFF_STATES:
            self.update_message(now)

    def health(self, now):
        if now - self.last_health < 15:
            return
        self.last_health = now
        if not self.ollama.active():
            if now - self.last_restart >= 30:
                self.go_on("Ollama is not running; restarting it")
        elif self.warm_failed_at is not None and now - self.warm_failed_at > 300:
            self.warm_failed_at = None
            self.warm_gen += 1
            threading.Thread(target=self._warm, args=(self.warm_gen,), daemon=True).start()

    def write_status(self, now):
        status = {
            "state": self.state,
            "since": self.since,
            "games": self.games,
            "cooldown_remaining": max(0, int(self.cooldown_until - now)) if self.state == "cooldown" else None,
            "model": self.cfg["model"],
            "context_length": self.cfg["context_length"],
            "model_status": self.warm_status if self.state == "ai" else "unloaded",
            "updated": time.time(),
            "pid": os.getpid(),
        }
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            tmp = STATUS_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(status, indent=1))
            os.replace(tmp, STATUS_FILE)
        except OSError:
            pass

    def run(self):
        if threading.current_thread() is threading.main_thread():
            for sig in (signal.SIGTERM, signal.SIGINT):
                signal.signal(sig, lambda *_: self.stop_evt.set())
        ensure_ollama_unit(self.cfg)
        # Start from a known state: whatever Ollama was doing, it may carry an old config.
        self.ollama.stop()
        log(f"gpu-yield {VERSION} watching for games (model {self.cfg['model']}, "
            f"context {self.cfg['context_length']}, cooldown {self.cfg['cooldown_seconds']}s)")
        poll = max(0.5, float(self.cfg["poll_seconds"]))
        mono0, boot0 = time.monotonic(), time.clock_gettime(time.CLOCK_BOOTTIME)
        while not self.stop_evt.is_set():
            mono, boot = time.monotonic(), time.clock_gettime(time.CLOCK_BOOTTIME)
            slept = (boot - boot0) - (mono - mono0) > 15   # monotonic pauses during suspend
            mono0, boot0 = mono, boot
            try:
                self.step(scan_games(self.cfg), PAUSE_FILE.exists(), slept, mono)
            except Exception as e:  # never let one bad loop kill the watcher
                log(f"watcher error: {e!r}")
            self.write_status(mono)
            self.stop_evt.wait(poll)
        self.standin.stop()
        log("watcher stopped")


