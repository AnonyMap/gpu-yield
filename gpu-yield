def parse_version(text):
    try:
        return tuple(int(x) for x in text.strip().lstrip("v").split("-")[0].split("."))
    except ValueError:
        return (0,)


def declared_version(source):
    m = re.search(rb'^VERSION = "([^"]+)"', source, re.M)
    return m.group(1).decode() if m else None


def github_get(cfg, path, raw=False, timeout=30):
    headers = {
        "User-Agent": f"{APP}/{VERSION}",
        "Accept": "application/vnd.github.raw" if raw else "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if cfg["github_token"]:
        headers["Authorization"] = f"Bearer {cfg['github_token']}"
    req = urllib.request.Request(GITHUB_API + path, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def fetch_latest(cfg):
    repo = cfg["update_repo"] or BUILTIN_REPO
    if not repo:
        die("no update source: set update_repo = \"owner/name\" in " + str(CONFIG_FILE))
    branch = cfg["update_branch"]
    try:
        data = github_get(cfg, f"/repos/{repo}/contents/{APP}?ref={branch}", raw=True)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            die(f"{APP} not found in {repo} on branch {branch}. "
                "If the repo is private, set github_token in the config.")
        if e.code in (401, 403):
            die(f"GitHub refused the request ({e.code}: {http_error_detail(e)}). Check "
                "github_token; without one GitHub allows 60 requests an hour.")
        die(f"GitHub error {e.code}: {http_error_detail(e)}")
    except urllib.error.URLError as e:
        die(f"could not reach GitHub: {e.reason}")
    return repo, data


def install_script(source, label):
    """Validate a gpu-yield script, swap it in atomically, and let it migrate itself."""
    version = declared_version(source)
    if not version:
        die(f"{label} doesn't look like gpu-yield (no VERSION line); nothing changed")
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    tmp = BIN_DIR / f".{APP}.new"
    tmp.write_bytes(source)
    tmp.chmod(0o755)
    check = run([sys.executable, str(tmp), "--version"])
    if check.returncode or check.stdout.strip() != version:
        tmp.unlink(missing_ok=True)
        die(f"{label} failed its self-test, so nothing changed:\n{check.stderr.strip()[-800:]}")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if BIN_PATH.exists():
        shutil.copy2(BIN_PATH, PREVIOUS_FILE)
    os.replace(tmp, BIN_PATH)
    # The NEW code rewrites its own units and restarts the watcher, so changes to the
    # service files in a release take effect without re-running setup.
    subprocess.run([sys.executable, str(BIN_PATH), "_post-update"])
    return version


