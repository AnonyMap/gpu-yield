def _version_tuple(text):
    nums = re.findall(r"\d+", text or "")[:3]
    return tuple(int(n) for n in nums + ["0"] * (3 - len(nums)))


def bc250_checks(cfg, ollama=None):
    """The BC-250 board's own pitfalls, from the community's experience (the project's
    bc250-check.sh): [(kind, message)] with kind "ok", "bad" or "note". Read-only:
    gpu-yield never changes kernel, BIOS or governor settings, it only says what to do."""
    out = []
    add = lambda kind, msg: out.append((kind, msg))
    cmdline = _read_text(Path("/proc/cmdline"))

    kv = _version_tuple(os.uname().release)
    if (6, 15, 0) <= kv <= (6, 15, 6) or (6, 17, 8) <= kv <= (6, 17, 10):
        add("bad", f"kernel {os.uname().release} is in a known-bad range for the BC-250 "
                   "(6.15.0-6.15.6, 6.17.8-6.17.10); use 6.19.x or 6.18.18+ LTS")
    elif kv < (6, 18, 18):
        add("note", f"kernel {os.uname().release}: 6.18.18+ LTS or 6.19.x is recommended")
    else:
        add("ok", f"kernel {os.uname().release}")

    pl = _read_text(Path("/sys/module/ttm/parameters/pages_limit")).strip()
    if pl.isdigit():
        if int(pl) >= 3959290:
            add("ok", f"GPU memory limit ttm.pages_limit = {pl} ({size_text(int(pl) * 4096)})")
        else:
            add("bad", f"ttm.pages_limit = {pl} caps GPU memory at {size_text(int(pl) * 4096)}: "
                       "bigger models load, then fail or hang. Set ttm.pages_limit=4194304")
    sources = {}
    m = re.search(r"ttm\.pages_limit=(\d+)", cmdline)
    if m:
        sources["kernel command line"] = m.group(1)
    for d in ("/etc/modprobe.d", "/etc/tmpfiles.d", "/usr/lib/tmpfiles.d"):
        for f in sorted(Path(d).glob("*.conf")) if Path(d).is_dir() else []:
            for line in _read_text(f).splitlines():
                if line.lstrip().startswith("#") or "pages_limit" not in line:
                    continue
                # modprobe.d: "options ttm pages_limit=N [more=...]";
                # tmpfiles.d: "w /sys/module/ttm/parameters/pages_limit - - - - N"
                m = re.search(r"\bpages_limit=(\d+)", line) or \
                    re.search(r"/pages_limit\s.*?(\d{5,})\s*$", line.strip())
                if m:
                    sources[str(f)] = m.group(1)
    if len(set(sources.values())) > 1:
        add("bad", "ttm.pages_limit is set to different values in " + ", ".join(
            f"{k} ({v})" for k, v in sources.items()) + "; the tmpfiles.d setting wins last. "
            "Make them all 4194304")

    # TTM keeps GPU memory that was freed in a pool for reuse, by default up to half of RAM.
    # Linux frees it when memory runs short, but until then counts it as used, so after a
    # model unloads the board looks fuller than it is (and gpu-yield's low-memory check
    # can act on that). A 1 GiB pool keeps the reuse without the false alarm.
    pool = _read_text(Path("/sys/module/ttm/parameters/page_pool_size")).strip()
    if pool.isdigit() and (int(pool) == 0 or int(pool) > 262144):
        size = f"{size_text(int(pool) * 4096)}" if int(pool) else "half the memory (the default)"
        add("note", f"TTM may keep up to {size} of freed GPU memory pooled, which Linux reports "
                    "as in use until it's needed. To keep free-memory readings honest, add "
                    "ttm.page_pool_size=262144 (1 GiB) to the kernel options")

    mem = memory_readings() or {}
    if mem.get("vram_total", 0) > 1.1e9:
        add("bad", f"the BIOS gives the GPU a fixed {size_text(mem['vram_total'])}, leaving "
                   f"{size_text(mem.get('ram_total', 0))} for Linux, the model and its context to "
                   "share" + (", so models over ~7 GB can't fit" if mem.get("ram_total", 2**40) < 10e9
                              else "") + ". Set 512MB dynamic VRAM in the BIOS (it may need the "
                   "community-patched BIOS)")
    if mem.get("gtt_total"):
        (add("ok", f"the GPU can use {size_text(mem['gtt_total'])} of shared memory")
         if mem["gtt_total"] >= 15e9 else
         add("bad", f"the GPU can only use {size_text(mem['gtt_total'])} of shared memory: "
                    "set ttm.pages_limit=4194304"))

    if re.search(r"\b(amd_)?iommu=off\b", cmdline):
        add("ok", "IOMMU off")
    elif any(Path("/sys/class/iommu").glob("*")):
        add("bad", "IOMMU is on: turn it off in the BIOS (a known source of BC-250 instability)")

    env = dict(os.environ, **cfg["ollama_env"])
    if "HSA_OVERRIDE_GFX_VERSION" in env:
        add("bad", "HSA_OVERRIDE_GFX_VERSION is set: pretending to be another GPU risks wrong "
                   "results and freezes on this board. Remove it")
    if Path("/opt/rocm").is_dir():
        add("note", "ROCm is installed in /opt/rocm. Newer ROCm can hard-freeze this board; "
                    "gpu-yield uses Vulkan here, so make sure nothing else uses ROCm")

    try:
        vk = run(["vulkaninfo", "--summary"], timeout=20) if shutil.which("vulkaninfo") else None
    except (OSError, subprocess.TimeoutExpired):
        vk = None
    if vk and vk.returncode == 0:
        if re.search(r"llvmpipe", vk.stdout, re.I) and not re.search(r"gfx1013", vk.stdout, re.I):
            add("bad", "Vulkan only sees llvmpipe (software rendering): the AI would run on the "
                       "CPU. Check the Mesa/RADV install")
        mesa = re.search(r"Mesa (\d+\.\d+(?:\.\d+)?)", vk.stdout)
        if mesa and _version_tuple(mesa.group(1)) < (25, 1, 0):
            add("note", f"Mesa {mesa.group(1)}: 25.1+ is needed for flash attention, which "
                        "8-bit context storage (q8_0) relies on")
    elif not shutil.which("vulkaninfo"):
        add("note", "vulkaninfo isn't installed (package vulkan-tools), so the Vulkan driver "
                    "can't be checked")

    gov = next((u for u in ("cyan-skillfish-governor-smu", "cyan-skillfish-governor",
                            "oberon-governor")
                if run(["systemctl", "is-active", "--quiet", u]).returncode == 0), None)
    if gov:
        add("ok", f"GPU clock governor running ({gov})")
    else:
        add("bad", "no GPU clock governor running: install and enable "
                   "cyan-skillfish-governor-smu, the only working clock and voltage control "
                   "on this GPU (a stable baseline is 1500 MHz at 900 mV)")
    for conf in (Path("/etc/cyan-skillfish-governor-smu/config.toml"),
                 Path("/etc/cyan-skillfish-governor/config.toml")):
        text = _read_text(conf)
        mvs = [int(v) for v in re.findall(r"\[\s*\d{3,4}\s*,\s*(\d{3,4})\s*\]", text)]
        if mvs and min(mvs) < 700:
            add("bad", f"{conf}: a voltage point of {min(mvs)} mV locks the GPU at 1500 MHz; "
                       "keep every point at 700 mV or more")
        rng = re.search(r"^\[frequency-range\](.*?)(^\[|\Z)", text, re.M | re.S)
        body = "\n".join(line.split("#", 1)[0] for line in rng.group(1).splitlines()) if rng else ""
        if re.search(r"\d\s*mhz", body, re.I):
            add("bad", f"{conf}: an 'MHz' suffix in [frequency-range] breaks the governor's "
                       "parser; use bare numbers")

    swap = sum(int(line.split()[2]) * 1024 for line in _read_text(Path("/proc/swaps")).splitlines()[1:]
               if len(line.split()) > 2 and "zram" not in line.split()[0])
    zram = sum(int(_read_text(z).strip() or 0) for z in Path("/sys/block").glob("zram*/disksize"))
    if swap < 8 * 2**30:
        add("note", f"disk swap is {size_text(swap) if swap else 'none'}: a 16 GB swapfile on the "
                    "NVMe is a safety net for memory peaks while a model loads")
    if zram > 4 * 2**30:
        add("note", f"zram is {size_text(zram)}: it lives in the same 16 GB as the model. "
                    "About 2 GB is plenty")
    if not any(JOURNAL_DIR.glob("*")):
        add("bad", "the system journal isn't kept across reboots, so a crash leaves no evidence: "
                   "sudo mkdir -p /var/log/journal && sudo systemctl restart systemd-journald")

    kvtype = cfg["ollama_env"].get("OLLAMA_KV_CACHE_TYPE", "q8_0")
    if kvtype == "q4_0" and ollama is not None and cfg["model"]:
        try:
            info = ollama.request("/api/show", {"model": cfg["model"]}, timeout=10).get("model_info", {})
            heads = next((v for k, v in info.items() if k.endswith(".attention.head_count_kv")), None)
            heads = min(h for h in heads if h) if isinstance(heads, list) else heads
        except Exception:
            heads = None
        if heads and heads <= 4:
            add("bad", f"{cfg['model']} has only {heads} KV heads, and 4-bit context storage "
                       "(q4_0) can wreck such models' answers: gpu-yield config "
                       "env.OLLAMA_KV_CACHE_TYPE q8_0")
    add("note", "for crash history, temperatures and the back-side memory chips, run the "
                "community BC-250 health check (bc250-check.sh)")
    return out


def cmd_doctor(args):
    cfg = load_config()
    problems = 0

    def ok(msg):
        print(f"  ok    {msg}")

    def bad(msg):
        nonlocal problems
        problems += 1
        print(f"  FIX   {msg}")

    def note(msg):
        print(f"        {msg}")

    print(f"gpu-yield {VERSION}, Python {platform.python_version()}")
    if tomllib is None:
        bad("Python 3.11+ required")
    if user_systemctl("show-environment").returncode:
        bad("systemd user manager not reachable (run as your normal user, not root)")
    if user_systemctl("is-active", "--quiet", WATCHER_UNIT).returncode == 0:
        ok("watcher service running")
    else:
        bad(f"watcher not running: systemctl --user enable --now {WATCHER_UNIT}")
    linger = run(["loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger", "--value"]).stdout.strip()
    (ok if linger == "yes" else bad)(f"linger {'enabled' if linger == 'yes' else 'disabled: loginctl enable-linger'}"
                                       " (services start at boot without waiting for login)")

    if cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT:
        if OLLAMA_BIN.exists():
            ver = run([str(OLLAMA_BIN), "--version"]).stdout.strip().splitlines()
            ok(f"Ollama installed: {ver[-1] if ver else OLLAMA_BIN}")
        else:
            bad("Ollama not installed: gpu-yield setup")
    if run(["systemctl", "is-active", "--quiet", "ollama.service"]).returncode == 0:
        bad("a system-wide ollama.service is running and competes for the port: "
            "sudo systemctl disable --now ollama.service")
    if is_bc250():
        print("  BC-250 board detected:")
        for kind, msg in bc250_checks(cfg, Ollama(cfg)):
            {"ok": ok, "bad": bad, "note": note}[kind](msg)
    backend, targets = resolve_backend(cfg), gpu_targets()
    gpus = ", ".join(sorted(targets)) or "no AMD GPU found"
    note(f"GPU: {gpus}; backend {backend}" + (" (chosen automatically)" if cfg["backend"] == "auto" else ""))
    if backend_installed(cfg) is False:
        bad("the ROCm backend is chosen but its download isn't installed, so Ollama uses "
            "Vulkan for now. Install it with: gpu-yield setup --reinstall")
    if backend == "rocm" and targets and not targets & ROCM_TARGETS:
        bad(f"ROCm doesn't support {gpus}, so Ollama would run on the CPU. "
            "Set backend to auto or vulkan: gpu-yield config backend auto, then "
            "gpu-yield setup --reinstall")
    if backend == "rocm":
        kfd = Path("/dev/kfd")
        if kfd.exists() and os.access(kfd, os.R_OK | os.W_OK):
            ok("/dev/kfd accessible (ROCm)")
        else:
            bad("/dev/kfd missing or not accessible: ROCm will fall back to CPU. "
                "Try backend = \"vulkan\" or add yourself to the render group")
    try:
        found = ollama_devices(MANAGED_OLLAMA_UNIT) if cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT \
            else None
    except Exception:
        found = None
    if found and (found["devices"] or found["dropped"]):
        gpus_seen = [d for d in found["devices"] if d["library"].lower() != "cpu"]
        (ok if gpus_seen else bad)("Ollama found at its last start: "
                                   + ("; ".join(describe_devices(found)) or "nothing"))
        for d in found["dropped"]:
            what = d["description"] or d["name"] or "an integrated GPU"
            msg = f"Ollama ignored {what} because it's integrated"
            if gpus_seen:
                note(msg + " (normal next to a graphics card)")
            else:
                bad(msg + ": gpu-yield config env.OLLAMA_IGPU_ENABLE 1")
    renders = list(Path("/dev/dri").glob("renderD*"))
    if renders and all(os.access(r, os.R_OK | os.W_OK) for r in renders):
        ok("GPU render node accessible")
    else:
        bad("GPU render node not accessible")

    games = scan_games(cfg)
    note(f"games detected right now: {', '.join(sorted(set(games.values()))) or 'none'}")
    st = read_status()
    if st and st.get("state") == "ai":
        o = Ollama(cfg)
        if o.ready():
            ok(f"Ollama answering on port {cfg['port']}")
            models = o.loaded() or []
            if models:
                share = gpu_share(models)
                ctx = models[0].get("context_length")
                problem, msg = placement_note(o, models[0].get("name"), share)
                if msg and shared_memory_gpu() and share:
                    msg = (f"{100 - share}% of it runs on the CPU, because Ollama sees less GPU "
                           "memory than the board has; it will be slow. Check the GPU memory "
                           "limit (ttm.pages_limit) above")
                (bad if problem else ok)(f"{models[0].get('name')} loaded, {share}% on GPU"
                                         + (f", context {ctx}" if ctx else ""))
                if msg:
                    note(msg)
            else:
                bad(f"no model loaded ({st.get('model_status')})")
            if st.get("notice"):
                bad(st["notice"])
        else:
            bad("Ollama not answering; see journalctl --user -u gpu-yield-ollama")
    elif st:
        note(f"state: {STATE_TEXT.get(st.get('state'))}; Ollama checks skipped")
    mem = memory_readings()
    if mem:
        note("memory (from the driver, not Ollama): " + memory_line(mem))
    if cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT:
        limit = effective_ram_limit(cfg)
        note(f"Ollama's RAM limit: {size_text(limit) if limit else 'none'}; kept out of swap, "
             "and stopped first if RAM runs out")
    note("models that don't fit in GPU memory: " + (
        "unloaded (ROCm); gpu-yield goes back to the last model that fit" if guards_gpu_fit(cfg)
        else "allowed (allow_partial_gpu = true)" if cfg["allow_partial_gpu"]
        else "refused or unloaded (shared memory: running it out freezes the board)"
        if guards_shared_fit(cfg)
        else "allowed with a warning (Vulkan: it only costs speed)"))
    holders = vram_holders()
    if holders:
        note("GPU memory by program: " + holders_text(holders, 6))

    ip, net = lan_address()
    if run(["systemctl", "is-active", "--quiet", "firewalld"]).returncode == 0:
        ports = " and ".join(str(p) for p in (cfg["port"], page_port(cfg)) if p)
        note(f"firewalld is active; ports {ports} must be open to {net or 'your LAN'} "
             "(gpu-yield firewall does this)")
        # Ollama answers on IPv6 too. Reading the rules usually works without sudo.
        rules = run(["firewall-cmd", "--list-rich-rules"])
        has_v6 = any('family="ipv6"' in r and f'port="{cfg["port"]}"' in r and "reject" in r
                     for r in rules.stdout.splitlines())
        public_v6 = []
        for a in re.findall(r"inet6 ([0-9a-fA-F:]+)/", run(["ip", "-6", "addr", "show",
                                                           "scope", "global"]).stdout):
            try:
                if ipaddress.ip_address(a).is_global:      # not fd00::/8 and the like
                    public_v6.append(a)
            except ValueError:
                pass
        if rules.returncode:
            note("couldn't read the firewall rules without sudo, so the IPv6 check was "
                 "skipped (gpu-yield firewall adds what's needed)")
        elif not has_v6 and public_v6:
            bad(f"Ollama's port {cfg['port']} also answers on this PC's IPv6 addresses, which "
                "can be reachable from outside your network: run gpu-yield firewall to limit "
                "it to local addresses")
    note(f"Hermes base_url: http://{ip or '<this-pc-ip>'}:{cfg['port']}/v1")
    if page_port(cfg):
        note(f"status page: http://{ip or socket.gethostname()}:{cfg['status_port']}/")
    else:
        note("status page: off (turn on with: gpu-yield config status_page true)")
    dev, mac, wireless = nic_info()
    if dev:
        supported, current = wol_state(dev, wireless)
        if wireless and supported == "":
            state = "not supported by this Wi-Fi card"
        elif current:
            state = "on" if "g" in current else "off (turn on: gpu-yield wol)"
        else:
            state = "unknown (gpu-yield wol)"
        note(f"{'Wake on Wireless LAN' if wireless else 'Wake-on-LAN'}: {state}; {dev} {mac or ''}")
    print("All good." if problems == 0 else f"{problems} thing(s) to fix.")


# --- setup

def ask(question, args, default=True):
    if args.yes:
        return default
    if not sys.stdin.isatty():
        return default
    suffix = " [Y/n] " if default else " [y/N] "
    answer = input(question + suffix).strip().lower()
    return default if not answer else answer.startswith("y")


def sudo(cmd):
    print(f"  $ sudo {' '.join(cmd)}")
    return subprocess.run(["sudo", *cmd]).returncode == 0


def download(url, dest):
    dest.parent.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(url, headers={"User-Agent": f"{APP}/{VERSION}"})
    with urllib.request.urlopen(req, timeout=60) as r, open(dest, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        done, shown = 0, -1
        while chunk := r.read(1 << 20):
            f.write(chunk)
            done += len(chunk)
            if total:
                pct = done * 100 // total
                if pct // 10 != shown:
                    shown = pct // 10
                    print(f"    {dest.name}: {pct}% of {total / 2**30:.1f} GiB", flush=True)
    if total and done != total:
        raise OSError(f"download of {url} stopped at {done} of {total} bytes")
    return dest


def ollama_download_base():
    """The download folder of Ollama's latest release, by version number, so the packages
    and the checksums that vouch for them come from the same release."""
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **k):
            return None
    req = urllib.request.Request(f"{OLLAMA_RELEASES}/latest", method="HEAD",
                                 headers={"User-Agent": f"{APP}/{VERSION}"})
    try:
        urllib.request.build_opener(NoRedirect).open(req, timeout=30).close()
    except urllib.error.HTTPError as e:
        m = re.search(r"/releases/tag/(v[\w.+-]+)$", e.headers.get("Location") or "")
        if e.code in (301, 302, 303, 307, 308) and m:
            return f"{OLLAMA_RELEASES}/download/{m.group(1)}"
    except OSError:
        pass
    return f"{OLLAMA_RELEASES}/latest/download"


def published_checksums(base):
    """{file name: sha256} from the release's sha256sum.txt."""
    req = urllib.request.Request(f"{base}/sha256sum.txt", headers={"User-Agent": f"{APP}/{VERSION}"})
    with urllib.request.urlopen(req, timeout=60) as r:
        text = r.read(1 << 20).decode("utf-8", "replace")
    sums = {}
    for line in text.splitlines():
        m = re.fullmatch(r"([0-9a-fA-F]{64})\s+\*?(?:\./)?(\S+)", line.strip())
        if m:
            sums[m.group(2)] = m.group(1).lower()
    return sums


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(1 << 20):
            h.update(chunk)
    return h.hexdigest()


def install_ollama(backend):
    """Download and unpack Ollama next to the current install, then swap it in.

    The working install is only replaced once the new one has unpacked and runs, so a
    failed or interrupted download leaves the old Ollama in place.
    """
    if platform.machine() != "x86_64":
        die(f"unsupported CPU architecture: {platform.machine()}")
    if not shutil.which("zstd"):
        die("zstd is needed to unpack Ollama but was not found")
    staging = OLLAMA_DIR.with_name(OLLAMA_DIR.name + ".new")
    previous = OLLAMA_DIR.with_name(OLLAMA_DIR.name + ".old")
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)
    packages = ["ollama-linux-amd64.tar.zst"]
    if backend == "rocm":
        packages.append("ollama-linux-amd64-rocm.tar.zst")
        log("  (the ROCm package is large; this can take a few minutes)")
    keep = "the current Ollama install was left as it was" if OLLAMA_DIR.exists() else \
           "nothing was installed"
    try:
        base = ollama_download_base()
        sums = published_checksums(base)
        for pkg in packages:
            archive = CACHE_DIR / pkg
            try:
                if pkg not in sums:
                    raise OSError(f"the release lists no checksum for {pkg}")
                download(f"{base}/{pkg}", archive)
                if sha256_file(archive) != sums[pkg]:
                    raise OSError(f"{pkg} doesn't match its published checksum "
                                  "(a damaged or altered download)")
                r = run(["tar", "--zstd", "-xf", str(archive), "-C", str(staging)])
                if r.returncode:
                    raise OSError(f"could not unpack {pkg}: {r.stderr.strip()[-300:]}")
            finally:
                archive.unlink(missing_ok=True)
        new_bin = staging / "bin/ollama"
        if not new_bin.exists():
            raise OSError("the download did not contain bin/ollama")
        if run([str(new_bin), "--version"]).returncode:
            raise OSError("the downloaded Ollama does not run on this system")
    except (OSError, http.client.HTTPException) as e:   # URLError and timeouts are OSErrors
        shutil.rmtree(staging, ignore_errors=True)
        die(f"Ollama install failed ({e}); {keep}")
    shutil.rmtree(previous, ignore_errors=True)
    if OLLAMA_DIR.exists():
        OLLAMA_DIR.rename(previous)        # old libraries must not mix with the new ones
    staging.rename(OLLAMA_DIR)
    shutil.rmtree(previous, ignore_errors=True)
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    link = BIN_DIR / "ollama"
    if link.is_symlink() or not link.exists():
        link.unlink(missing_ok=True)
        link.symlink_to(OLLAMA_BIN)
    log(f"  installed {run([str(OLLAMA_BIN), '--version']).stdout.strip().splitlines()[-1]}")


def check_conflicts(args):
    if run(["systemctl", "is-active", "--quiet", "ollama.service"]).returncode == 0 or \
       run(["systemctl", "is-enabled", "--quiet", "ollama.service"]).returncode == 0:
        warn("a system-wide ollama.service exists. It would hold the port and keep "
             "using the GPU during games.")
        if ask("Disable it?", args):
            sudo(["systemctl", "disable", "--now", "ollama.service"])
    for unit in ("homebrew.ollama.service", "ollama.service"):
        if user_systemctl("is-enabled", "--quiet", unit).returncode == 0 or \
           user_systemctl("is-active", "--quiet", unit).returncode == 0:
            warn(f"user service {unit} also runs Ollama.")
            if ask(f"Disable {unit}?", args):
                user_systemctl("disable", "--now", unit)


def open_firewall(cfg, args):
    """Open the AI port and the status page port to the local network only."""
    if run(["systemctl", "is-active", "--quiet", "firewalld"]).returncode:
        log("  firewalld not active; nothing to open")
        return
    ip, net = lan_address()
    if not net:
        warn("could not work out your LAN subnet; open the ports manually if Hermes can't connect")
        return
    ports = [cfg["port"]] + ([page_port(cfg)] if page_port(cfg) else [])
    names = " and ".join(str(p) for p in ports)
    if not ask(f"Allow port{'s' if len(ports) > 1 else ''} {names} from your local network "
               f"({net}) only? Needs sudo.", args):
        return
    done = True
    for port in ports:
        rule = (f'rule family="ipv4" source address="{net}" '
                f'port port="{port}" protocol="tcp" accept')
        done &= sudo(["firewall-cmd", "--permanent", f"--add-rich-rule={rule}"])
    # Ollama listens on IPv6 as well (its 0.0.0.0 means both), and IPv6 addresses can be
    # reachable from the internet. Allow only local IPv6 (link-local and private), first,
    # then refuse the rest; Fedora's desktop zone otherwise lets high ports through.
    for rule in (*(f'rule priority="-10" family="ipv6" source address="{src}" '
                   f'port port="{cfg["port"]}" protocol="tcp" accept'
                   for src in ("fe80::/10", "fc00::/7")),
                 f'rule priority="-9" family="ipv6" port port="{cfg["port"]}" protocol="tcp" reject'):
        done &= sudo(["firewall-cmd", "--permanent", f"--add-rich-rule={rule}"])
    if done:
        sudo(["firewall-cmd", "--reload"])


def enable_linger(args):
    user = os.environ.get("USER") or HOME.name
    if run(["loginctl", "show-user", user, "-p", "Linger", "--value"]).stdout.strip() == "yes":
        return
    if run(["loginctl", "enable-linger", user]).returncode:
        sudo(["loginctl", "enable-linger", user])


# (name, download GB, description, smallest card in GB that fits it at a 64K context)
# Context memory decides what fits: agents like Hermes need 64K, and on these models it
# costs 2-4 GB on top of the download. Gaming Mode's interface needs up to ~2 GB more.
MODEL_CHOICES = [
    ("qwen3.5:9b", 6.6, "recommended: ~10.5 GB at 64K context, so it fits 12 GB cards; "
                        "accepts images", 0),
    ("gemma4:12b-it-qat", 7.2, "alternative with built-in tool calling; ~12 GB at 64K", 16),
    ("qwen3.5:4b", 3.4, "smallest; quick answers, weak at multi-step tool use", 0),
]


def detect_memory():
    """(system RAM GiB, largest GPU VRAM GiB); either may be None. On a shared-memory chip
    the GPU's memory is the system's, so that's what's reported for it."""
    ram_b = total_ram()
    ram = ram_b / 2**30 if ram_b else None
    vram = None
    for f in DRM_DIR.glob("card*/device/mem_info_vram_total"):
        try:
            vram = max(vram or 0, int(_read_text(f)) / 2**30)
        except ValueError:
            pass
    if vram is not None and ram and (memory_readings() or {}).get("shared"):
        vram = ram           # shared-memory chip: the GPU's memory is the system's
    return ram, vram


def choose_model(args):
    """Ask which model to use. Returns a model name, "" for skip, or None if no one can answer."""
    if getattr(args, "yes", False) or not sys.stdin.isatty():
        return None
    ram, vram = detect_memory()
    hw = ", ".join(x for x in (f"{vram:.0f} GB VRAM" if vram else "",
                               f"{ram:.0f} GB RAM" if ram else "") if x)
    print(f"\nWhich model should stay loaded while the PC is idle?" + (f"  (this PC: {hw})" if hw else ""))
    for i, (name, size, blurb, card) in enumerate(MODEL_CHOICES, 1):
        # Cards report a bit under their advertised size (a "16 GB" card shows ~15.98).
        short = f"   [needs a {card} GB card at 64K context; this one has {vram:.0f} GB]" \
            if card and vram and vram < card * 0.9 else ""
        print(f"  {i}) {name:<16} {'~' + format(size, 'g') + ' GB':<8} {blurb}{short}")
    n = len(MODEL_CHOICES)
    print(f"  {n + 1}) another model (type its Ollama name)")
    print(f"  {n + 2}) none for now (choose later with: gpu-yield model)")
    while True:
        answer = input("Choice [1]: ").strip() or "1"
        if answer.isdigit() and 1 <= int(answer) <= n:
            return MODEL_CHOICES[int(answer) - 1][0]
        if answer == str(n + 1):
            name = input("Ollama model name (e.g. gemma4:12b): ").strip()
            if name:
                return name
        elif answer == str(n + 2):
            return ""
        else:
            print(f"Enter a number from 1 to {n + 2}.")


def pull_and_load(cfg, name):
    """Download a model and load it into VRAM. True if it's ready to use; otherwise
    "download" (the download failed) or "refused" (it didn't load, or didn't fit)."""
    managed = cfg["ollama_unit"] == MANAGED_OLLAMA_UNIT
    exe = str(OLLAMA_BIN) if managed else (shutil.which("ollama") or "ollama")
    env = dict(os.environ, OLLAMA_HOST=f"127.0.0.1:{cfg['port']}")
    try:
        installed = [tag_name(m) for m in
                     Ollama(cfg).request("/api/tags", timeout=10).get("models", [])]
    except Exception:
        installed = []
    if any(same_model(name, m) for m in installed):
        # Already here. It may be one you made yourself (ollama create), which exists on
        # no server, so asking Ollama to download it again would only fail.
        log(f"  {name} is already on this PC; not downloading it again")
    elif subprocess.run([exe, "pull", name], env=env).returncode:
        warn(f"download failed; check the name, then retry with: gpu-yield model {name}")
        return "download"
    if guards_shared_fit(cfg):
        try:
            size = next((m.get("size") for m in Ollama(cfg).request("/api/tags", timeout=10)
                         .get("models", []) if same_model(tag_name(m), name)), None)
        except Exception:
            size = None
        budget = shared_budget()
        if size and budget and size > budget:
            warn(f"{name} ({size_text(size)}) is too big for this PC's shared memory; models up "
                 f"to about {size_text(budget)} fit. Not loading it: running out freezes the "
                 "whole board.")
            return "refused"
    log("  loading it into VRAM...")
    o = Ollama(dict(cfg, model=name))
    try:
        o.warm()
        loaded = o.loaded()
        share = gpu_share(loaded)
        log(f"  loaded, {share}% on GPU" if share is not None else "  loaded")
        if guards_gpu_fit(cfg) and spilled(loaded):
            try:
                o.request("/api/generate", {"model": name, "keep_alive": 0}, timeout=60)
            except Exception:
                pass
            warn(f"{name} at context {cfg['context_length']} doesn't fit in GPU memory "
                 f"({share}% fit), so it was unloaded. On ROCm, running part of a model from "
                 "system RAM has stalled the driver and shut down a PC. Choose a smaller model, "
                 "or lower context_length (allow_partial_gpu = true overrides this).")
            return "refused"
        if guards_shared_fit(cfg):
            left = mem_available()
            if left is not None and left < SHARED_MIN_FREE:
                try:
                    o.request("/api/generate", {"model": name, "keep_alive": 0}, timeout=60)
                except Exception:
                    pass
                warn(f"{name} at context {cfg['context_length']} left only {size_text(left)} "
                     "of memory for the rest of the PC, so it was unloaded: on a shared-memory "
                     "board, running out freezes everything. Choose a smaller model or lower "
                     "context_length.")
                return "refused"
        if fits(loaded):
            save_fit(name, cfg["context_length"])
        problem, msg = placement_note(o, name, share)
        if msg and shared_memory_gpu() and share:
            msg = (f"{100 - share}% of {name} runs on the CPU, because Ollama sees less GPU "
                   "memory than the board has; it will be slow. gpu-yield doctor checks the "
                   "GPU memory limit (ttm.pages_limit)")
        if msg:
            (warn if problem else log)(("" if problem else "  ") + msg)
    except Exception as e:
        warn(f"{name} downloaded, but loading it failed ({e}), so it wasn't switched to")
        return "refused"
    return True


